{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@udecode/plate-common/server": ["./src/shims/plate-common-server.ts"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    ".sandbox",
    "node_modules",
    "dist",
    "src-tauri/target",
    "src-tauri/target_test",
    ".local",
    ".ref",
    ".references",
    ".filegraph",
    ".llms"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
