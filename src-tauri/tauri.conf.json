{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Filegraph",
  "version": "1.0.2",
  "identifier": "com.filegraph.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1997",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Filegraph",
        "width": 1600,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "visible": true,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "$HOME/**", "$HOME/.filegraph/**", "/Users/**", "/home/**", "/tmp/**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../src/data/demo-files": "demo-files"
    }
  }
}
