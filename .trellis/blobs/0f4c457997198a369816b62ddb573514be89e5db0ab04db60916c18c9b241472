/* Graph view labels - SVG text uses fill, not color */
@layer components {
  g.labels text.graph-label {
    fill: hsl(var(--foreground)) !important;
    opacity: 0.7;
    pointer-events: none;
    font-family: var(--font-sans), system-ui, sans-serif;
  }
}

.mention {
  background: var(--accent);
}

/* Fix cmdk internal wrapper elements blocking clicks */
[cmdk-root] {
  pointer-events: auto;
}

[cmdk-list] {
  pointer-events: auto;
}

[cmdk-list-sizer] {
  pointer-events: none;
}

[cmdk-list-sizer] > * {
  pointer-events: auto;
}

[cmdk-group] {
  pointer-events: auto;
}

/* Target classless wrapper divs inside cmdk that block clicks */
[cmdk-group] > div:not([class]) {
  pointer-events: none;
}

[cmdk-group] > div:not([class]) > * {
  pointer-events: auto;
}

[cmdk-item] {
  pointer-events: auto;
  cursor: pointer;
}

[cmdk-input] {
  pointer-events: auto;
}

/* Monaco editor: flash highlight for agent-edited lines */
@keyframes agent-code-changed-fade {
  0%   { background-color: rgba(34, 197, 94, 0.22); }
  60%  { background-color: rgba(34, 197, 94, 0.22); }
  100% { background-color: transparent; }
