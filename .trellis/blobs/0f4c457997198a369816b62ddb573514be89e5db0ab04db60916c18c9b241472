}

/* Plate Editor Container */
@layer components {
  .plate-editor {
    @apply w-full h-full;
  }

  .plate-editor [data-slate-editor='true'] {
    @apply w-full min-h-full text-foreground bg-transparent;
    font-family: 'Berkley Mono', 'SF Mono', 'Monaco', 'Courier New', monospace;
    font-size: 13px;
    line-height: 1.6;
    outline: none;
  }

  .plate-editor [data-slate-editor='true'] p {
    @apply my-1;
  }

  .plate-editor [data-slate-editor='true'] h1 {
    @apply text-xl font-bold mt-3 mb-2;
    font-size: 15px;
  }

  .plate-editor [data-slate-editor='true'] h2 {
    @apply text-lg font-semibold mt-2 mb-1.5;
    font-size: 14px;
  }

  .plate-editor [data-slate-editor='true'] h3 {
    @apply text-sm font-semibold mt-2 mb-1;
    font-size: 13px;
  }

  .plate-editor [data-slate-editor='true'] ul,
  .plate-editor [data-slate-editor='true'] ol {
    @apply ml-6 my-1;
    font-size: 13px;
  }

  .plate-editor [data-slate-editor='true'] blockquote {
    @apply border-l-4 border-primary/30 pl-4 my-2 italic text-muted-foreground;
    font-size: 13px;
  }

  .plate-editor [data-slate-editor='true'] pre {
    @apply p-3 rounded-lg bg-muted my-2 border border-border/50 overflow-x-auto;
    font-size: 12px;
  }

  .plate-editor [data-slate-editor='true'] code {
    @apply px-1.5 py-0.5 rounded bg-muted font-mono;
    font-size: 12px;
  }

  .plate-editor [data-slate-editor='true'] pre code {
    @apply p-0 bg-transparent;
  }

  .plate-editor [data-slate-editor='true'] a {
    @apply text-primary underline underline-offset-2 hover:text-primary/80;
    font-size: 13px;
  }

  .plate-editor [data-slate-editor='true'] strong {
    @apply font-semibold;
  }

  .plate-editor [data-slate-editor='true'] em {
    @apply italic;
  }

  .plate-editor [data-slate-editor='true'] ::selection {
    @apply bg-primary/20;
  }

  /* Tiptap Editor Styles */
  .ProseMirror {
    @apply focus:outline-none;
  }

  .ProseMirror p.is-editor-empty:first-child::before {
    @apply text-muted-foreground;
    content: attr(data-placeholder);
    float: left;
    height: 0;
    pointer-events: none;
  }

  .ProseMirror h1 {
    @apply text-2xl font-bold mt-6 mb-4;
  }

  .ProseMirror h2 {
    @apply text-xl font-semibold mt-5 mb-3;
  }

  .ProseMirror h3 {
    @apply text-lg font-semibold mt-4 mb-2;
  }

  .ProseMirror ul,
  .ProseMirror ol {
    @apply ml-6 my-2;
  }

  .ProseMirror ul {
    @apply list-disc;
  }

  .ProseMirror ol {
    @apply list-decimal;
  }

  .ProseMirror li {
    @apply my-1.5;
  }

  .ProseMirror code {
    @apply px-1.5 py-0.5 rounded bg-muted text-xs font-mono;
  }

  .ProseMirror pre {
    @apply p-4 rounded-lg bg-muted my-4 border border-border/50;
  }

  .ProseMirror pre code {
    @apply p-0 bg-transparent;
  }

  .ProseMirror blockquote {
    @apply border-l-4 border-primary/30 pl-4 my-4;
  }
}

