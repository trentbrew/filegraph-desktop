      "content": [
        {
          "type": "text",
          "text": "**Slide 4–5: Concept #1 — BLIND**"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Theme:** Raceblind republicanism, tension between seen/unseen"
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Keywords:** concealment, ideology, erasure, exposure"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "bulletList",
      "children": [
        {
          "id": "b-34",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "serif type, distorted subtly"
            }
          ]
        },
        {
          "id": "b-35",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "grayscale w/ sharp whites, occasional voids"
            }
          ]
        },
        {
          "id": "b-36",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "photo treatment: blurred, cropped, half-lit faces"
            }
          ]
        },
        {
          "id": "b-37",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "icons: veiled busts, censored text blocks"
            }
          ]
        },
        {
          "id": "b-38",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "motion: text reveals on hover, partial opacity masks"
            }
          ]
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
