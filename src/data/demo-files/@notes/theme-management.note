    },
    {
      "id": "b-185",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
    {
      "id": "b-186",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// 6. Save customizations"
