          "type": "text",
          "text": "neutral: '#221551'"
        }
      ]
    },
    {
      "id": "b-147",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
    {
      "id": "b-148",
      "type": "paragraph",
      "content": [
