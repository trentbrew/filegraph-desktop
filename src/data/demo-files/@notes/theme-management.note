      ]
    },
    {
      "id": "b-140",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// { primary: '#E779C1', secondary: '#58C7F3', ... }"
        }
      ]
    },
    {
      "id": "b-141",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Find closest matching theme for custom colors"
