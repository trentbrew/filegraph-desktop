          "type": "text",
          "text": "// 2. Backend analyzes and generates profile"
        }
      ]
    },
    {
      "id": "b-172",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const response = await fetch('/api/brand/generate', {"
        }
      ]
    },
    {
      "id": "b-173",
      "type": "paragraph",
      "content": [
