      ]
    },
    {
      "id": "b-144",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "secondary: '#58C7F3',"
        }
      ]
    },
    {
      "id": "b-145",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "accent: '#F9C97C',"
        }
      ]
    },
    {
      "id": "b-146",
      "type": "paragraph",
      "content": [
