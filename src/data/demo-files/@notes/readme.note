    {
      "id": "b-95",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Features"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "🧱 Dynamic Block Discovery"
        }
      ]
    },
    {
      "id": "b-100",
      "type": "bulletList",
      "children": [
        {
          "id": "b-97",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Auto-discovers components from `app/components/blocks/` directory"
            }
          ]
        },
        {
          "id": "b-98",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Each block follows standardized structure: `Component.vue`, `form.yaml`, `fixture.ts`, `theme.ts`"
            }
          ]
        },
        {
          "id": "b-99",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Generates kebab-case slugs and human-readable names automatically"
            }
          ]
        }
      ]
    },
    {
      "id": "b-101",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "📝 Form-Driven Configuration"
        }
      ]
    },
    {
      "id": "b-107",
      "type": "bulletList",
      "children": [
        {
          "id": "b-102",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "YAML schema-driven form generation"
            }
          ]
        },
        {
          "id": "b-103",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Support for various field types: text, textarea, select, color-select, number, toggle"
            }
          ]
        },
        {
          "id": "b-104",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Conditional field visibility via `when` conditions"
            }
          ]
        },
        {
          "id": "b-105",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Repeater fields with drag-and-drop reordering"
            }
          ]
        },
        {
          "id": "b-106",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Local persistence of form state and repeater order"
            }
          ]
        }
      ]
    },
    {
      "id": "b-108",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "🎨 Live Design Token Editing"
        }
      ]
    },
    {
      "id": "b-114",
      "type": "bulletList",
      "children": [
        {
          "id": "b-109",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Real-time editing of design tokens with color pickers"
            }
          ]
        },
        {
          "id": "b-110",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Visual color swatches in form selects"
            }
          ]
        },
        {
          "id": "b-111",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "CSS custom properties updated instantly"
            }
          ]
        },
        {
          "id": "b-112",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "localStorage persistence across page reloads"
            }
          ]
        },
        {
          "id": "b-113",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Reset functionality to restore defaults"
            }
          ]
        }
      ]
    },
    {
      "id": "b-115",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "📱 Device Preview"
        }
      ]
    },
    {
      "id": "b-119",
      "type": "bulletList",
      "children": [
        {
          "id": "b-116",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Responsive preview modes: Laptop, Tablet, Phone"
            }
          ]
        },
        {
          "id": "b-117",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Live component rendering with current props"
            }
          ]
        },
        {
          "id": "b-118",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Device frame simulation for accurate testing"
            }
          ]
        }
      ]
    },
    {
      "id": "b-120",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "🔧 Developer Experience"
        }
      ]
    },
    {
      "id": "b-125",
      "type": "bulletList",
      "children": [
        {
          "id": "b-121",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "TypeScript throughout for type safety"
            }
          ]
        },
        {
          "id": "b-122",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Hot reloading for rapid development"
            }
          ]
        },
        {
          "id": "b-123",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Comprehensive component documentation"
            }
          ]
        },
        {
          "id": "b-124",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Storybook-like viewer interface"
            }
          ]
        }
      ]
    },
    {
      "id": "b-126",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Block Component Viewer"
        }
      ]
    },
    {
      "id": "b-127",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The main feature is available at `/blocks`. This viewer provides:"
        }
      ]
    },
    {
      "id": "b-128",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. **Block Gallery**: Browse all available block components in a grid layout"
        }
      ]
    },
    {
      "id": "b-129",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "2. **Component Detail**: View individual components with their fixture data"
        }
      ]
    },
    {
      "id": "b-130",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "3. **Live Editor**: Three-tab interface (Form, Tokens, Settings)"
        }
      ]
    },
    {
      "id": "b-131",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "4. **Device Preview**: Toggle between Laptop/Tablet/Phone views"
        }
      ]
    },
    {
      "id": "b-132",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "5. **Props Inspector**: View raw JSON data for each component"
        }
      ]
    },
    {
      "id": "b-133",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Using the Block Viewer"
        }
      ]
    },
    {
      "id": "b-134",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. Start the development server:"
        }
      ]
    },
    {
      "id": "b-135",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```bash"
        }
      ]
    },
    {
      "id": "b-136",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pnpm run dev"
        }
      ]
    },
    {
      "id": "b-137",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-138",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "2. Navigate to `http://localhost:PORT/blocks` to see the list of available blocks"
        }
      ]
    },
    {
      "id": "b-139",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "3. Click on a block to view its detail page at `/blocks/[slug]`"
        }
      ]
    },
    {
      "id": "b-140",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "4. Use the editor tabs:"
        }
      ]
    },
    {
      "id": "b-141",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- **Form**: Edit component props via schema-driven forms"
        }
      ]
    },
    {
      "id": "b-142",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- **Tokens**: Modify design tokens with color pickers"
        }
      ]
    },
    {
      "id": "b-143",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- **Settings**: Configure design system settings (coming soon)"
        }
      ]
    },
    {
      "id": "b-144",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "5. Toggle device preview modes to test responsive behavior"
        }
      ]
    },
    {
      "id": "b-145",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "6. View raw props data in the Structure drawer"
        }
      ]
    },
    {
      "id": "b-146",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Design Token System"
        }
      ]
    },
    {
      "id": "b-147",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The system supports live editing of:"
        }
      ]
    },
    {
      "id": "b-152",
      "type": "bulletList",
      "children": [
        {
          "id": "b-148",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Colors**: Primary, secondary, tertiary, quaternary palettes with multiple shades"
            }
          ]
        },
        {
          "id": "b-149",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Radius**: Border radius values for consistent rounded corners"
            }
          ]
        },
        {
          "id": "b-150",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Space**: Spacing values for margins and padding"
            }
          ]
        },
        {
          "id": "b-151",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Effects**: Shadow and other visual effects"
            }
          ]
        }
      ]
    },
    {
      "id": "b-153",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "All changes are persisted in localStorage and applied instantly to the preview."
        }
      ]
    },
    {
      "id": "b-154",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Component Structure"
        }
      ]
    },
    {
      "id": "b-155",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Each block component follows this standardized structure:"
        }
      ]
    },
    {
      "id": "b-156",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-157",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app/components/blocks/[ComponentName]/"
        }
      ]
    },
    {
      "id": "b-158",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── [ComponentName].vue    # Main component implementation"
        }
      ]
    },
    {
      "id": "b-159",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── form.yaml             # Form schema for configuration"
        }
      ]
    },
    {
      "id": "b-160",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── fixture.ts            # Sample data for preview"
        }
      ]
    },
    {
      "id": "b-161",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "└── theme.ts              # Theme configuration with tailwind-variants"
        }
      ]
    },
    {
      "id": "b-162",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-163",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Creating a New Component"
        }
      ]
    },
    {
      "id": "b-164",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. Create a new directory in `app/components/blocks/[ComponentName]/`"
        }
      ]
    },
    {
      "id": "b-165",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "2. Implement the component with TypeScript"
        }
      ]
    },
    {
      "id": "b-166",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "3. Define the form schema in `form.yaml`"
        }
      ]
    },
    {
      "id": "b-167",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "4. Create sample data in `fixture.ts`"
        }
      ]
    },
    {
      "id": "b-168",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "5. Implement theming in `theme.ts`"
        }
      ]
    },
    {
      "id": "b-169",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "6. The component will be auto-discovered and available in the block viewer"
        }
      ]
    },
    {
      "id": "b-170",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Technology Stack"
        }
      ]
    },
    {
      "id": "b-178",
      "type": "bulletList",
      "children": [
        {
          "id": "b-171",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Framework**: Nuxt 3 with Vue 3 Composition API"
            }
          ]
        },
        {
          "id": "b-172",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**UI Library**: Nuxt UI with Tailwind CSS"
            }
          ]
        },
        {
          "id": "b-173",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Design System**: Style Dictionary for token processing"
            }
          ]
        },
        {
          "id": "b-174",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Styling**: Tailwind CSS with custom CSS variables"
            }
          ]
        },
        {
          "id": "b-175",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Icons**: Iconify with Lucide and Simple Icons"
            }
          ]
        },
        {
          "id": "b-176",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**State Management**: Vue reactive refs with localStorage persistence"
            }
          ]
        },
        {
          "id": "b-177",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Build Tools**: Vite with TypeScript support"
            }
          ]
        }
      ]
    }
  ]
}
