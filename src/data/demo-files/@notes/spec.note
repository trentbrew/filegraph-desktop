    },
    {
      "id": "b-107",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"app\", type: \"relation\", options: { collectionId: apps.id, maxSelect: 1 }},"
        }
      ]
    },
    {
      "id": "b-108",
