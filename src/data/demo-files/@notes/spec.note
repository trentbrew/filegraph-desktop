        }
      ]
    },
    {
      "id": "b-131",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"actor\", type: \"relation\", options: { collectionId: \"_pb_users_auth_\", maxSelect: 1 }},"
        }
      ]
    },
    {
