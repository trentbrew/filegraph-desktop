          "type": "text",
          "text": "{ name: \"status\", type: \"select\", options: { values: [\"Draft\",\"Active\",\"Syncing\",\"Published\",\"Archived\"] }},"
        }
      ]
    },
    {
      "id": "b-68",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"createdBy\", type: \"relation\", options: { collectionId: \"_pb_users_auth_\", maxSelect: 1 }},"
        }
      ]
    },
    {
      "id": "b-69",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
