    {
      "id": "b-333",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Dev:"
        }
      ]
    },
    {
      "id": "b-337",
      "type": "bulletList",
      "children": [
        {
          "id": "b-334",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "tests: pass"
            }
          ]
        },
        {
          "id": "b-335",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "types: clean"
            }
          ]
        },
        {
          "id": "b-336",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "docs: stale"
            }
