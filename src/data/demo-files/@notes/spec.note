    },
    {
      "id": "b-328",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Apps:"
        }
      ]
    },
    {
      "id": "b-332",
      "type": "bulletList",
      "children": [
        {
          "id": "b-329",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "active: 5 (2 near storage cap)"
            }
          ]
        },
        {
          "id": "b-330",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "schema validity: ok"
            }
          ]
        },
        {
          "id": "b-331",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "validation errors: 0"
            }
