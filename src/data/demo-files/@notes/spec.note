        }
      ]
    },
    {
      "id": "b-136",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "listRule: \"@request.auth.userType = 'super_admin' || @request.auth.parentApp = app || app.owner = @request.auth.id\","
        }
      ]
    },
    {
      "id": "b-137",
      "type": "paragraph",
      "content": [
        {
