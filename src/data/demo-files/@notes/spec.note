          "text": "indexes: [\"CREATE INDEX idx_keys_app ON api_keys (app)\"],"
        }
      ]
    },
    {
      "id": "b-114",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "listRule: \"app.owner = @request.auth.id || @request.auth.userType = 'super_admin'\","
        }
      ]
    },
    {
      "id": "b-115",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "viewRule:  \"app.owner = @request.auth.id || @request.auth.userType = 'super_admin'\","
        }
      ]
    },
    {
      "id": "b-116",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "createRule:\"app.owner = @request.auth.id || @request.auth.userType = 'super_admin'\","
        }
      ]
    },
    {
      "id": "b-117",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "updateRule:\"app.owner = @request.auth.id || @request.auth.userType = 'super_admin'\","
        }
      ]
    },
    {
      "id": "b-118",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "deleteRule:\"app.owner = @request.auth.id || @request.auth.userType = 'super_admin'\""
        }
      ]
    },
    {
      "id": "b-119",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
