      "content": [
        {
          "type": "text",
          "text": "const audits = new Collection({"
        }
      ]
    },
    {
      "id": "b-123",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: \"pv_audits\","
        }
      ]
    },
    {
      "id": "b-124",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "type: \"base\","
        }
      ]
    },
    {
      "id": "b-125",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "system: false,"
        }
      ]
    },
    {
      "id": "b-126",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "schema: ["
        }
      ]
    },
    {
      "id": "b-127",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"app\", type: \"relation\", options: { collectionId: apps.id, maxSelect: 1 }},"
        }
      ]
    },
    {
      "id": "b-128",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"schema\", type: \"relation\", options: { collectionId: schemas.id, maxSelect: 1 }},"
        }
      ]
    },
    {
      "id": "b-129",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"recordId\", type: \"text\" },"
        }
      ]
    },
    {
      "id": "b-130",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
