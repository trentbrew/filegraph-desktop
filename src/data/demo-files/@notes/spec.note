{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "note:notion-346",
  "title": "Spec",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "Spec"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "bulletList",
      "children": [
        {
          "id": "b-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "One **real PocketBase** (“host PB”) that stores: tenants/apps, virtual schemas, records, auth, API keys, audits, limits."
            }
          ]
        },
        {
          "id": "b-3",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Many **virtual PB instances** (logical only): enforced by `app` scoping, RLS-style rules, and namespaced realtime topics."
            }
          ]
        },
        {
          "id": "b-4",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A **Gateway** (Hono/Node) that exposes the Virtual PB API (`/api/vpb/:appId/...`), compiles schema rules, and rate-limits per app."
            }
          ]
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "> Minimal set + safe defaults. Add more fields later without breaking isolation."
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ">"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```jsx"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/// 000_init.js"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "migrate((db) => {"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const dao = new Dao(db)"
        }
      ]
    },
    {
      "id": "b-13",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// apps"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const apps = new Collection({"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: \"apps\","
        }
      ]
    },
    {
      "id": "b-16",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "type: \"base\","
        }
      ]
    },
    {
      "id": "b-17",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "system: false,"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "schema: ["
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"owner\", type: \"relation\", options: { collectionId: \"_pb_users_auth_\", maxSelect: 1, cascadeDelete: false }},"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"name\", type: \"text\", options: { min: 2, max: 64, pattern: \"\" }},"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"slug\", type: \"text\", options: { min: 2, max: 64, pattern: \"^[a-z0-9-]+$\" }},"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"metadata\", type: \"json\" },"
        }
      ]
    },
    {
      "id": "b-23",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"status\", type: \"select\", options: { values: [\"draft\",\"active\",\"archived\"] }},"
        }
      ]
    },
    {
      "id": "b-24",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"limits\", type: \"json\" } // {records, filesMB, rps}"
        }
      ]
    },
    {
      "id": "b-25",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "indexes: ["
        }
      ]
    },
    {
      "id": "b-27",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"CREATE UNIQUE INDEX idx_apps_slug ON apps (slug)\""
        }
      ]
    },
    {
      "id": "b-28",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "listRule: \"@request.auth.userType = 'super_admin' || owner = @request.auth.id\","
        }
      ]
    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "viewRule: \"@request.auth.userType = 'super_admin' || owner = @request.auth.id\","
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "createRule: \"@request.auth.userType != null\", // any authed can create an app they own"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "updateRule: \"@request.auth.userType = 'super_admin' || owner = @request.auth.id\","
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "deleteRule: \"@request.auth.userType = 'super_admin' || owner = @request.auth.id\""
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "dao.saveCollection(apps)"
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// schemas (virtual tables)"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const schemas = new Collection({"
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: \"schemas\","
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "type: \"base\","
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "system: false,"
        }
      ]
    },
    {
      "id": "b-41",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "schema: ["
        }
      ]
    },
    {
      "id": "b-42",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"app\", type: \"relation\", options: { collectionId: apps.id, maxSelect: 1 }},"
        }
      ]
    },
    {
      "id": "b-43",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"name\", type: \"text\", options: { pattern: \"^[a-zA-Z_][a-zA-Z0-9_]*$\" }},"
        }
      ]
    },
    {
      "id": "b-44",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"version\", type: \"text\" },"
        }
      ]
    },
    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"schema\", type: \"json\" }, // {fields[], rules, indexes[]}"
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ name: \"createdBy\", type: \"relation\", options: { collectionId: \"_pb_users_auth_\", maxSelect: 1 }}"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "indexes: ["
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"CREATE UNIQUE INDEX idx_schema_app_name ON schemas (app, name)\""
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "listRule: \"app.owner = @request.auth.id || @request.auth.userType = 'super_admin' || @request.auth.parentApp = app\","
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "viewRule: \"app.owner = @request.auth.id || @request.auth.userType = 'super_admin' || @request.auth.parentApp = app\","
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "createRule: \"@request.auth.userType in ['tenant','super_admin'] && app.owner = @request.auth.id || @request.auth.userType = 'super_admin'\","
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "updateRule: \"@request.auth.userType in ['tenant','super_admin'] && app.owner = @request.auth.id || @request.auth.userType = 'super_admin'\","
        }
      ]
    },
    {
      "id": "b-55",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "deleteRule: \"@request.auth.userType = 'super_admin' || (app.owner = @request.auth.id)\""
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
