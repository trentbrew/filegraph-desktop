      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "listRule: \"@request.auth.userType = 'super_admin' || @request.auth.parentApp = app || app.owner = @request.auth.id\","
        }
      ]
    },
    {
      "id": "b-77",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "viewRule: \"@request.auth.userType = 'super_admin' || @request.auth.parentApp = app || app.owner = @request.auth.id\","
        }
      ]
    },
    {
      "id": "b-78",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "createRule: \"@request.auth.userType in ['tenant','app_user','super_admin'] && (@request.auth.parentApp = app || app.owner = @request.auth.id || @request.auth.userType = 'super_admin')\","
        }
      ]
    },
    {
      "id": "b-79",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "updateRule: \"@request.auth.userType in ['tenant','app_user','super_admin'] && (@request.auth.parentApp = app || app.owner = @request.auth.id || @request.auth.userType = 'super_admin')\","
        }
      ]
    },
    {
      "id": "b-80",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "deleteRule: \"@request.auth.userType in ['tenant','super_admin'] && (@request.auth.parentApp = app || app.owner = @request.auth.id || @request.auth.userType = 'super_admin')\""
        }
      ]
    },
