      ]
    },
    {
      "id": "b-143",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// extend users (no migration needed if using profile fields; else add via settings)"
        }
      ]
    },
    {
      "id": "b-144",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}, (db) => {})"
        }
      ]
    },
    {
      "id": "b-145",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-146",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Users: role tagging"
        }
      ]
    },
    {
      "id": "b-150",
      "type": "bulletList",
      "children": [
        {
          "id": "b-147",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`userType` in auth `users` collection: `\"super_admin\" | \"tenant\" | \"app_user\"`."
            }
          ]
        },
        {
          "id": "b-148",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`parentApp` (relation → apps) for app_users."
            }
          ]
        },
        {
          "id": "b-149",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Enforce in auth hooks to prevent illegal combos (e.g., app_user with null parentApp)."
            }
          ]
        }
      ]
    },
    {
      "id": "b-151",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-152",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**schemas.schema** (example):"
        }
      ]
    },
    {
      "id": "b-153",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```json"
        }
      ]
    },
    {
      "id": "b-154",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-155",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"fields\": ["
        }
      ]
    },
    {
      "id": "b-156",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ \"name\": \"email\", \"type\": \"text\", \"required\": true, \"unique\": true, \"pattern\": \".+@.+\" },"
        }
      ]
    },
    {
      "id": "b-157",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ \"name\": \"avatar\", \"type\": \"file\", \"required\": false, \"maxSizeMB\": 5 },"
        }
      ]
    },
    {
      "id": "b-158",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ \"name\": \"tags\", \"type\": \"json\", \"required\": false },"
        }
      ]
    },
    {
      "id": "b-159",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ \"name\": \"org\", \"type\": \"relation\", \"target\": \"organizations\", \"onDelete\": \"restrict\" }"
        }
      ]
    },
    {
      "id": "b-160",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-161",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"rules\": {"
        }
      ]
    },
    {
      "id": "b-162",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"create\": \"role in ['owner','admin','editor']\","
        }
      ]
    },
    {
      "id": "b-163",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"update\": \"role in ['owner','admin','editor']\","
        }
      ]
    },
    {
      "id": "b-164",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"delete\": \"role in ['owner','admin']\","
        }
      ]
    },
    {
      "id": "b-165",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"read\":   \"true\""
        }
      ]
    },
    {
      "id": "b-166",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-167",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"indexes\": ["
        }
      ]
    },
    {
      "id": "b-168",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"email UNIQUE\","
        }
      ]
    },
    {
      "id": "b-169",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"org\""
        }
      ]
    },
    {
      "id": "b-170",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "]"
        }
      ]
    },
    {
      "id": "b-171",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-172",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-173",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "> The Gateway compiles this to server-side checks + secondary indexes inside pv_records (by projection keys) or SQLite virtual indexes where pragmatic."
        }
      ]
    },
    {
      "id": "b-174",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ">"
        }
      ]
    },
    {
      "id": "b-175",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-176",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-177",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { Hono } from 'hono'"
        }
      ]
    },
    {
      "id": "b-178",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { bearerAuth } from 'hono/bearer-auth'"
        }
      ]
    },
    {
      "id": "b-179",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { z } from 'zod'"
        }
      ]
    },
    {
      "id": "b-180",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const app = new Hono()"
        }
      ]
    },
    {
      "id": "b-181",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Per-app auth: user session or API key"
        }
      ]
    },
    {
      "id": "b-182",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.use('/api/vpb/:appId/*', async (c, next) => {"
        }
      ]
    },
    {
      "id": "b-183",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// prefer PocketBase auth cookie; else API key"
        }
      ]
    },
    {
      "id": "b-184",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const apiKey = c.req.header('x-tb-key') || c.req.query('key') || null"
        }
      ]
    },
    {
      "id": "b-185",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const session = await getPBSession(c) // tenant/app_user/super_admin"
        }
      ]
    },
    {
      "id": "b-186",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "c.set('auth', { session, apiKey })"
        }
      ]
    },
    {
      "id": "b-187",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await next()"
        }
      ]
    },
    {
      "id": "b-188",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
    {
      "id": "b-189",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.get('/api/vpb/:appId/collections/:table', listRecords)"
        }
      ]
    },
    {
      "id": "b-190",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.post('/api/vpb/:appId/collections/:table', createRecord)"
        }
      ]
    },
    {
      "id": "b-191",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.get('/api/vpb/:appId/collections/:table/:id', getRecord)"
        }
      ]
    },
    {
      "id": "b-192",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.put('/api/vpb/:appId/collections/:table/:id', updateRecord)"
        }
      ]
    },
    {
      "id": "b-193",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.delete('/api/vpb/:appId/collections/:table/:id', deleteRecord)"
        }
      ]
    },
    {
      "id": "b-194",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.post('/api/vpb/:appId/auth/login', appLogin)"
        }
      ]
    },
    {
      "id": "b-195",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.post('/api/vpb/:appId/files', uploadFile)"
        }
      ]
    },
    {
      "id": "b-196",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// websocket (upgrade), topic: vpb.{appId}.{table}"
        }
      ]
    },
    {
      "id": "b-197",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-198",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Route guards (core rules):**"
        }
      ]
    },
    {
      "id": "b-201",
      "type": "bulletList",
      "children": [
        {
          "id": "b-199",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Resolve `appId → apps` record; enforce `apps.status != 'archived'`."
            }
          ]
        },
        {
          "id": "b-200",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "If `auth.userType==='super_admin'` → allow, else must be:"
            }
          ]
        }
      ]
    },
    {
      "id": "b-202",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- `tenant` and `apps.owner == auth.id`, or"
        }
      ]
    },
    {
      "id": "b-203",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- `app_user` and `auth.parentApp == apps.id`."
        }
      ]
    },
    {
      "id": "b-205",
      "type": "bulletList",
      "children": [
        {
          "id": "b-204",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Load virtual schema (`schemas`), compile field validation, permission DSL (`role in [...]`) using membership from `app_memberships`."
            }
          ]
        }
      ]
    },
    {
      "id": "b-206",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Rate limiting (per app):**"
        }
      ]
    },
    {
      "id": "b-209",
      "type": "bulletList",
      "children": [
        {
          "id": "b-207",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Token bucket keyed by `appId` + `apiKey` with defaults from `apps.limits` (e.g., `rps=50`)."
            }
          ]
        },
        {
          "id": "b-208",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Return `429` with `X-RateLimit-*` headers."
            }
          ]
        }
      ]
    },
    {
      "id": "b-210",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-213",
      "type": "bulletList",
      "children": [
        {
          "id": "b-211",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Topic naming: `vpb.{appId}.{table}` for CRUD, `vpb.{appId}.schema` for schema bumps, `vpb.{appId}.presence` for user presence, `platform.system` for super-admin."
            }
          ]
        },
        {
          "id": "b-212",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Broadcast on:"
            }
          ]
        }
      ]
    },
    {
      "id": "b-214",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- create/update/delete in `pv_records`"
        }
      ]
    },
    {
      "id": "b-215",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- schema upsert in `schemas`"
        }
      ]
    },
    {
      "id": "b-216",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- presence pings (interval 20s; mark stale after 60s)"
        }
      ]
    },
    {
      "id": "b-217",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-220",
      "type": "bulletList",
      "children": [
        {
          "id": "b-218",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`pv_records.status ∈ {Draft, Active, Syncing, Published, Archived}`."
            }
          ]
        },
        {
          "id": "b-219",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Drag-drop updates `status` with server-side transitions:"
            }
          ]
        }
      ]
    },
    {
      "id": "b-221",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- `Draft→Active`: validate record vs schema."
        }
      ]
    },
    {
      "id": "b-222",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- `Active→Syncing`: server sets while performing side-effects (webhooks, indexes)."
        }
      ]
    },
    {
      "id": "b-223",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- `Syncing→Published`: on success; emit realtime."
        }
      ]
    },
    {
      "id": "b-224",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- `→Archived`: soft-hide from default queries."
        }
      ]
    },
    {
      "id": "b-225",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-230",
      "type": "bulletList",
      "children": [
        {
          "id": "b-226",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Platform** (super-admin): full."
            }
          ]
        },
        {
          "id": "b-227",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Tenant**: owner of their `apps.*`; manager of their `schemas`, `pv_records`, `app_memberships`, `api_keys`."
            }
          ]
        },
        {
          "id": "b-228",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**App-user**: permissions via `app_memberships.role` + schema rules."
            }
          ]
        },
        {
          "id": "b-229",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Row-level**: enforced by app scoping + schema `rules` + membership role."
            }
          ]
        }
      ]
    },
    {
      "id": "b-231",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-232",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-233",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export class TurtleBase {"
        }
      ]
    },
    {
      "id": "b-234",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "constructor(private cfg: { appId: string; key?: string; realtime?: boolean }) {}"
        }
      ]
    },
    {
      "id": "b-235",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "collection<T = any>(table: string) {"
        }
      ]
    },
    {
      "id": "b-236",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const base = `/api/vpb/${this.cfg.appId}/collections/${table}`"
        }
      ]
    },
    {
      "id": "b-237",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return {"
        }
      ]
    },
    {
      "id": "b-238",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "list: (q?: any) => fetchJSON(`${base}?${new URLSearchParams(q||{})}`, { headers: keyHdr(this.cfg.key) }),"
        }
      ]
    },
    {
      "id": "b-239",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "get:  (id: string) => fetchJSON(`${base}/${id}`, { headers: keyHdr(this.cfg.key) }),"
        }
      ]
    },
    {
      "id": "b-240",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "create: (data: T) => fetchJSON(base, { method: 'POST', headers: keyHdr(this.cfg.key), body: JSON.stringify(data) }),"
        }
      ]
    },
    {
      "id": "b-241",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "update: (id: string, data: Partial<T>) => fetchJSON(`${base}/${id}`, { method: 'PUT', headers: keyHdr(this.cfg.key), body: JSON.stringify(data) }),"
        }
      ]
    },
    {
      "id": "b-242",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "delete: (id: string) => fetchJSON(`${base}/${id}`, { method: 'DELETE', headers: keyHdr(this.cfg.key) }),"
        }
      ]
    },
    {
      "id": "b-243",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subscribe: (fn: (evt:any)=>void) => wsSub(`vpb.${this.cfg.appId}.${table}`, fn)"
        }
      ]
    },
    {
      "id": "b-244",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-245",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-246",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-247",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-248",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-249",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "> One just seed-app <slug> creates app, schemas, sample data, and memberships."
        }
      ]
    },
    {
      "id": "b-250",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ">"
        }
      ]
    },
    {
      "id": "b-251",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. **crm**"
        }
      ]
    },
    {
      "id": "b-255",
      "type": "bulletList",
      "children": [
        {
          "id": "b-252",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "tables: `customers`, `leads`, `interactions`"
            }
          ]
        },
        {
          "id": "b-253",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "indexes: `customers.email UNIQUE`"
            }
          ]
        },
        {
          "id": "b-254",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "roles: owner(tenant), editor(app_user), viewer(app_user)"
            }
          ]
        }
      ]
    },
    {
      "id": "b-256",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. **inventory**"
        }
      ]
    },
    {
      "id": "b-259",
      "type": "bulletList",
      "children": [
        {
          "id": "b-257",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "tables: `products`, `stockMoves`, `suppliers`"
            }
          ]
        },
        {
          "id": "b-258",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "computed fields in Gateway (e.g., `products.stockOnHand`)"
            }
          ]
        }
      ]
    },
    {
      "id": "b-260",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. **tasks**"
        }
      ]
    },
    {
      "id": "b-263",
      "type": "bulletList",
      "children": [
        {
          "id": "b-261",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "tables: `projects`, `tasks`, `assignees`"
            }
          ]
        },
        {
          "id": "b-262",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "status flow aligns with board columns"
            }
          ]
        }
      ]
    },
    {
      "id": "b-264",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. **cms**"
        }
      ]
    },
    {
      "id": "b-267",
      "type": "bulletList",
      "children": [
        {
          "id": "b-265",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "tables: `posts`, `pages`, `media`"
            }
          ]
        },
        {
          "id": "b-266",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "file fields; webhook on `Published`"
            }
          ]
        }
      ]
    },
    {
      "id": "b-268",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. **analytics**"
        }
      ]
    },
    {
      "id": "b-271",
      "type": "bulletList",
      "children": [
        {
          "id": "b-269",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "tables: `events`, `dashboards`, `widgets`"
            }
          ]
        },
        {
          "id": "b-270",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "read-heavy; limit writes; API keys with read:* only"
            }
          ]
        }
      ]
    },
    {
      "id": "b-272",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-275",
      "type": "bulletList",
      "children": [
        {
          "id": "b-273",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Export: newline-delimited JSON with embedded schema version header."
            }
          ]
        },
        {
          "id": "b-274",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Import: validate version compatibility, run in `Syncing`, emit diffs to `pv_audits`."
            }
          ]
        }
      ]
    },
    {
      "id": "b-276",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-279",
      "type": "bulletList",
      "children": [
        {
          "id": "b-277",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Store via host PB file storage; link file handles inside `pv_records.data.avatar` etc."
            }
          ]
        },
        {
          "id": "b-278",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Enforce per-app quotas via `apps.limits.filesMB`."
            }
          ]
        }
      ]
    },
    {
      "id": "b-280",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-283",
      "type": "bulletList",
      "children": [
        {
          "id": "b-281",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`pv_records.version` increments on write."
            }
          ]
        },
        {
          "id": "b-282",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Gateway rejects `PUT` if `If-Match: <version>` mismatches."
            }
          ]
        }
      ]
    },
    {
      "id": "b-284",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-286",
      "type": "bulletList",
      "children": [
        {
          "id": "b-285",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Every write appends to `pv_audits` with computed diff:"
            }
          ]
        }
      ]
    },
    {
      "id": "b-287",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- `diff = jsondiffpatch(old.data, new.data)`"
        }
      ]
    },
    {
      "id": "b-289",
      "type": "bulletList",
      "children": [
        {
          "id": "b-288",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Viewable by tenant + app users of same app; immutable."
            }
          ]
        }
      ]
    },
    {
      "id": "b-290",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-291",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-292",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "set shell := [\"bash\", \"-uc\"]"
        }
      ]
    },
    {
      "id": "b-293",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "dev:        # run PB + Gateway + Admin UI"
        }
      ]
    },
    {
      "id": "b-294",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pnpm -C apps/gateway dev & pnpm -C apps/admin dev & pnpm -C infra/pb run"
        }
      ]
    },
    {
      "id": "b-295",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "dev-admin:"
        }
      ]
    },
    {
      "id": "b-296",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pnpm -C apps/admin dev"
        }
      ]
    },
    {
      "id": "b-297",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "dev-tenant:"
        }
      ]
    },
    {
      "id": "b-298",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pnpm -C apps/tenant dev"
        }
      ]
    },
    {
      "id": "b-299",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "dev-vpb:"
        }
      ]
    },
    {
      "id": "b-300",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pnpm -C apps/gateway dev"
        }
      ]
    },
    {
      "id": "b-301",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "new-app name desc:"
        }
      ]
    },
    {
      "id": "b-302",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "node scripts/new-app.mjs \"{{name}}\" \"{{desc}}\""
        }
      ]
    },
    {
      "id": "b-303",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "list-apps:"
        }
      ]
    },
    {
      "id": "b-304",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "node scripts/list-apps.mjs"
        }
      ]
    },
    {
      "id": "b-305",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "seed-app appId:"
        }
      ]
    },
    {
      "id": "b-306",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "node scripts/seed-app.mjs \"{{appId}}\""
        }
      ]
    },
    {
      "id": "b-307",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "backup-app appId:"
        }
      ]
    },
    {
      "id": "b-308",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "node scripts/backup-app.mjs \"{{appId}}\""
        }
      ]
    },
    {
      "id": "b-309",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "test:"
        }
      ]
    },
    {
      "id": "b-310",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pnpm -r test"
        }
      ]
    },
    {
      "id": "b-311",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "test-vpb:"
        }
      ]
    },
    {
      "id": "b-312",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pnpm -C apps/gateway test"
        }
      ]
    },
    {
      "id": "b-313",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "test-realtime:"
        }
      ]
    },
    {
      "id": "b-314",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "node scripts/test-realtime.mjs"
        }
      ]
    },
    {
      "id": "b-315",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "validate-schemas:"
        }
      ]
    },
    {
      "id": "b-316",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "node scripts/validate-schemas.mjs"
        }
      ]
    },
    {
      "id": "b-317",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "status:"
        }
      ]
    },
    {
      "id": "b-318",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "node scripts/status.mjs"
        }
      ]
    },
    {
      "id": "b-319",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-320",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-321",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-322",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Platform:"
        }
      ]
    },
    {
      "id": "b-327",
