    {
      "id": "b-550",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "prompt: `You are a moderator for a public access TV live chat. Prompts should only be rejected if they contain reasonably offensive content. Explicit language is only ok if it is used in a way that is not offensive. Here is the prompt: ${prompt}`,"
        }
      ]
