        }
      ]
    },
    {
      "id": "b-563",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-564",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-565",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// @ts-check"
        }
      ]
    },
    {
      "id": "b-566",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const baseUrl = '<http://trms.speakmpls.com/CablecastAPI/v1>'"
        }
      ]
    },
    {
      "id": "b-567",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// const baseUrl = '<https://channel36-la.cablecast.tv:8080/cablecastapi/v1>' // for science"
        }
      ]
    },
    {
      "id": "b-568",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-569",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Constructs the full URL for a given endpoint."
        }
      ]
    },
    {
      "id": "b-570",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} endpoint - The API endpoint."
        }
      ]
    },
    {
      "id": "b-571",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {string} The full URL."
        }
      ]
    },
    {
      "id": "b-572",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-573",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const url = (endpoint) => `${baseUrl}/${endpoint}`"
        }
      ]
    },
    {
      "id": "b-574",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-575",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Creates the options object for a fetch request."
        }
      ]
    },
    {
      "id": "b-576",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} method - The HTTP method (GET, POST, PUT, PATCH)."
        }
      ]
    },
    {
      "id": "b-577",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {Object} data - The data to be sent in the request body."
        }
      ]
    },
    {
      "id": "b-578",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Object} The options object for fetch."
        }
      ]
    },
    {
      "id": "b-579",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-580",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const options = (method, data) => ({"
        }
      ]
    },
    {
      "id": "b-581",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "method,"
        }
      ]
    },
    {
      "id": "b-582",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "headers: { 'Content-Type': 'application/json' },"
        }
      ]
    },
    {
      "id": "b-583",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "body: JSON.stringify(data),"
        }
      ]
    },
    {
      "id": "b-584",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
    {
      "id": "b-585",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-586",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Cablecast API client."
        }
      ]
    },
    {
      "id": "b-587",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @module cablecast"
        }
      ]
    },
    {
      "id": "b-588",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-589",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export default {"
        }
      ]
    },
    {
      "id": "b-590",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-591",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Sends a GET request to the specified endpoint."
        }
      ]
    },
    {
      "id": "b-592",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} endpoint - The API endpoint."
        }
      ]
    },
    {
      "id": "b-593",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<Object>} The response data."
        }
      ]
    },
    {
      "id": "b-594",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-595",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "get: async (endpoint) => (await fetch(url(endpoint))).json(),"
        }
      ]
    },
    {
      "id": "b-596",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-597",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Sends a POST request to the specified endpoint with the given data."
        }
      ]
    },
    {
      "id": "b-598",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} endpoint - The API endpoint."
        }
      ]
    },
    {
      "id": "b-599",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {Object} data - The data to be sent in the request body."
        }
      ]
    },
    {
      "id": "b-600",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<Object>} The response data."
        }
      ]
    },
    {
      "id": "b-601",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-602",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "post: async (endpoint, data) => (await fetch(url(endpoint), options('POST', data))).json(),"
        }
      ]
    },
    {
      "id": "b-603",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-604",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Sends a PUT request to the specified endpoint with the given data."
        }
      ]
    },
    {
      "id": "b-605",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} endpoint - The API endpoint."
        }
      ]
    },
    {
      "id": "b-606",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {Object} data - The data to be sent in the request body."
        }
      ]
    },
    {
      "id": "b-607",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<Object>} The response data."
        }
      ]
    },
    {
      "id": "b-608",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-609",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "put: async (endpoint, data) => (await fetch(url(endpoint), options('PUT', data))).json(),"
        }
      ]
    },
    {
      "id": "b-610",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-611",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Sends a PATCH request to the specified endpoint with the given data."
        }
      ]
    },
    {
      "id": "b-612",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} endpoint - The API endpoint."
        }
      ]
    },
    {
      "id": "b-613",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {Object} data - The data to be sent in the request body."
        }
      ]
    },
    {
      "id": "b-614",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<Object>} The response data."
        }
      ]
    },
    {
      "id": "b-615",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-616",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "patch: async (endpoint, data) => (await fetch(url(endpoint), options('PATCH', data))).json(),"
        }
      ]
    },
    {
      "id": "b-617",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-618",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-619",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-620",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// @ts-check"
        }
      ]
    },
    {
      "id": "b-621",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import cablecast from './cablecast.mjs'"
        }
      ]
    },
    {
      "id": "b-622",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import pocketbase from './pocketbase.mjs'"
        }
      ]
    },
    {
      "id": "b-623",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const maxPageSize = 999"
        }
      ]
    },
    {
      "id": "b-624",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-625",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Fetch data with a timeout."
        }
      ]
    },
    {
      "id": "b-626",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} url - The URL to fetch."
        }
      ]
    },
    {
      "id": "b-627",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {Object} options - The options for the fetch request."
        }
      ]
    },
    {
      "id": "b-628",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<Response>} The response."
        }
      ]
    },
    {
      "id": "b-629",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-630",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const fetchWithTimeout = async (url, options = {}) => {"
        }
      ]
    },
    {
      "id": "b-631",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const timeout = 30000 // 30 seconds timeout"
        }
      ]
    },
    {
      "id": "b-632",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const controller = new AbortController()"
        }
      ]
    },
    {
      "id": "b-633",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const timeoutId = setTimeout(() => controller.abort(), timeout)"
        }
      ]
    },
    {
      "id": "b-634",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "try {"
        }
      ]
    },
    {
      "id": "b-635",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const response = await fetch(url, { ...options, signal: controller.signal })"
        }
      ]
    },
    {
      "id": "b-636",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return response"
        }
      ]
    },
    {
      "id": "b-637",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} catch (error) {"
        }
      ]
    },
    {
      "id": "b-638",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (error.name === 'AbortError') {"
        }
      ]
    },
    {
      "id": "b-639",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error('Request timed out')"
        }
      ]
    },
    {
      "id": "b-640",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-641",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw error"
        }
      ]
    },
    {
      "id": "b-642",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} finally {"
        }
      ]
    },
    {
      "id": "b-643",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "clearTimeout(timeoutId)"
        }
      ]
    },
    {
      "id": "b-644",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-645",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-646",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-647",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Calculate the end time based on a start time and duration."
        }
      ]
    },
    {
      "id": "b-648",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} startTime - The start time in ISO format."
        }
      ]
    },
    {
      "id": "b-649",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {number} duration - The duration in seconds."
        }
      ]
    },
    {
      "id": "b-650",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {string} The end time in ISO format."
        }
      ]
    },
    {
      "id": "b-651",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-652",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const calculateEndTime = (startTime, duration) => {"
        }
      ]
    },
    {
      "id": "b-653",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const start = new Date(startTime)"
        }
      ]
    },
    {
      "id": "b-654",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const end = new Date(start.getTime() + duration * 1000)"
        }
      ]
    },
    {
      "id": "b-655",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return end.toISOString()"
        }
      ]
    },
    {
      "id": "b-656",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-657",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-658",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Format a duration given in seconds into a string with hours and minutes."
        }
      ]
    },
    {
      "id": "b-659",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {number} seconds - The duration in seconds."
        }
      ]
    },
    {
      "id": "b-660",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {string} The formatted duration."
        }
      ]
    },
    {
      "id": "b-661",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-662",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const formatDuration = (seconds) => {"
        }
      ]
    },
    {
      "id": "b-663",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (seconds < 60) seconds = 60"
        }
      ]
    },
    {
      "id": "b-664",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const hours = Math.floor(seconds / 3600)"
        }
      ]
    },
    {
      "id": "b-665",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const minutes = Math.floor((seconds % 3600) / 60)"
        }
      ]
    },
    {
      "id": "b-666",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return `${hours}h ${minutes}m`"
        }
      ]
    },
    {
      "id": "b-667",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-668",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-669",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Fetch show details by show ID."
        }
      ]
    },
    {
      "id": "b-670",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {number} showId - The ID of the show."
        }
      ]
