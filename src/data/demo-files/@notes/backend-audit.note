      ]
    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "app.use(express.urlencoded({ extended: true }))"
        }
      ]
    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "inject()"
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Fetches items from a specified organization collection."
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} collection - The name of the collection to fetch items from."
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<Array>} A promise that resolves to an array of items from the specified collection."
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const getOrgCollection = (collection) => {"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "console.log('getting org collection:', collection)"
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return pb.api.collection(collection).getFullList({"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filter: `organization = \"${org_id}\"`,"
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
    {
      "id": "b-41",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-42",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-43",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Fetches a single item from the organization collection by key."
        }
      ]
    },
    {
      "id": "b-44",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} key - The key of the item to fetch."
        }
      ]
    },
    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<Object>} A promise that resolves to the item from the specified key."
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const getFromOrg = (key) => {"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return pb.get('organizations', { id: org_id }).then((res) => res[key])"
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Checks if the sync is needed. This ensures that we don't overload the API with too many requests."
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {Object} req - The request object containing the data we are syncing, and the last sync time."
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {Object} res - The response object containing the synced data."
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @todo: double check the cache & sync logic"
        }
      ]
    },
    {
      "id": "b-55",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @important: this is a temporary function, we need to refactor the sync logic to use the event parameter. Do not use this function yet!"
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-57",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const checkSync = async (req, res) => {"
        }
      ]
    },
    {
      "id": "b-58",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "try {"
        }
      ]
    },
    {
      "id": "b-59",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "let data"
        }
      ]
    },
    {
      "id": "b-60",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const lastSyncTime = req.app.locals.lastSyncTime || 0"
        }
      ]
    },
    {
      "id": "b-61",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const currentTime = Date.now()"
        }
      ]
    },
    {
      "id": "b-62",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (currentTime - lastSyncTime > 3600000 /* 1 hour */) {"
        }
      ]
    },
    {
      "id": "b-63",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// The timeslots are outdated, so we sync them by fetching from Cablecast, then updating PocketBase"
        }
      ]
    },
    {
      "id": "b-64",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "log('⚡️ Syncing timeslots with PocketBase...')"
        }
      ]
    },
    {
      "id": "b-65",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "data = await sync(org_id, req).catch((e) => write(e))"
        }
      ]
    },
    {
      "id": "b-66",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "req.app.locals.lastSyncTime = currentTime // Update last sync time"
        }
      ]
    },
    {
      "id": "b-67",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// console.log('data (from sync): ', data)"
        }
      ]
    },
    {
      "id": "b-68",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} else {"
        }
      ]
    },
    {
      "id": "b-69",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "log('⚡️ Fetching timeslots from PocketBase cache...')"
        }
      ]
    },
    {
      "id": "b-70",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "data = await getFromOrg('timeslots')"
        }
      ]
    },
    {
      "id": "b-71",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// console.log('data (from cache): ', data)"
        }
      ]
    },
    {
      "id": "b-72",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-73",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const payload = resolve(data, req.query)"
        }
      ]
    },
    {
      "id": "b-74",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "console.log('payload: ', payload)"
        }
      ]
    },
    {
      "id": "b-75",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "res.json(payload ?? [])"
        }
      ]
    },
    {
      "id": "b-76",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} catch (e) {"
        }
      ]
    },
    {
      "id": "b-77",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "write(e)"
        }
      ]
    },
    {
      "id": "b-78",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "res.status(500).json({ error: e.message })"
        }
      ]
    },
    {
      "id": "b-79",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-80",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-81",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-82",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Fetches all schedule items from Cablecast."
        }
      ]
    },
    {
      "id": "b-83",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<Array>} A promise that resolves to an array of schedule items."
        }
      ]
    },
    {
      "id": "b-84",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-85",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async function fetchAllScheduleItems() {"
        }
      ]
    },
    {
      "id": "b-86",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "let allItems = []"
        }
      ]
    },
    {
      "id": "b-87",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "let hasMore = true"
        }
      ]
    },
    {
      "id": "b-88",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "let page = 1"
        }
      ]
    },
    {
      "id": "b-89",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "while (hasMore) {"
        }
      ]
    },
    {
      "id": "b-90",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const response = await cablecast.get(`scheduleitems?page=${page}`)"
        }
      ]
    },
    {
      "id": "b-91",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const data = await response.json()"
        }
      ]
    },
    {
      "id": "b-92",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "allItems.push(...data.items)"
        }
      ]
    },
    {
      "id": "b-93",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "hasMore = data.pagination.hasMore // Adjust based on actual API response structure"
        }
      ]
    },
    {
      "id": "b-94",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "page++"
        }
      ]
    },
    {
      "id": "b-95",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return allItems"
        }
      ]
    },
    {
      "id": "b-97",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-98",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async function mapShowsToChannels() {"
        }
      ]
    },
    {
      "id": "b-99",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const scheduleItems = await fetchAllScheduleItems()"
        }
      ]
    },
    {
      "id": "b-100",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const showChannelMap = {}"
        }
      ]
    },
    {
      "id": "b-101",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "for (const item of scheduleItems) {"
        }
      ]
    },
    {
      "id": "b-102",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (item.showId && item.channel) {"
        }
      ]
    },
    {
      "id": "b-103",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "showChannelMap[item.showId] = item.channel"
        }
      ]
    },
    {
      "id": "b-104",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-105",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-106",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return showChannelMap"
        }
      ]
    },
    {
      "id": "b-107",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-108",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-109",
