    },
    {
      "id": "b-148",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const lastSync = await getFromOrg('last_sync')"
        }
      ]
    },
    {
      "id": "b-149",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const expiration = new Date(lastSync).getTime() + 900000 // 15 minutes"
        }
      ]
    },
    {
      "id": "b-150",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const stale = Date.now() > expiration"
