    {
      "id": "b-1122",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-1123",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Delete a record from a collection."
        }
      ]
    },
    {
      "id": "b-1124",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} collection - The name of the collection."
        }
      ]
    },
    {
      "id": "b-1125",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} id - The ID of the record to delete."
        }
      ]
    },
    {
      "id": "b-1126",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-1127",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "deleteRecord: async (collection, id) => {"
        }
      ]
    },
    {
      "id": "b-1128",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return await pocketbase.collection(collection).delete(id)"
        }
      ]
    },
    {
      "id": "b-1129",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-1130",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-1131",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Subscribe to changes in a collection."
        }
      ]
    },
    {
      "id": "b-1132",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} collection - The name of the collection."
        }
      ]
    },
    {
      "id": "b-1133",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} id - The ID of the record to subscribe to. If not provided, subscribes to all records."
        }
      ]
    },
    {
      "id": "b-1134",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {(data: any) => void} callback - The callback function to call when a change occurs."
        }
      ]
    },
    {
      "id": "b-1135",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-1136",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subscribe: async (collection, id = '*', callback) => {"
        }
      ]
    },
    {
      "id": "b-1137",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return await pocketbase.collection(collection).subscribe(id, callback)"
        }
      ]
    },
    {
      "id": "b-1138",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-1139",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-1140",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Unsubscribe from changes in a collection."
        }
      ]
    },
    {
      "id": "b-1141",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} collection - The name of the collection."
        }
      ]
    },
    {
      "id": "b-1142",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @param {string} [id] - The ID of the record to unsubscribe from. If not provided, unsubscribes from all records."
        }
      ]
    },
    {
      "id": "b-1143",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* @returns {Promise<void>} A promise that resolves when the unsubscription is complete."
        }
      ]
    },
    {
      "id": "b-1144",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-1145",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "unsubscribe: async (collection, id) => {"
        }
      ]
    },
    {
      "id": "b-1146",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return await pocketbase.collection(collection).unsubscribe(id)"
        }
      ]
    },
    {
      "id": "b-1147",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-1148",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-1149",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-1150",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-1151",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    }
  ]
}