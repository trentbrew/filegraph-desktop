      ]
    },
    {
      "id": "b-152",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (stale || req.query.fresh === 'true') {"
        }
      ]
    },
    {
      "id": "b-153",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "log('⚡️ Syncing timeslots with PocketBase...')"
        }
      ]
    },
    {
      "id": "b-154",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "payload = await sync(org_id).catch((e) => write(e))"
        }
      ]
    },
    {
      "id": "b-155",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await pb.update('organizations', org_id, { last_sync: new Date().toISOString() })"
        }
      ]
    },
    {
      "id": "b-156",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} else {"
        }
