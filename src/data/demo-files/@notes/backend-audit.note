          "text": "} catch (err) {"
        }
      ]
    },
    {
      "id": "b-558",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "console.error('Unable to moderate prompt', err)"
        }
      ]
    },
    {
      "id": "b-559",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return { message: prompt, approved: false, reason: 'Unable to post comment' }"
        }
      ]
    },
    {
      "id": "b-560",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-561",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-562",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
