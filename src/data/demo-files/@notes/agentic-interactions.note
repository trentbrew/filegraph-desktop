{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "note:notion-440",
  "title": "Agentic Interactions",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "Agentic Interactions"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "bulletList",
      "children": [
        {
          "id": "b-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Agent tries its best to guess what it is you mean"
            }
          ]
        },
        {
          "id": "b-3",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Agent always prompts the user to help it understand the exact output you’re going for"
            }
          ]
        },
        {
          "id": "b-4",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Agent stores what it learns from the user, knows what it doesn’t know, and asks for what it needs to know."
            }
          ]
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "bulletList",
      "children": [
        {
          "id": "b-7",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The agent needs to keep a glossary of common design language, but also an internal user-specific glossary based on the language they use to describe things."
            }
          ]
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "-"
        }
      ]
    }
  ]
}