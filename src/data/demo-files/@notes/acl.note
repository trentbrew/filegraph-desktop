          "type": "text",
          "text": "ACL"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Here are the **simulated results** of `getOneHopNeighborhood(userId, nodeId)` based on our visibility rules and ACLs:"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "👩 Alice's Visible One-Hop Edges:"
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Edge ID | From | To | Visibility | ACL |"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| --- | --- | --- | --- | --- |"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| `e1` | `n1` | `n2` | public | `{}` |"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| `e3` | `n3` | `n1` | shared | `{'read': ['alice']}` |"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "👨 Bob's Visible One-Hop Edges:"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Edge ID | From | To | Visibility | ACL |"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| --- | --- | --- | --- | --- |"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
