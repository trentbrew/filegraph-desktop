    {
      "id": "b-14",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "✅ These results confirm:"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "bulletList",
      "children": [
        {
          "id": "b-15",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The visibility logic works as expected."
            }
          ]
        },
        {
          "id": "b-16",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Users only see edges when both the nodes **and** the edge itself are visible to them."
            }
          ]
        },
        {
          "id": "b-17",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "ACL-based access expands visibility precisely where declared."
            }
          ]
        }
      ]
    }
