    },
    {
      "id": "b-255",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div className=\"grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4\">"
        }
      ]
    },
    {
      "id": "b-256",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{processedData.map((item) => ("
        }
      ]
    },
    {
      "id": "b-257",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<GenericBlockCard key={item.id} item={item} /* ... */ />"
        }
      ]
    },
    {
