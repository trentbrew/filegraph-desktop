    },
    {
      "id": "b-252",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "</div>"
        }
      ]
    },
    {
      "id": "b-253",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ")}"
        }
      ]
    },
    {
      "id": "b-254",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{viewType === 'grid' && ("
        }
