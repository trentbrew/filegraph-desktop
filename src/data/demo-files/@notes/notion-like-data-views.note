      ]
    },
    {
      "id": "b-246",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{viewType === 'list' && ("
        }
      ]
    },
    {
      "id": "b-247",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div className=\"space-y-1\">"
        }
      ]
    },
    {
      "id": "b-248",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{processedData.map((item) => ("
        }
      ]
    },
    {
      "id": "b-249",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<GenericBlockListItem key={item.id} item={item} /* ... */ />"
        }
      ]
    },
    {
      "id": "b-250",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "))}"
        }
      ]
    },
    {
      "id": "b-251",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{/* ... New item placeholder ... */}"
        }
