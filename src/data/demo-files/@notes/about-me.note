      "content": [
        {
          "type": "text",
          "text": "I'm a full-stack software engineer and product designer with over six years of experience building intuitive, customer-facing applications. My focus area is NextJS, Node.js, modern front-end frameworks, UX, and accessibility. I approach everything with design thinking, from UI & branding to systems architecture."
        }
      ]
