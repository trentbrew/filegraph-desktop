      "content": [
        {
          "type": "text",
          "text": "| **Drug Interactions Checker** | ✓ | ✓ | ✓ |"
        }
      ]
    },
    {
      "id": "b-95",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| **Pill Identifier** | ✓ | ✓ | ✓ |"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| **Formulary Information** | ✓ | ✓ | ✓ |"
        }
      ]
    },
    {
      "id": "b-97",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| **Medical Calculators** | ✓ | ✓ | ✓ |"
        }
      ]
    },
    {
      "id": "b-98",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| **Lab Reference Values** | ✓ | ✓ | ✓ |"
        }
      ]
    },
    {
      "id": "b-99",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| **Disease Information** | ✓ | ✓ | ✓ |"
        }
      ]
    },
    {
      "id": "b-100",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| **Clinical Practice Guidelines** | ✓ | ✓ | ✓ |"
        }
      ]
    },
    {
      "id": "b-101",
      "type": "paragraph",
      "content": [
