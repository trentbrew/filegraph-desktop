    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "console.error(`Error processing video ${videoId}:`, error);"
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (retryCount < 3) {"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Exponential backoff retry (1s, 5s, 25s)"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const delay = Math.pow(5, retryCount) * 1000;"
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await ctx.scheduler.runAfter("
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "delay,"
        }
      ]
    },
    {
