        }
      ]
    },
    {
      "id": "b-342",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const deepgramApiKey = process.env.DEEPGRAM_API_KEY;"
        }
      ]
    },
    {
      "id": "b-343",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!deepgramApiKey) {"
        }
      ]
    },
    {
      "id": "b-344",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error(\"DEEPGRAM_API_KEY environment variable is not set\");"
        }
      ]
    },
    {
      "id": "b-345",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-346",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "console.log(`Starting Deepgram transcription for video: ${videoId}`);"
        }
      ]
    },
    {
      "id": "b-347",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Call Deepgram API for transcription"
        }
      ]
    },
    {
      "id": "b-348",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const response = await fetch(\"<https://api.deepgram.com/v1/listen>\", {"
        }
      ]
    },
    {
      "id": "b-349",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "method: \"POST\","
        }
      ]
    },
    {
      "id": "b-350",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "headers: {"
        }
      ]
    },
    {
      "id": "b-351",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"Authorization\": `Token ${deepgramApiKey}`,"
        }
      ]
    },
    {
      "id": "b-352",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"Content-Type\": \"application/json\""
        }
      ]
    },
    {
      "id": "b-353",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-354",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "body: JSON.stringify({"
        }
      ]
    },
    {
      "id": "b-355",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "url: fileUrl,"
        }
      ]
    },
    {
      "id": "b-356",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "model: \"nova-2\","
        }
      ]
    },
    {
      "id": "b-357",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "language: \"en\","
        }
      ]
    },
    {
      "id": "b-358",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "smart_format: true,"
        }
      ]
    },
    {
      "id": "b-359",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "punctuate: true,"
        }
      ]
    },
    {
      "id": "b-360",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "})"
        }
      ]
    },
    {
      "id": "b-361",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-362",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!response.ok) {"
        }
      ]
    },
    {
      "id": "b-363",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const errorText = await response.text();"
        }
      ]
    },
    {
      "id": "b-364",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error(`Deepgram API error: ${response.status} ${errorText}`);"
        }
      ]
    },
    {
      "id": "b-365",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-366",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const result = await response.json();"
        }
      ]
    },
    {
      "id": "b-367",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Extract the transcription text"
        }
      ]
    },
    {
      "id": "b-368",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const transcript = result.results?.channels[0]?.alternatives[0]?.transcript;"
        }
      ]
    },
    {
      "id": "b-369",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!transcript) {"
        }
      ]
    },
    {
      "id": "b-370",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error(\"No transcript was generated\");"
        }
      ]
    },
    {
      "id": "b-371",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-372",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Update the video record with transcription"
        }
      ]
    },
    {
      "id": "b-373",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await ctx.runMutation(internal.videos.updateTranscription, {"
        }
      ]
    },
    {
      "id": "b-374",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "videoId,"
        }
      ]
    },
    {
      "id": "b-375",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "transcription: transcript,"
        }
      ]
    },
    {
      "id": "b-376",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-377",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "console.log(`Successfully transcribed video: ${videoId}`);"
        }
      ]
    },
    {
      "id": "b-378",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return { success: true };"
        }
      ]
    },
    {
      "id": "b-379",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} catch (error) {"
        }
      ]
    },
    {
      "id": "b-380",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "console.error(`Error transcribing video ${videoId}:`, error);"
        }
      ]
    },
    {
      "id": "b-381",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Update video status to indicate transcription error"
        }
      ]
    },
    {
      "id": "b-382",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await ctx.runMutation(internal.videos.updateStatus, {"
        }
      ]
    },
    {
      "id": "b-383",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "videoId,"
        }
      ]
    },
    {
      "id": "b-384",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "status: retryCount >= 2 ? \"transcription_failed\" : \"transcription_error\","
        }
      ]
    },
    {
      "id": "b-385",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-386",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Retry logic for transcription"
        }
      ]
    },
    {
      "id": "b-387",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (retryCount < 3) {"
        }
      ]
    },
    {
      "id": "b-388",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Exponential backoff retry (1min, 5min, 25min)"
        }
      ]
    },
    {
      "id": "b-389",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const delay = Math.pow(5, retryCount) * 60000;"
        }
      ]
    },
    {
      "id": "b-390",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await ctx.scheduler.runAfter("
        }
      ]
    },
    {
      "id": "b-391",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "delay,"
        }
      ]
    },
    {
      "id": "b-392",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "internal.videoProcessing.transcribeVideo,"
        }
      ]
    },
    {
      "id": "b-393",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-394",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "videoId,"
        }
      ]
    },
    {
      "id": "b-395",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "retryCount: retryCount + 1,"
        }
      ]
    },
    {
      "id": "b-396",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-397",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ");"
        }
      ]
    },
    {
      "id": "b-398",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} else {"
        }
      ]
    },
    {
      "id": "b-399",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Mark as completed anyway, but without transcription"
        }
      ]
    },
    {
      "id": "b-400",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await ctx.runMutation(internal.videos.updateStatus, {"
        }
      ]
    },
    {
      "id": "b-401",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "videoId,"
        }
      ]
    },
    {
      "id": "b-402",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "status: \"completed\","
        }
      ]
    },
    {
      "id": "b-403",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-404",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-405",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return { success: false, error: String(error) };"
        }
      ]
    },
    {
      "id": "b-406",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-407",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-408",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-409",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// In the future, we can add more functions like:"
        }
      ]
    },
    {
      "id": "b-410",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// - extractThumbnails"
        }
      ]
    },
    {
      "id": "b-411",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// - notifyVideoProcessingComplete"
        }
      ]
    },
    {
      "id": "b-412",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-413",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Finally, let's add the environment variable for the Deepgram API key to the .env.local file:"
        }
      ]
    },
    {
      "id": "b-414",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-415",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CONVEX_DEPLOYMENT=dev:precious-goldfinch-480 # team: turtle, project: docket-tv"
        }
      ]
    },
    {
      "id": "b-416",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "NEXT_PUBLIC_CONVEX_URL=https://precious-goldfinch-480.convex.cloud"
        }
      ]
    },
    {
      "id": "b-417",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "DEEPGRAM_API_KEY=your_deepgram_api_key_here"
        }
      ]
    },
    {
      "id": "b-418",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-419",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Now, let's create a component to display the transcription for a video:"
        }
      ]
    },
    {
      "id": "b-420",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-421",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import React from \"react\";"
        }
      ]
    },
    {
      "id": "b-422",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { useQuery } from \"convex/react\";"
        }
      ]
    },
    {
      "id": "b-423",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { api } from \"../../convex/_generated/api\";"
        }
      ]
    },
    {
      "id": "b-424",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { Id } from \"../../convex/_generated/dataModel\";"
        }
      ]
    },
    {
      "id": "b-425",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "type VideoTranscriptionProps = {"
        }
      ]
    },
    {
      "id": "b-426",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "videoId: Id<\"videos\">;"
        }
      ]
    },
    {
      "id": "b-427",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-428",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export default function VideoTranscription({ videoId }: VideoTranscriptionProps) {"
        }
      ]
    },
    {
      "id": "b-429",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const video = useQuery(api.videos.getVideo, { videoId });"
        }
      ]
    },
    {
      "id": "b-430",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!video) {"
        }
      ]
    },
    {
      "id": "b-431",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return <div className=\"mt-4 p-4 bg-muted rounded-md\">Loading transcription...</div>;"
        }
      ]
    },
    {
      "id": "b-432",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-433",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (video.status === \"uploaded\" || video.status === \"processing\") {"
        }
      ]
    },
    {
      "id": "b-434",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return ("
        }
      ]
    },
    {
      "id": "b-435",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div className=\"mt-4 p-4 bg-muted rounded-md\">"
        }
      ]
    },
    {
      "id": "b-436",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div className=\"flex items-center\">"
        }
      ]
    },
    {
      "id": "b-437",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div className=\"animate-spin mr-2 h-4 w-4 border-2 border-primary border-t-transparent rounded-full\"></div>"
        }
      ]
    },
    {
      "id": "b-438",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<p>Processing video content...</p>"
        }
      ]
    },
    {
      "id": "b-439",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "</div>"
        }
      ]
    },
    {
      "id": "b-440",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "</div>"
        }
      ]
    },
    {
      "id": "b-441",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ");"
        }
      ]
    },
    {
      "id": "b-442",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-443",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (video.status === \"transcribing\") {"
        }
      ]
    },
    {
      "id": "b-444",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return ("
        }
      ]
    },
    {
      "id": "b-445",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div className=\"mt-4 p-4 bg-muted rounded-md\">"
        }
      ]
    },
    {
      "id": "b-446",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div className=\"flex items-center\">"
        }
      ]
    },
    {
      "id": "b-447",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div className=\"animate-spin mr-2 h-4 w-4 border-2 border-primary border-t-transparent rounded-full\"></div>"
        }
      ]
    },
    {
      "id": "b-448",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<p>Generating transcription...</p>"
        }
      ]
    },
    {
      "id": "b-449",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "</div>"
        }
      ]
    },
    {
      "id": "b-450",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "</div>"
        }
      ]
    },
    {
      "id": "b-451",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ");"
        }
      ]
    },
    {
      "id": "b-452",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-453",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (video.status === \"transcription_error\" || video.status === \"transcription_failed\") {"
        }
      ]
    },
    {
      "id": "b-454",
      "type": "paragraph",
      "content": [
