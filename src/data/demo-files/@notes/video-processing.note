      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const getVideoStreamUrl = query({"
        }
      ]
    },
    {
      "id": "b-950",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "args: {"
        }
      ]
    },
    {
      "id": "b-951",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "videoId: v.id(\"videos\"),"
        }
      ]
    },
    {
      "id": "b-952",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-953",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "handler: async (ctx, args) => {"
        }
      ]
    },
    {
      "id": "b-954",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const video = await ctx.db.get(args.videoId);"
        }
      ]
    },
    {
      "id": "b-955",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!video) return null;"
        }
      ]
    },
    {
      "id": "b-956",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Generate a temporary URL for the video"
        }
      ]
    },
    {
      "id": "b-957",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const url = await ctx.storage.getUrl(video.fileId);"
        }
      ]
    },
    {
      "id": "b-958",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return url;"
