    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await ctx.db.patch(videoId, { status: \"processing\" });"
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// In a real implementation, we would:"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// 1. Generate thumbnails from the video"
        }
      ]
    },
    {
