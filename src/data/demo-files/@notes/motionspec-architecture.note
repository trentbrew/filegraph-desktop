{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "note:notion-359",
  "title": "MotionSpec Architecture",
  "author": "person:jane-brew:001",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "MotionSpec Architecture"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```mermaid"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "flowchart TB"
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subgraph CLI[\"CLI / API\"]"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CAPTURE_CMD[\"capture <url>\"]"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "NORMALIZE_CMD[\"normalize <run>\"]"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "REPORT_CMD[\"report <run>\"]"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "EXPORT_CMD[\"export-vue <run>\"]"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "end"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CAPTURE_CMD --> PW[Playwright Driver]"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "PW -->|scroll script| ScrollCtl[\"Scroll Controller\\n(1–2% steps, adaptive refine)\"]"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "PW --> InjectProbe[\"In-Page Probe\\naddInitScript()\"]"
        }
      ]
    },
    {
      "id": "b-13",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "PW --> CDP[\"Chrome DevTools Protocol\\nperf trace, screenshots\"]"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subgraph RUNTIME[\"Runtime Capture\"]"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "ScrollCtl --> DOMSnap[\"DOM Snapshotter\\n(target discovery, bounding boxes)\"]"
        }
      ]
    },
    {
      "id": "b-16",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "InjectProbe --> WAAPI[\"Web Animations API\\n(document.getAnimations)\"]"
        }
      ]
    },
    {
      "id": "b-17",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "InjectProbe --> LibHooks[\"Lib Hooks\\nGSAP/ScrollTrigger, Framer, Lenis\"]"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CDP --> Perf[\"Perf Sampler\\n(FPS approx, Long Tasks, Paint/Layout)\"]"
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CDP --> Shots[\"Keyframe Thumbnails\\n(section boundaries + deltas)\"]"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "end"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RUNTIME --> RawRun[\"Raw Run Artifact\\n(JSONL frames + assets)\"]"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RawRun --> Store[(Artifact Store\\nS3/FS + manifest)]"
        }
      ]
    },
    {
      "id": "b-23",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "NORMALIZE_CMD --> Normalizer[\"Normalizer\\n(transform decomposition, easing map)\"]"
        }
      ]
    },
    {
      "id": "b-24",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subgraph ADAPTERS[\"Adapters (pluggable)\"]"
        }
      ]
    },
    {
      "id": "b-25",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A1[\"CSS Keyframes + View Timelines\"]"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A2[\"GSAP + ScrollTrigger\"]"
        }
      ]
    },
    {
      "id": "b-27",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A3[\"Framer Motion\"]"
        }
      ]
    },
    {
      "id": "b-28",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A4[\"Lenis / Locomotive\"]"
        }
      ]
    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "end"
        }
      ]
    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RawRun --> ADAPTERS"
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "ADAPTERS --> Normalizer"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subgraph SPEC[\"Schema & Validation\"]"
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Schema[\"MotionSpec Schema (v1)\\nJSON Schema / Zod types\"]"
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Validator[\"Validator (AJV/Zod)\"]"
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Policy[\"Reduced-Motion Policy\\n(alternates / disables)\"]"
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "end"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Normalizer --> Validator"
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Schema --> Validator"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Policy --> Normalizer"
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Validator --> MotionSpec[\"MotionSpec.json\\ncanonical, versioned\"]"
        }
      ]
    },
    {
      "id": "b-41",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "REPORT_CMD --> Reporter[\"HTML/MD Report Generator\"]"
        }
      ]
    },
    {
      "id": "b-42",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "MotionSpec --> Reporter"
        }
      ]
    },
    {
      "id": "b-43",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Shots --> Reporter"
        }
      ]
    },
    {
      "id": "b-44",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Perf --> Reporter"
        }
      ]
    },
    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Reporter --> ReportOut[(report.html + assets)]"
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "EXPORT_CMD --> Exporter[\"Exporter: MotionSpec ➝ Storytime\"]"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "MotionSpec --> Exporter"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Exporter --> VuePkg[(Generated Vue scenes\\n+ runtime bridge)]"
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "VuePkg --> Storytime[\"Storytime Engine (Vue)\\nLayoutContainer, scenes, tokens\"]"
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subgraph CI[\"CI / Ops\"]"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CIJob[\"CI job (PR/cron)\"]"
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Snap[\"Snapshot Tests\\n(hashes of transform sequences)\"]"
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Diff[\"Spec Diffs between runs\"]"
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Logs[\"Run Logs & Telemetry\"]"
        }
      ]
    },
    {
      "id": "b-55",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "end"
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CIJob --> CAPTURE_CMD"
        }
      ]
    },
    {
      "id": "b-57",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CIJob --> NORMALIZE_CMD"
        }
      ]
    },
    {
      "id": "b-58",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "CIJob --> REPORT_CMD"
        }
      ]
    },
    {
      "id": "b-59",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "MotionSpec --> Snap"
        }
      ]
    },
    {
      "id": "b-60",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RawRun --> Diff"
        }
      ]
    },
    {
      "id": "b-61",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "MotionSpec --> Diff"
        }
      ]
    },
    {
      "id": "b-62",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RawRun --> Logs"
        }
      ]
    },
    {
      "id": "b-63",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Reporter --> Logs"
        }
      ]
    },
    {
      "id": "b-64",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    }
  ]
}