    {
      "id": "b-7",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Startup Details"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Help us understand your startup: the problem you’re solving, your solution, and where you are today."
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*Required fields are marked with an asterisk (**\\***)*"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Startup Name **\\**"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "bulletList",
      "children": [
        {
          "id": "b-11",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**[Input field]***Your answer*"
            }
          ]
        }
      ]
    },
    {
      "id": "b-13",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Pitch your startup in one sentence **\\**"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "What do you do and for whom?"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*E.g. “AI-powered therapist for Gen Z”*"
        }
      ]
    },
    {
      "id": "b-17",
      "type": "bulletList",
      "children": [
        {
          "id": "b-16",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**[Input field]** (Max 10 words)"
            }
