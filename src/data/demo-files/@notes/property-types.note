      ]
    },
    {
      "id": "b-138",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.tables.push(newTable);"
        }
      ]
    },
    {
      "id": "b-139",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-140",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
