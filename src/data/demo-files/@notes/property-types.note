      "id": "b-154",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "getters: {"
        }
      ]
    },
    {
      "id": "b-155",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "getPropertiesForTable: (state) => (tableId: string) => {"
        }
      ]
    },
    {
      "id": "b-156",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return state.properties.filter(p => p.tableId === tableId);"
        }
      ]
    },
    {
      "id": "b-157",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-158",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "getViewsForTable: (state) => (tableId: string) => {"
        }
      ]
    },
    {
      "id": "b-159",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return state.views.filter(v => v.tableId === tableId);"
        }
      ]
    },
    {
      "id": "b-160",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-161",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-162",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});`"
        }
      ]
    },
    {
      "id": "b-163",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-164",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "**`graphStore`**"
        }
      ]
    },
    {
      "id": "b-165",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "This store manages the data-level entities: the actual nodes and their connections."
        }
      ]
    },
    {
      "id": "b-166",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "**TypeScript**"
        }
      ]
    },
    {
      "id": "b-167",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```jsx"
        }
      ]
    },
    {
      "id": "b-168",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// @/stores/graphStore.ts"
        }
      ]
    },
    {
      "id": "b-169",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { defineStore } from 'pinia';"
        }
      ]
    },
    {
      "id": "b-170",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { dbPromise } from '@/utils/db';"
        }
      ]
    },
    {
      "id": "b-171",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Import your data interfaces (Node, Edge)"
        }
      ]
    },
    {
      "id": "b-172",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const useGraphStore = defineStore('graph', {"
        }
      ]
    },
    {
      "id": "b-173",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "state: () => ({"
        }
      ]
    },
    {
      "id": "b-174",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "nodes: [] as Node[],"
        }
      ]
    },
    {
      "id": "b-175",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "edges: [] as Edge[],"
        }
      ]
    },
    {
      "id": "b-176",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}),"
        }
      ]
    },
    {
      "id": "b-177",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "actions: {"
        }
      ]
    },
    {
      "id": "b-178",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async initialize() {"
        }
      ]
    },
    {
      "id": "b-179",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const db = await dbPromise;"
        }
      ]
    },
    {
      "id": "b-180",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.nodes = await db.getAll('nodes');"
        }
      ]
    },
    {
      "id": "b-181",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.edges = await db.getAll('edges');"
        }
      ]
    },
    {
      "id": "b-182",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-183",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async createNode(tableId: string, properties: { [propertyId: string]: any }) {"
        }
      ]
    },
    {
      "id": "b-184",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const db = await dbPromise;"
        }
      ]
    },
    {
      "id": "b-185",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const newNode: Node = {"
        }
      ]
    },
    {
      "id": "b-186",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: crypto.randomUUID(),"
        }
      ]
    },
    {
      "id": "b-187",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tableId,"
        }
      ]
    },
    {
      "id": "b-188",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "properties,"
        }
      ]
    },
    {
      "id": "b-189",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "createdAt: new Date(),"
        }
      ]
    },
    {
      "id": "b-190",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "updatedAt: new Date(),"
        }
      ]
    },
    {
      "id": "b-191",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-192",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await db.put('nodes', newNode);"
        }
      ]
    },
    {
      "id": "b-193",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.nodes.push(newNode);"
        }
      ]
    },
    {
      "id": "b-194",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-195",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async updateNode(nodeId: string, updatedProperties: { [propertyId: string]: any }) {"
        }
      ]
    },
    {
      "id": "b-196",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const db = await dbPromise;"
        }
      ]
    },
    {
      "id": "b-197",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const nodeIndex = this.nodes.findIndex(n => n.id === nodeId);"
        }
      ]
    },
    {
      "id": "b-198",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (nodeIndex === -1) return;"
        }
      ]
    },
    {
      "id": "b-199",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const updatedNode = {"
        }
      ]
    },
    {
      "id": "b-200",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "...this.nodes[nodeIndex],"
        }
      ]
    },
    {
      "id": "b-201",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "properties: { ...this.nodes[nodeIndex].properties, ...updatedProperties },"
        }
      ]
    },
    {
      "id": "b-202",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "updatedAt: new Date(),"
        }
      ]
    },
    {
      "id": "b-203",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-204",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await db.put('nodes', updatedNode);"
        }
      ]
    },
    {
      "id": "b-205",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.nodes[nodeIndex] = updatedNode;"
        }
      ]
    },
    {
      "id": "b-206",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-207",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async createEdge(sourceNodeId: string, targetNodeId: string, propertyId: string) {"
        }
      ]
    },
    {
      "id": "b-208",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const db = await dbPromise;"
        }
      ]
    },
    {
      "id": "b-209",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const newEdge: Edge = {"
        }
      ]
    },
    {
      "id": "b-210",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: crypto.randomUUID(),"
        }
      ]
    },
    {
      "id": "b-211",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sourceNodeId,"
        }
      ]
    },
    {
      "id": "b-212",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "targetNodeId,"
        }
      ]
    },
    {
      "id": "b-213",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "propertyId,"
        }
      ]
    },
    {
      "id": "b-214",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "createdAt: new Date(),"
        }
      ]
    },
    {
      "id": "b-215",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-216",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await db.put('edges', newEdge);"
        }
      ]
    },
    {
      "id": "b-217",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.edges.push(newEdge);"
        }
      ]
    },
    {
      "id": "b-218",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Also update the node's property to reflect the relation"
        }
      ]
    },
    {
      "id": "b-219",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const sourceNode = this.nodes.find(n => n.id === sourceNodeId);"
        }
      ]
    },
    {
      "id": "b-220",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (sourceNode) {"
        }
      ]
    },
    {
      "id": "b-221",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const currentRelations = sourceNode.properties[propertyId] || [];"
        }
      ]
    },
    {
      "id": "b-222",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await this.updateNode(sourceNodeId, { [propertyId]: [...currentRelations, targetNodeId] });"
        }
      ]
    },
    {
      "id": "b-223",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-224",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-225",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
