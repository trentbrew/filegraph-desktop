        }
      ]
    },
    {
      "id": "b-141",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const db = await dbPromise;"
        }
      ]
    },
    {
      "id": "b-142",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const newProperty: Property = { id: crypto.randomUUID(), tableId, name, type, options, createdAt: new Date() };"
        }
      ]
    },
    {
      "id": "b-143",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await db.put('properties', newProperty);"
        }
      ]
    },
    {
      "id": "b-144",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.properties.push(newProperty);"
        }
      ]
    },
    {
      "id": "b-145",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-146",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async createView(tableId: string, name: string, type: View['type'], config: View['config']) {"
        }
      ]
    },
    {
      "id": "b-147",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const db = await dbPromise;"
        }
      ]
    },
    {
      "id": "b-148",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const newView: View = { id: crypto.randomUUID(), tableId, name, type, config, createdAt: new Date() };"
        }
      ]
    },
    {
      "id": "b-149",
      "type": "paragraph",
      "content": [
