      ]
    },
    {
      "id": "b-79",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "createWebhook(vendorId: string, events: string[]): Promise<WebhookResult>;"
        }
      ]
    },
    {
      "id": "b-80",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
