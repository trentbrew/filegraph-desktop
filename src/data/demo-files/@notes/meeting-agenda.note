    {
      "id": "b-24",
      "type": "bulletList",
      "children": [
        {
          "id": "b-22",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Review draft curriculum outline** (business, crowdfunding, marketing, storytelling weeks)"
            }
