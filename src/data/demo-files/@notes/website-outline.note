          "id": "b-27",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Current research focus (e.g., her work on antiblackness in France)"
            }
          ]
        },
        {
          "id": "b-28",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Ongoing fellowships (French Institute for Advanced Study, etc.)"
            }
          ]
        },
        {
          "id": "b-29",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Videos or recordings of lectures/presentations"
            }
          ]
        }
      ]
    },
    {
      "id": "b-31",
      "type": "heading",
      "level": 3,
      "content": [
