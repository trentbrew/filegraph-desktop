    },
    {
      "id": "b-91",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```mermaid"
        }
      ]
    },
    {
      "id": "b-92",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sequenceDiagram"
        }
      ]
    },
    {
      "id": "b-93",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Agent A"
        }
      ]
    },
    {
      "id": "b-94",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Message Bus"
        }
      ]
    },
    {
      "id": "b-95",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Channel"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Thread"
        }
      ]
    },
    {
      "id": "b-97",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Agent B"
        }
      ]
    },
    {
      "id": "b-98",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agent A->>Message Bus: Send Message"
        }
      ]
    },
    {
      "id": "b-99",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Message Bus->>Channel: Route to Channel"
        }
      ]
    },
    {
      "id": "b-100",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Channel->>Thread: Create/Update Thread"
        }
      ]
    },
    {
      "id": "b-101",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Thread->>Agent B: Notify"
        }
      ]
    },
    {
      "id": "b-102",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agent B->>Thread: Process & Respond"
        }
      ]
    },
    {
      "id": "b-103",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Thread->>Channel: Update Thread"
        }
      ]
    },
    {
      "id": "b-104",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Channel->>Message Bus: Broadcast Update"
        }
      ]
    },
    {
      "id": "b-105",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Message Bus->>Agent A: Deliver Response"
        }
      ]
    },
    {
      "id": "b-106",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
