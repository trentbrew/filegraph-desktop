{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "note:notion-441",
  "title": "JOSN-LD Task Template",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "JOSN-LD Task Template"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Here’s a clean, reusable JSON-LD template you can drop in and fill. It keeps your structure but removes project-specific details and uses clear placeholders."
        }
      ]
    },
    {
      "id": "b-3",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```json"
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@context\": \"https://schema.org\","
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@type\": \"Project\","
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"name\": \"<PROJECT_NAME>\","
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"identifier\": \"<PROJECT_KEY>\",                      // e.g., \"ANIM\""
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"description\": \"<PROJECT_DESCRIPTION>\","
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"url\": \"<PROJECT_URL>\","
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"provider\": {"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@type\": \"Organization\","
        }
      ]
    },
    {
      "id": "b-13",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"name\": \"<ORG_NAME>\""
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"dateCreated\": \"<YYYY-MM-DD>\","
        }
      ]
    },
    {
      "id": "b-16",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"dateModified\": \"<YYYY-MM-DD>\","
        }
      ]
    },
    {
      "id": "b-17",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"inLanguage\": \"<BCP47_CODE>\",                       // e.g., \"en\""
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"hasPart\": ["
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@type\": \"CreativeWork\","
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"identifier\": \"<PROJECT_KEY>-<N>\",              // e.g., \"ANIM-1\""
        }
      ]
    },
    {
      "id": "b-22",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"name\": \"<TASK_TITLE>\","
        }
      ]
    },
    {
      "id": "b-23",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"description\": \"<TASK_DESCRIPTION>\","
        }
      ]
    },
    {
      "id": "b-24",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"workflowState\": { \"name\": \"<Todo|InProgress|Blocked|Done>\" },"
        }
      ]
    },
    {
      "id": "b-25",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"labels\": [\"<TAG_1>\", \"<TAG_2>\"],              // free-form tags"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"priority\": <1|2|3|...>,                        // lower = higher priority (define your scale)"
        }
      ]
    },
    {
      "id": "b-27",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"estimate\": <NUMBER_OF_POINTS_OR_DAYS>,         // numeric estimate"
        }
      ]
    },
    {
      "id": "b-28",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"userImpact\": \"<low|medium|high|critical>\","
        }
      ]
    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"accessibility\": <true|false>,"
        }
      ]
    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"requires\": [\"<UPSTREAM_TASK_ID>\", \"...\"],      // identifiers like \"ANIM-5\""
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"blockedBy\": [\"<BLOCKER_NOTE_OR_ID>\", \"...\"],   // free text or IDs"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"uxRationale\": \"<WHY_THIS_MATTERS>\","
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"acceptanceCriteria\": ["
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"<CRITERION_1>\","
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"<CRITERION_2>\""
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@id\": \"task:<PROJECT_KEY>-<N>\""
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/* Repeat task blocks as needed */"
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "]"
        }
      ]
    },
    {
      "id": "b-41",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-42",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-43",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Mini “add-a-task” snippet (copy/paste into `hasPart`):"
        }
      ]
    },
    {
      "id": "b-44",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```json"
        }
      ]
    },
    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@type\": \"CreativeWork\","
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"identifier\": \"<PROJECT_KEY>-<N>\","
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"name\": \"<TASK_TITLE>\","
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"description\": \"<TASK_DESCRIPTION>\","
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"workflowState\": { \"name\": \"<Todo|InProgress|Blocked|Done>\" },"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"labels\": [],"
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"priority\": 3,"
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"estimate\": 1,"
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"userImpact\": \"medium\","
        }
      ]
    },
    {
      "id": "b-55",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"accessibility\": true,"
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"requires\": [],"
        }
      ]
    },
    {
      "id": "b-57",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"blockedBy\": [],"
        }
      ]
    },
    {
      "id": "b-58",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"uxRationale\": \"<RATIONALE>\","
        }
      ]
    },
    {
      "id": "b-59",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"acceptanceCriteria\": [],"
        }
      ]
    },
    {
      "id": "b-60",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@id\": \"task:<PROJECT_KEY>-<N>\""
        }
      ]
    },
    {
      "id": "b-61",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-62",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-63",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Notes (brief):"
        }
      ]
    },
    {
      "id": "b-67",
      "type": "bulletList",
      "children": [
        {
          "id": "b-64",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`workflowState.name`: keep a tight enum so queries are sane."
            }
          ]
        },
        {
          "id": "b-65",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`priority`/`estimate`: define what numbers mean once (e.g., RICE, points, days)."
            }
          ]
        },
        {
          "id": "b-66",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`@id`: stable, dereferenceable if you later expose a task endpoint."
            }
          ]
        }
      ]
    }
  ]
}