    },
    {
      "id": "b-85",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "### **Layer 1: Core Runtime (Open Source)**"
        }
      ]
    },
    {
      "id": "b-86",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-87",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// npm install @ldc/runtime"
        }
      ]
    },
    {
      "id": "b-88",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { evaluate, validate } from '@ldc/runtime';"
        }
      ]
    },
    {
      "id": "b-89",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const model = {"
        }
