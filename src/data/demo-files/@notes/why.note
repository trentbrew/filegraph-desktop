    {
      "id": "b-100",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// React"
        }
      ]
    },
    {
      "id": "b-101",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { useLDC } from '@ldc/react';"
        }
      ]
    },
    {
      "id": "b-102",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "function Budget() {"
        }
      ]
    },
    {
      "id": "b-103",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const [model, setModel] = useLDC(initialModel);"
        }
      ]
    },
    {
      "id": "b-104",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return <LDCTable model={model} onChange={setModel} />;"
        }
      ]
    },
    {
      "id": "b-105",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-106",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Svelte"
        }
      ]
    },
    {
      "id": "b-107",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { ldcStore } from '@ldc/svelte';"
        }
      ]
