      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-64",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"core_value\": \"You build it once, it works everywhere\""
        }
      ]
    },
    {
      "id": "b-65",
      "type": "paragraph",
      "content": [
        {
