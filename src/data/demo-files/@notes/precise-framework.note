{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "note:notion-211",
  "title": "PRECISE Framework",
  "author": "person:jane-brew:001",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "PRECISE Framework"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "P - Purpose"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "bulletList",
      "children": [
        {
          "id": "b-3",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Clearly define what you want to accomplish"
            }
          ]
        },
        {
          "id": "b-4",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "State your goal upfront"
            }
          ]
        },
        {
          "id": "b-5",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Example: \"I need to create a marketing strategy for a new coffee shop\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-7",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "R - Requirements"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "bulletList",
      "children": [
        {
          "id": "b-8",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Specify any constraints or parameters"
            }
          ]
        },
        {
          "id": "b-9",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Include format preferences, tone, length, or audience"
            }
          ]
        },
        {
          "id": "b-10",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Example: \"Please format this as bullet points suitable for a business presentation\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-12",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "E - Examples"
        }
      ]
    },
    {
      "id": "b-16",
      "type": "bulletList",
      "children": [
        {
          "id": "b-13",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Provide examples of what you're looking for"
            }
          ]
        },
        {
          "id": "b-14",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Include \"good\" and \"bad\" examples when possible"
            }
          ]
        },
        {
          "id": "b-15",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Example: \"Here's a sample of the writing style I'm looking for...\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-17",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "C - Context"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "bulletList",
      "children": [
        {
          "id": "b-18",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Supply relevant background information"
            }
          ]
        },
        {
          "id": "b-19",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Share specific details the LLM wouldn't know"
            }
          ]
        },
        {
          "id": "b-20",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Example: \"Our target demographic is urban professionals aged 25-40\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-22",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "I - Instructions"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "bulletList",
      "children": [
        {
          "id": "b-23",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Break complex requests into clear steps"
            }
          ]
        },
        {
          "id": "b-24",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use numbered lists for multi-part questions"
            }
          ]
        },
        {
          "id": "b-25",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Example: \"1. Analyze the problem. 2. Propose three solutions. 3. Recommend the best option.\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-27",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "S - Scope"
        }
      ]
    },
    {
      "id": "b-31",
      "type": "bulletList",
      "children": [
        {
          "id": "b-28",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Define the boundaries of your request"
            }
          ]
        },
        {
          "id": "b-29",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Indicate depth vs. breadth preference"
            }
          ]
        },
        {
          "id": "b-30",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Example: \"Focus on practical implementation rather than theoretical background\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-32",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "E - Evaluation"
        }
      ]
    },
    {
      "id": "b-36",
      "type": "bulletList",
      "children": [
        {
          "id": "b-33",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Specify how to evaluate success"
            }
          ]
        },
        {
          "id": "b-34",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Include your criteria for a good response"
            }
          ]
        },
        {
          "id": "b-35",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Example: \"The response should be persuasive and include data points that support each claim\""
            }
          ]
        }
      ]
    }
  ]
}