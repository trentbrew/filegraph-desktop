            {
              "type": "text",
              "text": "…"
            }
          ]
        }
      ]
    },
    {
      "id": "b-23",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Company Description (50 chars max):** Describe what your company does in 50 characters or less."
        }
      ]
    },
    {
      "id": "b-25",
      "type": "bulletList",
      "children": [
        {
          "id": "b-24",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "…"
            }
          ]
