      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "1. Founders"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Who are the founders?**"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "bulletList",
      "children": [
        {
          "id": "b-5",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "…"
            }
          ]
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Technical Work:** Who writes code, or does other technical work on your product? Was any of it done by a non-founder? Please explain."
        }
      ]
    },
    {
      "id": "b-9",
      "type": "bulletList",
      "children": [
        {
          "id": "b-8",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "…"
            }
          ]
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Cofounder Search:** Are you looking for a cofounder?"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "bulletList",
      "children": [
        {
          "id": "b-11",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "…"
            }
          ]
        }
      ]
    },
    {
      "id": "b-13",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "2. Founder Video"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Video Instructions:** Please record a one minute video introducing the founder(s). Make sure the file does not exceed 100 MB. ([examples](https://www.ycombinator.com/video))"
        }
      ]
    },
    {
      "id": "b-17",
      "type": "bulletList",
      "children": [
        {
          "id": "b-16",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "*Upload founder video*"
            }
          ]
        }
      ]
    },
    {
      "id": "b-18",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "3. Company"
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Company Name:**"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "bulletList",
