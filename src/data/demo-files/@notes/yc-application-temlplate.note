    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Demo Upload:** If you have a demo, attach it below. Anything that shows us how the product works. Please limit to 3 minutes / 100 MB."
        }
      ]
    },
    {
      "id": "b-31",
      "type": "bulletList",
      "children": [
        {
          "id": "b-30",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "*Upload video*"
            }
          ]
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Product Link:** Please provide a link to the product, if any."
        }
      ]
    },
    {
      "id": "b-34",
      "type": "bulletList",
      "children": [
        {
          "id": "b-33",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "…"
            }
          ]
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Product Description:** What is your company going to make? Please describe your product and what it does or will do."
        }
      ]
    },
    {
      "id": "b-37",
      "type": "bulletList",
      "children": [
        {
          "id": "b-36",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "…"
