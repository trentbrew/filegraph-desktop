    {
      "id": "b-6",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Executive Summary"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Transform filegraph from a developer project management tool into **TurtleHQ**—a comprehensive digital headquarters that orchestrates specialized AI agents across all business functions. Each agent operates within the same semantic knowledge graph, creating a unified command center for Acme Corp."
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Core Philosophy"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**\"One Graph, Many Minds\"**"
        }
      ]
    },
