          "id": "b-11",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Single source of truth: `.filegraph/graph.jsonld`"
            }
          ]
        },
        {
          "id": "b-12",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Specialized agents with domain expertise"
