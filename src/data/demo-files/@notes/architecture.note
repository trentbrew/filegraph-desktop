          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-229",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Kanban is just a view of the database"
        }
      ]
    },
    {
      "id": "b-230",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// If database updates, kanban updates"
        }
      ]
    },
    {
      "id": "b-231",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// All via the graph"
        }
      ]
    },
    {
      "id": "b-232",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "graphTransactions.createEdge({"
        }
      ]
    },
    {
      "id": "b-233",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'@id': generateId('edge', 'renders'),"
        }
      ]
    },
    {
      "id": "b-234",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "from: 'urn:app:node:block:sprint-board',"
        }
      ]
    },
    {
      "id": "b-235",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "to: 'urn:app:node:database:tasks',"
        }
      ]
    },
    {
      "id": "b-236",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pred: 'renders',"
        }
      ]
    },
    {
      "id": "b-237",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "meta: { filter: 'assignee === currentUser' }"
        }
      ]
    },
    {
      "id": "b-238",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-239",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-240",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Why this matters:**"
        }
      ]
    },
    {
      "id": "b-245",
      "type": "bulletList",
      "children": [
        {
          "id": "b-241",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Kanban doesn't store its own data"
            }
          ]
        },
        {
          "id": "b-242",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Multiple kanban blocks can view same database"
            }
          ]
        },
        {
          "id": "b-243",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Change one row → all kanban blocks update"
            }
          ]
        },
        {
          "id": "b-244",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "New mini-app type? Just add `@type: ['Block', 'NewAppType']`"
            }
          ]
        }
      ]
    },
    {
      "id": "b-246",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "6. **Agent-Driven Workspace Refinement**"
        }
      ]
    },
    {
      "id": "b-247",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agents can populate, organize, refine the workspace:"
        }
      ]
    },
    {
      "id": "b-248",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-249",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Agent 1: Analyzes strategy, creates wireframes"
        }
      ]
    },
    {
      "id": "b-250",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async function analyzeAndDesign(strategyBlockId) {"
        }
      ]
    },
    {
      "id": "b-251",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { data } = await db.queryOnce({"
        }
      ]
    },
    {
      "id": "b-252",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "nodes: { where: { '@id': strategyBlockId } }"
        }
      ]
    },
    {
      "id": "b-253",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-254",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const strategy = data.nodes[0];"
        }
      ]
    },
    {
      "id": "b-255",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const analysis = await aiAgent.analyze(strategy.props.content);"
        }
      ]
    },
    {
      "id": "b-256",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Create wireframe block"
        }
      ]
    },
    {
      "id": "b-257",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const figmaBlock = {"
        }
      ]
    },
    {
      "id": "b-258",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'@id': generateId('node', 'block'),"
        }
      ]
    },
    {
      "id": "b-259",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'@type': ['Block', 'FigmaEmbed'],"
        }
      ]
    },
    {
      "id": "b-260",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "props: {"
        }
      ]
    },
    {
      "id": "b-261",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title: `Wireframes: ${analysis.mainFlow}`,"
        }
      ]
    },
    {
      "id": "b-262",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pos: { x: 500, y: 0 }, // Auto-position"
        }
      ]
    },
    {
      "id": "b-263",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "figmaUrl: analysis.figmaLink"
        }
      ]
    },
    {
      "id": "b-264",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-265",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-266",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "graphTransactions.createNode(figmaBlock);"
        }
      ]
    },
    {
      "id": "b-267",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Connect via edge"
        }
      ]
    },
    {
      "id": "b-268",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "graphTransactions.createEdge({"
        }
      ]
    },
    {
      "id": "b-269",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'@id': generateId('edge', 'designs'),"
        }
      ]
    },
    {
      "id": "b-270",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "from: strategyBlockId,"
        }
      ]
    },
    {
      "id": "b-271",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "to: figmaBlock['@id'],"
        }
      ]
    },
    {
      "id": "b-272",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pred: 'designs'"
        }
      ]
    },
    {
      "id": "b-273",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-274",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-275",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Agent 2: Monitors for conflicts"
        }
      ]
    },
    {
      "id": "b-276",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async function monitorConsistency(workspaceId) {"
        }
      ]
    },
    {
      "id": "b-277",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { data } = await db.queryOnce({"
        }
      ]
    },
    {
      "id": "b-278",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "nodes: {"
        }
      ]
    },
    {
      "id": "b-279",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "where: { '@type': { $contains: 'Block' }, 'props.context': workspaceId }"
        }
      ]
    },
    {
      "id": "b-280",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-281",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "edges: {}"
        }
      ]
    },
    {
      "id": "b-282",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-283",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const blocks = data.nodes;"
        }
      ]
    },
    {
      "id": "b-284",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const edges = data.edges;"
        }
      ]
    },
    {
      "id": "b-285",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "for (const block of blocks) {"
        }
      ]
    },
    {
      "id": "b-286",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Check connected blocks for conflicts"
        }
      ]
    },
    {
      "id": "b-287",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const related = edges"
        }
      ]
    },
    {
      "id": "b-288",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ".filter(e => e.from === block['@id'] || e.to === block['@id'])"
        }
      ]
    },
    {
      "id": "b-289",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ".map(e => e.from === block['@id'] ? e.to : e.from);"
        }
      ]
    },
    {
      "id": "b-290",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const conflicts = await aiAgent.detectConflicts(block, related);"
        }
      ]
    },
    {
      "id": "b-291",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (conflicts.length > 0) {"
        }
      ]
    },
    {
      "id": "b-292",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "graphTransactions.createEvent({"
        }
      ]
    },
    {
      "id": "b-293",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'@id': generateId('event', 'conflict'),"
        }
      ]
    },
    {
      "id": "b-294",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'@type': ['Event', 'ConflictDetected'],"
        }
      ]
    },
    {
      "id": "b-295",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subject: 'urn:app:node:agent:monitor',"
        }
      ]
    },
    {
      "id": "b-296",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "context: workspaceId,"
        }
      ]
    },
    {
      "id": "b-297",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "kind: 'conflict',"
        }
      ]
    },
    {
      "id": "b-298",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "data: { conflicts }"
        }
      ]
    },
    {
      "id": "b-299",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-300",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-301",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-302",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-303",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Agent 3: Suggests connections"
        }
      ]
    },
    {
      "id": "b-304",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async function suggestRelationships(workspaceId) {"
        }
      ]
    },
    {
      "id": "b-305",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { data } = await db.queryOnce({"
        }
      ]
    },
    {
      "id": "b-306",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "nodes: { where: { '@type': { $contains: 'Block' }, 'props.context': workspaceId } }"
        }
      ]
    },
    {
      "id": "b-307",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-308",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const suggestions = await aiAgent.suggestEdges(data.nodes);"
        }
      ]
    },
    {
      "id": "b-309",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return suggestions.map(s => ({"
        }
      ]
    },
    {
      "id": "b-310",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "from: s.blockA,"
        }
      ]
    },
    {
      "id": "b-311",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "to: s.blockB,"
        }
      ]
    },
    {
      "id": "b-312",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pred: s.relationship,"
        }
      ]
    },
    {
      "id": "b-313",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "confidence: s.score"
        }
      ]
    },
    {
      "id": "b-314",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}));"
        }
      ]
    },
    {
      "id": "b-315",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-316",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-317",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-318",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Part 2: What Makes This Special vs. Notion/Figma"
        }
      ]
    },
    {
      "id": "b-319",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Notion"
        }
      ]
    },
    {
      "id": "b-323",
      "type": "bulletList",
      "children": [
        {
          "id": "b-320",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Blocks can reference each other (database relations)"
            }
          ]
        },
        {
          "id": "b-321",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "But the graph is implicit, not queryable"
            }
          ]
        },
        {
          "id": "b-322",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "You can't ask \"What blocks influence this one?\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-324",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Figma"
        }
      ]
    },
    {
      "id": "b-328",
      "type": "bulletList",
      "children": [
        {
          "id": "b-325",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Objects on canvas have spatial relationships"
            }
          ]
        },
        {
          "id": "b-326",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "But no semantic relationships between artboards"
            }
          ]
        },
        {
          "id": "b-327",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "No way to track \"why\" we designed it this way"
            }
          ]
        }
      ]
    },
    {
      "id": "b-329",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Your System"
        }
      ]
    },
    {
      "id": "b-334",
      "type": "bulletList",
      "children": [
        {
          "id": "b-330",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Explicit graph**: Relationships are first-class"
            }
          ]
        },
        {
          "id": "b-331",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Queryable**: Ask questions about the workspace structure"
            }
          ]
        },
        {
          "id": "b-332",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Auditable**: Every change is an event"
            }
          ]
        },
        {
          "id": "b-333",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Agent-native**: Agents understand the whole workspace, not isolated blocks"
            }
          ]
        }
      ]
    },
    {
      "id": "b-335",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-336",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Notion vs Your System:"
        }
      ]
    },
    {
      "id": "b-337",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "┌──────────────────┐"
        }
      ]
    },
    {
      "id": "b-338",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "│  Notion Database │ (Relational)"
        }
      ]
    },
    {
      "id": "b-339",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "│  ├─ Tasks        │"
        }
      ]
    },
    {
      "id": "b-340",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "│  ├─ Status       │"
        }
      ]
    },
    {
      "id": "b-341",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "│  └─ Assignee     │"
        }
      ]
    },
    {
      "id": "b-342",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "└──────────────────┘"
        }
      ]
    },
    {
      "id": "b-343",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Can query, but relationships are *data*."
