    },
    {
      "id": "b-358",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-359",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Part 3: Specific Capabilities You Get"
        }
      ]
    },
    {
      "id": "b-360",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "1. **Dependency Queries**"
        }
      ]
    },
    {
      "id": "b-361",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-362",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// What would break if I delete this database?"
        }
      ]
    },
    {
      "id": "b-363",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "function findDependents(nodeId) {"
        }
      ]
    },
    {
      "id": "b-364",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { data } = db.useQuery({"
        }
      ]
    },
    {
      "id": "b-365",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "edges: { where: { to: nodeId, pred: 'uses' } }"
        }
      ]
    },
    {
      "id": "b-366",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-367",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return data.edges.map(e => e.from);"
        }
      ]
    },
    {
      "id": "b-368",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-369",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// What does this canvas depend on?"
        }
      ]
    },
    {
      "id": "b-370",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "function findDependencies(nodeId) {"
        }
      ]
    },
    {
      "id": "b-371",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { data } = db.useQuery({"
        }
      ]
    },
    {
      "id": "b-372",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "edges: { where: { from: nodeId } }"
        }
      ]
    },
    {
      "id": "b-373",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-374",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return data.edges.map(e => e.to);"
        }
      ]
    },
    {
      "id": "b-375",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-376",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Transitive: If I break this data source, what breaks?"
        }
      ]
    },
    {
      "id": "b-377",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "function findTransitiveDependents(nodeId, depth = 5) {"
        }
      ]
    },
    {
      "id": "b-378",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "let current = [nodeId];"
        }
      ]
    },
    {
      "id": "b-379",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const visited = new Set();"
        }
      ]
    },
    {
      "id": "b-380",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "for (let i = 0; i < depth; i++) {"
        }
      ]
    },
    {
      "id": "b-381",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const next = [];"
        }
      ]
    },
    {
      "id": "b-382",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "for (const id of current) {"
        }
      ]
    },
    {
      "id": "b-383",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { data } = db.useQuery({"
        }
      ]
    },
    {
      "id": "b-384",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "edges: { where: { to: id, pred: 'uses' } }"
        }
      ]
    },
    {
      "id": "b-385",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-386",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "data.edges.forEach(e => {"
        }
      ]
    },
    {
      "id": "b-387",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!visited.has(e.from)) {"
        }
      ]
    },
    {
      "id": "b-388",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "next.push(e.from);"
        }
      ]
    },
    {
      "id": "b-389",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "visited.add(e.from);"
        }
      ]
    },
    {
      "id": "b-390",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-391",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-392",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-393",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "current = next;"
        }
      ]
    },
    {
      "id": "b-394",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-395",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return visited;"
        }
      ]
    },
    {
      "id": "b-396",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-397",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
