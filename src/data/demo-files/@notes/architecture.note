      "id": "b-202",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-203",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const miniApp = {"
        }
      ]
    },
    {
      "id": "b-204",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'@id': 'urn:app:node:block:sprint-board',"
