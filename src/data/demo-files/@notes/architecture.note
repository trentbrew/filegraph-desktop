              "text": "You can replay history: \"Show me the last 10 edits to this workspace\""
            }
          ]
        },
        {
          "id": "b-157",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Collaboration: See who changed what when"
            }
          ]
        }
      ]
    },
    {
      "id": "b-159",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "4. **Spatial Queries Become Graph Queries**"
        }
      ]
    },
    {
      "id": "b-160",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"What blocks are near this one?\" becomes:"
        }
      ]
    },
    {
      "id": "b-161",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-162",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "function findNearbyBlocks(workspaceId, blockId, radius = 300) {"
        }
      ]
    },
    {
      "id": "b-163",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { data } = db.useQuery({"
        }
      ]
    },
    {
      "id": "b-164",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "nodes: {"
        }
      ]
    },
    {
      "id": "b-165",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "where: {"
        }
      ]
    },
    {
      "id": "b-166",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'@type': { $contains: 'Block' },"
        }
      ]
    },
    {
      "id": "b-167",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'props.context': workspaceId"
        }
      ]
    },
    {
      "id": "b-168",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-169",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-170",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-171",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const block = data.nodes.find(n => n['@id'] === blockId);"
        }
      ]
    },
    {
      "id": "b-172",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { x, y } = block.props.pos;"
        }
      ]
    },
    {
      "id": "b-173",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return data.nodes.filter(n => {"
        }
      ]
    },
    {
      "id": "b-174",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { x: nx, y: ny } = n.props.pos;"
        }
      ]
    },
    {
      "id": "b-175",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const dist = Math.sqrt((x - nx) ** 2 + (y - ny) ** 2);"
        }
      ]
    },
    {
      "id": "b-176",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return dist < radius && n['@id'] !== blockId;"
        }
      ]
    },
    {
      "id": "b-177",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-178",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-179",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Or query by relationship"
        }
      ]
    },
    {
      "id": "b-180",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "function findRelatedBlocks(blockId) {"
        }
      ]
    },
    {
      "id": "b-181",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { data } = db.useQuery({"
        }
      ]
    },
    {
      "id": "b-182",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "edges: {"
        }
      ]
    },
    {
      "id": "b-183",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "where: {"
        }
      ]
    },
    {
      "id": "b-184",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "$or: ["
        }
      ]
    },
    {
      "id": "b-185",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ from: blockId },"
        }
      ]
    },
    {
      "id": "b-186",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ to: blockId }"
        }
      ]
    },
    {
      "id": "b-187",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "]"
        }
      ]
    },
    {
      "id": "b-188",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-189",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-190",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-191",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return data.edges.map(e => e.from === blockId ? e.to : e.from);"
        }
      ]
    },
    {
      "id": "b-192",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-193",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-194",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**What you get:**"
        }
