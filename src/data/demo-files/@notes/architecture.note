        },
        {
          "id": "b-198",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Agent: \"Which blocks conflict?\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-200",
      "type": "heading",
      "level": 3,
      "content": [
