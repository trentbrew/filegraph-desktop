          "type": "text",
          "text": "├── queries.md"
        }
      ]
    },
    {
      "id": "b-201",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "└── workflows/"
        }
      ]
    },
    {
      "id": "b-202",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── daily-standup.md"
        }
      ]
    },
    {
      "id": "b-203",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── pr-review.md"
        }
      ]
    },
    {
      "id": "b-204",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "└── sprint-planning.md"
        }
      ]
    },
    {
      "id": "b-205",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Add to filegraph init command:"
        }
      ]
    },
    {
      "id": "b-206",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// src/cli-extensions/init.ts"
        }
      ]
    },
    {
      "id": "b-207",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async function scaffoldPrompts(projectPath: string) {"
        }
      ]
    },
    {
      "id": "b-208",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const promptsDir = `${projectPath}/.filegraph/prompts`;"
        }
      ]
    },
    {
      "id": "b-209",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await mkdir(`${promptsDir}/workflows`, { recursive: true });"
        }
      ]
    },
    {
      "id": "b-210",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Copy templates from filegraph package"
        }
      ]
    },
    {
      "id": "b-211",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await copyFile("
        }
      ]
    },
    {
      "id": "b-212",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "resolve(__dirname, '../templates/prompts/_index.md'),"
        }
      ]
    },
    {
      "id": "b-213",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "`${promptsDir}/_index.md`"
        }
      ]
    },
    {
      "id": "b-214",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ");"
        }
      ]
    },
    {
      "id": "b-215",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await copyFile("
        }
      ]
    },
    {
      "id": "b-216",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "resolve(__dirname, '../templates/prompts/task-management.md'),"
        }
      ]
    },
    {
      "id": "b-217",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "`${promptsDir}/task-management.md`"
        }
      ]
    },
    {
      "id": "b-218",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ");"
        }
      ]
    },
    {
      "id": "b-219",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// etc."
        }
      ]
    },
