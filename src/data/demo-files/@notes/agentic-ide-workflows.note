          "text": "Community Workflows (GitHub repo)"
        }
      ]
    },
    {
      "id": "b-240",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "github.com/trenuser/filegraph-workflows/"
        }
      ]
    },
    {
      "id": "b-241",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "workflows/"
        }
      ]
    },
    {
      "id": "b-242",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── ci-cd-setup.md"
        }
      ]
    },
    {
      "id": "b-243",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── bug-triage.md"
        }
      ]
    },
    {
      "id": "b-244",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── feature-planning.md"
        }
      ]
    },
    {
      "id": "b-245",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "└── retrospective.md"
        }
      ]
    },
    {
      "id": "b-246",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Users can install:"
        }
      ]
    },
    {
      "id": "b-247",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph workflows browse"
        }
      ]
    },
    {
      "id": "b-248",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph workflows install ci-cd-setup"
        }
      ]
    },
    {
      "id": "b-249",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph workflows publish my-workflow.md"
        }
      ]
    },
    {
      "id": "b-250",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "IDE-Specific Sharing"
        }
      ]
    },
    {
      "id": "b-251",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Cursor:"
        }
      ]
    },
    {
      "id": "b-252",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "curl [https://filegraph.dev/workflows/pr-review.cursorrules](https://filegraph.dev/workflows/pr-review.cursorrules) >> .cursorrules"
        }
      ]
    },
    {
      "id": "b-253",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Windsurf:"
        }
      ]
    },
    {
      "id": "b-254",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph workflows install --ide windsurf pr-review"
        }
      ]
    },
    {
      "id": "b-255",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The VSCode Extension Design"
        }
      ]
    },
    {
      "id": "b-256",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Since you asked about the chat interface:"
        }
      ]
    },
    {
      "id": "b-257",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Don't Build a Chat Interface"
        }
      ]
    },
    {
      "id": "b-258",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Use the IDE's native chat. Instead, provide:"
        }
      ]
    },
    {
      "id": "b-259",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. Context Provider"
        }
      ]
    },
    {
      "id": "b-260",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// When agent asks about tasks, automatically include:"
        }
      ]
    },
    {
      "id": "b-261",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "vscode.chat.registerProvider({"
        }
      ]
    },
    {
      "id": "b-262",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: 'filegraph',"
        }
      ]
    },
    {
      "id": "b-263",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "provideContext: async () => {"
        }
      ]
    },
    {
      "id": "b-264",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const tasks = await exec('filegraph tasks --format json');"
        }
      ]
    },
    {
      "id": "b-265",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return {"
        }
      ]
    },
    {
      "id": "b-266",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "content: `Current tasks:\\n${tasks}`,"
        }
      ]
    },
    {
      "id": "b-267",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata: { source: 'filegraph' }"
        }
      ]
    },
    {
      "id": "b-268",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-269",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-270",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-271",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "2. Quick Actions"
        }
      ]
    },
    {
      "id": "b-272",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Add buttons to chat interface"
        }
      ]
    },
    {
      "id": "b-273",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "vscode.chat.registerAction({"
        }
      ]
    },
    {
      "id": "b-274",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: 'filegraph.create-task',"
        }
      ]
    },
    {
      "id": "b-275",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title: 'Create Task from Chat',"
        }
      ]
    },
    {
      "id": "b-276",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "handler: async (message) => {"
        }
      ]
    },
    {
      "id": "b-277",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Parse task details from message"
        }
      ]
    },
    {
      "id": "b-278",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await exec(`filegraph create task \"${title}\" --priority high`);"
        }
      ]
    },
    {
      "id": "b-279",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-280",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-281",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "3. Inline Suggestions"
        }
      ]
    },
    {
      "id": "b-282",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// When agent mentions a task, show:"
        }
      ]
    },
    {
      "id": "b-283",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// [View in Graph] [Update Status] [Add Note]"
        }
      ]
    },
    {
      "id": "b-284",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Summary: The Stack"
        }
