          "type": "text",
          "text": "Optional @filegraph/mcp-server package"
        }
      ]
    },
    {
      "id": "b-228",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "For Claude Code power users"
        }
      ]
    },
    {
      "id": "b-229",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Document in README: \"Optional: Install MCP server for enhanced agent integration\""
        }
      ]
    },
    {
      "id": "b-230",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Workflow Sharing Strategy"
        }
      ]
    },
    {
      "id": "b-231",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Problem: How do users share/discover workflows?"
        }
      ]
    },
    {
      "id": "b-232",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Built-in Workflows (Shipped with filegraph)"
        }
      ]
    },
    {
      "id": "b-233",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph init  # Copies default workflows"
        }
      ]
    },
    {
      "id": "b-234",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ".filegraph/workflows/"
        }
      ]
    },
    {
      "id": "b-235",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── daily-standup.md"
        }
      ]
    },
    {
      "id": "b-236",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── pr-review.md"
        }
      ]
    },
    {
      "id": "b-237",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── sprint-planning.md"
        }
      ]
    },
    {
      "id": "b-238",
      "type": "paragraph",
      "content": [
