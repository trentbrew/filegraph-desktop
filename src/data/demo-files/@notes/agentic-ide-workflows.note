    },
    {
      "id": "b-186",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Why:"
        }
      ]
    },
    {
      "id": "b-187",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Universal - Works in Cursor, Windsurf, Claude Code, Cline, Continue"
        }
      ]
    },
    {
      "id": "b-188",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Simple - No installation, no config, no server"
        }
      ]
    },
    {
      "id": "b-189",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Self-documenting - Humans can read the same files"
        }
      ]
    },
    {
      "id": "b-190",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Easy to share - Copy .filegraph/prompts/ to another project"
        }
      ]
    },
    {
      "id": "b-191",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Version controlled - Lives in git with your project"
        }
      ]
    },
    {
      "id": "b-192",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Testable - You can verify instructions work by following them manually"
        }
      ]
    },
    {
      "id": "b-193",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Concrete Plan:"
        }
      ]
    },
    {
      "id": "b-194",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Phase 1: Markdown Prompts (This Week)"
        }
      ]
    },
    {
      "id": "b-195",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph init  # Creates .filegraph/prompts/ with templates"
        }
      ]
    },
    {
      "id": "b-196",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ".filegraph/prompts/"
        }
      ]
    },
    {
      "id": "b-197",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── _index.md              # \"Here's what filegraph can do\""
        }
      ]
    },
    {
      "id": "b-198",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── task-management.md     # Complete guide"
        }
      ]
    },
    {
      "id": "b-199",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "├── note-taking.md"
        }
      ]
    },
    {
      "id": "b-200",
      "type": "paragraph",
      "content": [
