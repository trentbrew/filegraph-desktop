          "type": "text",
          "text": "npm install -g filegraph"
        }
      ]
    },
    {
      "id": "b-268",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "npx filegraph init"
        }
      ]
    },
    {
      "id": "b-269",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "cd my-project"
        }
      ]
    },
    {
      "id": "b-270",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph init"
