    },
    {
      "id": "b-315",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Import/Export**"
        }
      ]
    },
    {
      "id": "b-316",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```bash"
        }
      ]
    },
    {
      "id": "b-317",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph import github-issues --repo owner/repo"
        }
      ]
    },
    {
      "id": "b-318",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph import linear --team ENG"
        }
      ]
    },
    {
      "id": "b-319",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph import jira --project PROJ"
