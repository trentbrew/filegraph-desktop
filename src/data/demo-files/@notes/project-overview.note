          "text": "#!/bin/bash"
        }
      ]
    },
    {
      "id": "b-627",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph validate || exit 1"
        }
      ]
    },
    {
      "id": "b-628",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "#!/bin/bash"
        }
      ]
    },
    {
      "id": "b-629",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph link file:$(git diff-tree --no-commit-id --name-only -r HEAD) \\"
        }
      ]
    },
    {
      "id": "b-630",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--to-commit $(git rev-parse HEAD)"
        }
      ]
    },
    {
      "id": "b-631",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
