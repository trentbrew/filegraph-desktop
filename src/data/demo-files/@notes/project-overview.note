      ]
    },
    {
      "id": "b-648",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph analyze velocity --period sprint"
        }
      ]
    },
    {
      "id": "b-649",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph analyze bottlenecks"
