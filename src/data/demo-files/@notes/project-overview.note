      ]
    },
    {
      "id": "b-271",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph init --global"
        }
      ]
    },
    {
      "id": "b-272",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
