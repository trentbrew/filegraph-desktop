    {
      "id": "b-273",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Core Commands"
        }
      ]
    },
    {
      "id": "b-274",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Query Operations**"
        }
      ]
    },
    {
      "id": "b-275",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```bash"
        }
      ]
    },
    {
      "id": "b-276",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph query \"FIND task AS ?t WHERE ?t.status = 'blocked' RETURN ?t\""
        }
      ]
    },
    {
      "id": "b-277",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph query \"show me all high priority tasks assigned to alice\" --nl"
        }
      ]
    },
    {
      "id": "b-278",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph tasks --status in-progress --assignee @me"
        }
      ]
    },
    {
      "id": "b-279",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph notes --tag architecture"
        }
      ]
    },
    {
      "id": "b-280",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-281",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**CRUD Operations**"
        }
      ]
    },
    {
      "id": "b-282",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```bash"
        }
      ]
    },
    {
      "id": "b-283",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph create task \\"
        }
      ]
    },
    {
      "id": "b-284",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--title \"Fix authentication bug\" \\"
        }
      ]
    },
    {
      "id": "b-285",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--assignee @alice \\"
        }
      ]
    },
    {
      "id": "b-286",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--priority high \\"
        }
      ]
    },
    {
      "id": "b-287",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--tags auth,bug"
        }
      ]
    },
    {
      "id": "b-288",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph create note \\"
        }
      ]
    },
    {
      "id": "b-289",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--title \"Architecture Decision: Use PostgreSQL\" \\"
        }
      ]
    },
    {
      "id": "b-290",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--type decision \\"
        }
      ]
    },
    {
      "id": "b-291",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--content \"$(cat decision.md)\""
        }
      ]
    },
    {
      "id": "b-292",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph update task:auth-123 \\"
        }
      ]
    },
    {
      "id": "b-293",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--status in-progress \\"
        }
      ]
    },
    {
      "id": "b-294",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "--actual-hours 4"
        }
      ]
    },
    {
      "id": "b-295",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph delete task:auth-123"
        }
      ]
    },
    {
      "id": "b-296",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph link task:auth-123 --to task:db-456 --relation dependsOn"
        }
      ]
    },
    {
      "id": "b-297",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph link task:auth-123 --to file:src/auth.ts --relation implements"
        }
      ]
    },
    {
      "id": "b-298",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
