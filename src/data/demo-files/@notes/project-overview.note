          "text": "Agent Integration"
        }
      ]
    },
    {
      "id": "b-425",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Agent Guidance Documents"
        }
      ]
    },
    {
      "id": "b-426",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Located in `.filegraph/prompts/`, these teach AI agents how to use the system:"
        }
      ]
    },
    {
      "id": "b-427",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**task-management.md**"
        }
      ]
    },
    {
      "id": "b-428",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```markdown"
        }
      ]
    },
    {
      "id": "b-429",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Available Commands"
        }
      ]
    },
    {
      "id": "b-430",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Query tasks:"
        }
      ]
    },
    {
      "id": "b-433",
      "type": "bulletList",
      "children": [
        {
          "id": "b-431",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`filegraph query \"FIND task WHERE ?t.assignee = @me\"`"
            }
          ]
        },
        {
          "id": "b-432",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`filegraph tasks --status blocked`"
            }
          ]
        }
      ]
    },
    {
      "id": "b-434",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Create tasks:"
        }
      ]
    },
    {
      "id": "b-436",
      "type": "bulletList",
      "children": [
        {
          "id": "b-435",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`filegraph create task --title \"...\" --assignee @user`"
            }
          ]
        }
      ]
    },
    {
      "id": "b-437",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Update progress:"
        }
      ]
    },
    {
      "id": "b-440",
      "type": "bulletList",
      "children": [
        {
          "id": "b-438",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`filegraph update task:123 --status in-progress`"
            }
          ]
        },
        {
          "id": "b-439",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`filegraph update task:123 --actual-hours 2`"
            }
          ]
        }
      ]
    },
    {
      "id": "b-441",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Link to code:"
        }
      ]
    },
    {
      "id": "b-443",
      "type": "bulletList",
      "children": [
        {
          "id": "b-442",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`filegraph link task:123 --to file:src/feature.ts`"
            }
          ]
        }
      ]
    },
    {
      "id": "b-444",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Workflow Examples"
        }
      ]
    },
    {
      "id": "b-445",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "When starting work:"
        }
      ]
    },
    {
      "id": "b-446",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. Query your assigned tasks"
        }
      ]
    },
    {
      "id": "b-447",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "2. Update status to in-progress"
        }
      ]
    },
    {
      "id": "b-448",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "3. Link to relevant files"
        }
      ]
    },
    {
      "id": "b-449",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "When blocked:"
        }
      ]
    },
    {
      "id": "b-450",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "1. Update status to blocked"
        }
      ]
    },
    {
      "id": "b-451",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "2. Create note explaining blocker"
        }
      ]
    },
    {
      "id": "b-452",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "3. Link blocker to related task"
        }
      ]
    },
    {
      "id": "b-453",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-454",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Workflow Templates"
        }
      ]
    },
    {
      "id": "b-455",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**daily-standup.workflow.json**"
        }
      ]
    },
    {
      "id": "b-456",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```json"
        }
      ]
    },
    {
      "id": "b-457",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-458",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"name\": \"daily-standup\","
        }
      ]
    },
    {
      "id": "b-459",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"description\": \"Generate standup report\","
        }
      ]
    },
    {
      "id": "b-460",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"nodes\": {"
        }
      ]
    },
    {
      "id": "b-461",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"gather_tasks\": {"
        }
      ]
    },
    {
      "id": "b-462",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"type\": \"query\","
        }
      ]
    },
    {
      "id": "b-463",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"query\": \"FIND task WHERE ?t.assignee = @me AND ?t.updatedAt > today-1d\""
        }
      ]
    },
    {
      "id": "b-464",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-465",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"summarize\": {"
        }
      ]
    },
    {
      "id": "b-466",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"type\": \"ai\","
        }
      ]
    },
    {
      "id": "b-467",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"prompt\": \"Summarize progress on these tasks for standup\","
        }
      ]
    },
    {
      "id": "b-468",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"input\": \"$gather_tasks.results\""
        }
      ]
    },
    {
      "id": "b-469",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-470",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"format\": {"
        }
      ]
    },
    {
      "id": "b-471",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"type\": \"template\","
        }
      ]
    },
    {
      "id": "b-472",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"template\": \"standup.md\","
        }
      ]
    },
    {
      "id": "b-473",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"data\": \"$summarize.output\""
        }
      ]
    },
    {
      "id": "b-474",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-475",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-476",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"edges\": ["
        }
      ]
    },
    {
      "id": "b-477",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "[\"gather_tasks\", \"summarize\"],"
        }
      ]
    },
    {
      "id": "b-478",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "[\"summarize\", \"format\"]"
        }
      ]
    },
    {
      "id": "b-479",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "]"
        }
      ]
    },
    {
      "id": "b-480",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-481",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-482",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Agent API"
        }
      ]
    },
    {
      "id": "b-483",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agents can import `.filegraph` as a library:"
        }
      ]
    },
    {
      "id": "b-484",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-485",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { Filegraph } from 'filegraph';"
        }
      ]
    },
    {
      "id": "b-486",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const hq = new Filegraph(process.cwd());"
        }
      ]
    },
    {
      "id": "b-487",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Query"
        }
      ]
    },
    {
      "id": "b-488",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const blockedTasks = await hq.query(`"
        }
      ]
    },
    {
      "id": "b-489",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task AS ?t"
        }
      ]
    },
    {
      "id": "b-490",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "WHERE ?t.status = 'blocked'"
        }
      ]
    },
    {
      "id": "b-491",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RETURN ?t"
        }
      ]
    },
    {
      "id": "b-492",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "`);"
        }
      ]
    },
    {
      "id": "b-493",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Create"
        }
      ]
    },
    {
      "id": "b-494",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await hq.create('task', {"
        }
      ]
    },
    {
      "id": "b-495",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title: 'Fix bug in authentication',"
        }
      ]
    },
    {
      "id": "b-496",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "assignee: 'person:alice',"
        }
      ]
    },
    {
      "id": "b-497",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "priority: 'high'"
        }
      ]
    },
    {
      "id": "b-498",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-499",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Natural language"
        }
      ]
    },
    {
      "id": "b-500",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const results = await hq.queryNL('show me all overdue high priority tasks');"
        }
      ]
    },
    {
      "id": "b-501",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Run workflow"
        }
      ]
    },
    {
      "id": "b-502",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await hq.workflow('pr-review', { prNumber: 123 });"
        }
      ]
    },
    {
      "id": "b-503",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-504",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-505",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Query Language (EQL-S)"
        }
      ]
    },
    {
      "id": "b-506",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Powered by TQL's Datalog engine:"
        }
      ]
    },
    {
      "id": "b-507",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Basic Queries"
        }
      ]
    },
    {
      "id": "b-508",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```sql"
        }
      ]
    },
    {
      "id": "b-509",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "-- Find all tasks"
        }
      ]
    },
    {
      "id": "b-510",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task AS ?t RETURN ?t"
        }
      ]
    },
    {
      "id": "b-511",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "-- Filter by status"
        }
      ]
    },
    {
      "id": "b-512",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task AS ?t"
        }
      ]
    },
    {
      "id": "b-513",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "WHERE ?t.status = 'blocked'"
        }
      ]
    },
    {
      "id": "b-514",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RETURN ?t.title, ?t.assignee"
        }
      ]
    },
    {
      "id": "b-515",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "-- Join relationships"
        }
      ]
    },
    {
      "id": "b-516",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task AS ?t"
        }
      ]
    },
    {
      "id": "b-517",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "WHERE ?t.assignee = ?p AND ?p.name = 'Alice'"
        }
      ]
    },
    {
      "id": "b-518",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RETURN ?t"
        }
      ]
    },
    {
      "id": "b-519",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "-- Regex matching"
        }
      ]
    },
    {
      "id": "b-520",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task AS ?t"
        }
      ]
    },
    {
      "id": "b-521",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "WHERE ?t.title =~ /auth/i"
        }
      ]
    },
    {
      "id": "b-522",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RETURN ?t"
        }
      ]
    },
    {
      "id": "b-523",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-524",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Advanced Queries"
        }
      ]
    },
    {
      "id": "b-525",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```sql"
        }
      ]
    },
    {
      "id": "b-526",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "-- Recursive dependencies"
        }
      ]
    },
    {
      "id": "b-527",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task AS ?t"
        }
      ]
    },
    {
      "id": "b-528",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "WHERE ?t.id = 'task:auth-123'"
        }
      ]
    },
    {
      "id": "b-529",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AND ?t.dependsOn* = ?dep  -- Transitive closure"
        }
      ]
    },
    {
      "id": "b-530",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RETURN ?dep"
        }
      ]
    },
    {
      "id": "b-531",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "-- Aggregations"
        }
      ]
    },
    {
      "id": "b-532",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task AS ?t"
        }
      ]
    },
    {
      "id": "b-533",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "WHERE ?t.milestone = 'sprint-12'"
        }
      ]
    },
    {
      "id": "b-534",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "GROUP BY ?t.status"
        }
      ]
    },
    {
      "id": "b-535",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RETURN ?t.status, COUNT(?t) AS count"
        }
      ]
    },
    {
      "id": "b-536",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "-- Date operations"
        }
      ]
    },
    {
      "id": "b-537",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task AS ?t"
        }
      ]
    },
    {
      "id": "b-538",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "WHERE ?t.dueDate < today"
        }
      ]
    },
    {
      "id": "b-539",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AND ?t.status != 'done'"
        }
      ]
    },
    {
      "id": "b-540",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "RETURN ?t"
        }
      ]
    },
    {
      "id": "b-541",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "ORDER BY ?t.priority DESC"
        }
      ]
    },
    {
      "id": "b-542",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-543",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Natural Language"
        }
      ]
    },
    {
      "id": "b-544",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```bash"
        }
      ]
    },
    {
      "id": "b-545",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph query \"what tasks are blocking the auth feature\" --nl"
        }
      ]
    },
    {
      "id": "b-546",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph query \"show me alice's tasks this week\" --nl"
        }
      ]
    },
    {
      "id": "b-547",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph query \"find all overdue critical bugs\" --nl"
        }
      ]
    },
    {
      "id": "b-548",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-549",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-550",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Views & Visualization"
        }
      ]
    },
    {
      "id": "b-551",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "View Configuration"
        }
      ]
    },
    {
      "id": "b-552",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```json"
        }
      ]
    },
    {
      "id": "b-553",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-554",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"name\": \"sprint-kanban\","
        }
      ]
    },
    {
      "id": "b-555",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"type\": \"kanban\","
        }
      ]
    },
    {
      "id": "b-556",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"entityType\": \"task\","
        }
      ]
    },
    {
      "id": "b-557",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"filters\": {"
        }
      ]
    },
    {
      "id": "b-558",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"milestone\": \"sprint-12\""
        }
      ]
    },
    {
      "id": "b-559",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-560",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"groupBy\": \"status\","
        }
      ]
    },
    {
      "id": "b-561",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"sortBy\": \"priority\","
        }
      ]
    },
    {
      "id": "b-562",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"columns\": ["
        }
      ]
    },
    {
      "id": "b-563",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ \"id\": \"todo\", \"title\": \"To Do\", \"limit\": 5 },"
        }
      ]
    },
    {
      "id": "b-564",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ \"id\": \"in-progress\", \"title\": \"In Progress\", \"limit\": 3 },"
        }
      ]
    },
    {
      "id": "b-565",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ \"id\": \"review\", \"title\": \"Review\" },"
        }
      ]
    },
    {
      "id": "b-566",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ \"id\": \"done\", \"title\": \"Done\" }"
        }
      ]
    },
    {
      "id": "b-567",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-568",
      "type": "paragraph",
      "content": [
