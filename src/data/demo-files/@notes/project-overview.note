          "type": "text",
          "text": "filegraph export --format json > backup.json"
        }
      ]
    },
    {
      "id": "b-321",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph export --format csv --entity tasks > tasks.csv"
        }
      ]
    },
    {
      "id": "b-322",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph export --format markdown --entity notes > notes.md"
        }
      ]
    },
    {
      "id": "b-323",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
