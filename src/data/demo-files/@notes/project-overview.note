    },
    {
      "id": "b-645",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Analytics & Insights"
        }
      ]
    },
    {
      "id": "b-646",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Built-in Analytics"
        }
      ]
    },
    {
      "id": "b-647",
      "type": "paragraph",
      "content": [
