      ]
    },
    {
      "id": "b-651",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "filegraph analyze dependencies --critical-path"
        }
      ]
    },
    {
      "id": "b-652",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-653",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Custom Reports"
        }
      ]
    },
    {
      "id": "b-654",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-655",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// .filegraph/reports/sprint-report.ts"
        }
      ]
    },
    {
      "id": "b-656",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export default async function sprintReport(hq: Filegraph, milestone: string) {"
        }
      ]
    },
    {
      "id": "b-657",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const tasks = await hq.query(`"
        }
      ]
    },
    {
      "id": "b-658",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "FIND task WHERE ?t.milestone = '${milestone}'"
        }
      ]
    },
    {
      "id": "b-659",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "`);"
        }
      ]
    },
    {
      "id": "b-660",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const completed = tasks.filter(t => t.status === 'done');"
        }
      ]
    },
    {
      "id": "b-661",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const velocity = completed.reduce((sum, t) => sum + t.estimatedHours, 0);"
        }
      ]
    },
    {
      "id": "b-662",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return {"
        }
      ]
    },
    {
      "id": "b-663",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "totalTasks: tasks.length,"
        }
      ]
    },
    {
      "id": "b-664",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "completed: completed.length,"
        }
      ]
    },
    {
      "id": "b-665",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "velocity,"
        }
      ]
    },
    {
      "id": "b-666",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "burndown: calculateBurndown(tasks)"
        }
      ]
    },
    {
      "id": "b-667",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-668",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-669",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-670",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
