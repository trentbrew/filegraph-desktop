      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "> - Hospital system (wants auditable medical AI)"
        }
      ]
    },
    {
      "id": "b-213",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "> - Law firm (wants provable AI research)"
