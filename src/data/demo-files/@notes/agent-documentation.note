    {
      "id": "b-191",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Service Breakdown"
        }
      ]
    },
    {
      "id": "b-192",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "1. Agent Service"
        }
      ]
    },
    {
      "id": "b-193",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Component | Description |"
        }
      ]
    },
    {
      "id": "b-194",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| --- | --- |"
        }
      ]
    },
    {
      "id": "b-195",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Context Management | Handles different agent roles and capabilities |"
        }
      ]
    },
    {
      "id": "b-196",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Message Processing | Routes messages to appropriate handlers |"
        }
      ]
    },
    {
      "id": "b-197",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Tool Orchestration | Manages tool selection and execution |"
        }
      ]
    },
    {
      "id": "b-198",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| State Tracking | Maintains conversation and execution state |"
        }
      ]
    },
    {
      "id": "b-199",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Graph Integration | Stores interactions and knowledge in graph |"
        }
      ]
    },
    {
      "id": "b-200",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "2. AI Service"
        }
      ]
    },
    {
      "id": "b-201",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Component | Description |"
        }
      ]
    },
    {
      "id": "b-202",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| --- | --- |"
        }
      ]
    },
    {
      "id": "b-203",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Model Management | Handles different AI model providers |"
        }
      ]
    },
    {
      "id": "b-204",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Context Building | Constructs prompts with context and history |"
        }
      ]
    },
    {
      "id": "b-205",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Safety Settings | Manages model safety and restrictions |"
        }
      ]
    },
    {
      "id": "b-206",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Error Handling | Provides fallbacks and retries |"
        }
      ]
    },
    {
      "id": "b-207",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Response Processing | Extracts structured data from responses |"
        }
      ]
    },
    {
      "id": "b-208",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "3. Tool Service"
        }
      ]
    },
    {
      "id": "b-209",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Component | Description |"
        }
      ]
    },
    {
      "id": "b-210",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| --- | --- |"
        }
      ]
    },
    {
      "id": "b-211",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Tool Registry | Maintains available tools and capabilities |"
        }
      ]
    },
    {
      "id": "b-212",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Permission Management | Controls tool access and restrictions |"
        }
      ]
    },
    {
      "id": "b-213",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Execution Engine | Runs tools and handles results |"
        }
      ]
    },
    {
      "id": "b-214",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Error Recovery | Manages failures and retries |"
        }
      ]
    },
    {
      "id": "b-215",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| Result Processing | Formats tool outputs for agents |"
        }
      ]
    },
    {
      "id": "b-216",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Data Flow"
        }
      ]
    },
    {
      "id": "b-217",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```mermaid"
        }
      ]
    },
    {
      "id": "b-218",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sequenceDiagram"
        }
      ]
    },
    {
      "id": "b-219",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant User"
        }
      ]
    },
    {
      "id": "b-220",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant UI"
        }
      ]
    },
    {
      "id": "b-221",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Store"
        }
      ]
    },
    {
      "id": "b-222",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant API"
        }
      ]
    },
    {
      "id": "b-223",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Agent"
        }
      ]
    },
    {
      "id": "b-224",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant AI"
        }
      ]
    },
    {
      "id": "b-225",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Tools"
        }
      ]
    },
    {
      "id": "b-226",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Graph"
        }
      ]
    },
    {
      "id": "b-227",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "User->>UI: Send Message"
        }
      ]
    },
    {
      "id": "b-228",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "UI->>Store: Update State"
        }
      ]
    },
    {
      "id": "b-229",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Store->>API: Send Request"
        }
      ]
    },
    {
      "id": "b-230",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "API->>Agent: Process Message"
        }
      ]
    },
    {
      "id": "b-231",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agent->>Graph: Store Message"
        }
      ]
    },
    {
      "id": "b-232",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agent->>AI: Generate Response"
        }
      ]
    },
    {
      "id": "b-233",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AI-->>Agent: Response"
        }
      ]
    },
    {
      "id": "b-234",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agent->>Tools: Execute Tools"
        }
      ]
    },
    {
      "id": "b-235",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Tools-->>Agent: Results"
        }
      ]
    },
    {
      "id": "b-236",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agent->>Graph: Store Results"
        }
      ]
    },
    {
      "id": "b-237",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Agent-->>API: Final Response"
        }
      ]
    },
    {
      "id": "b-238",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "API-->>Store: Update State"
        }
      ]
    },
    {
      "id": "b-239",
      "type": "paragraph",
      "content": [
