      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "graph TD"
        }
      ]
    },
    {
      "id": "b-105",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "ShellUI[\"🐢 Shell UI .\"]"
        }
      ]
    },
    {
      "id": "b-106",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Nav[\"🧭 Global Nav .\"]"
        }
      ]
    },
    {
      "id": "b-107",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Workspace[\"🖥️ Workspace .\"]"
        }
      ]
    },
