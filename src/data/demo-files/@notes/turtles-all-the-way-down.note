        {
          "type": "text",
          "text": "**4. Shell UI layout**"
        }
      ]
    },
    {
      "id": "b-103",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```mermaid"
        }
      ]
    },
    {
