          "text": "Shell->>App: Pass Token + Context"
        }
      ]
    },
    {
      "id": "b-99",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "App-->>User: App Loaded w/ Identity"
        }
      ]
    },
