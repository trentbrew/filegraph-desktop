          "type": "text",
          "text": "sequenceDiagram"
        }
      ]
    },
    {
      "id": "b-90",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant User"
        }
      ]
    },
    {
      "id": "b-91",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant Shell"
        }
      ]
    },
    {
      "id": "b-92",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant AuthServer"
        }
      ]
    },
    {
      "id": "b-93",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participant App"
        }
      ]
    },
    {
      "id": "b-94",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "User->>Shell: Login Request"
        }
      ]
    },
    {
      "id": "b-95",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Shell->>AuthServer: OAuth Redirect"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AuthServer-->>Shell: Auth Code"
        }
      ]
    },
    {
      "id": "b-97",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Shell->>Shell: Route to Suite/App"
        }
      ]
    },
    {
      "id": "b-98",
