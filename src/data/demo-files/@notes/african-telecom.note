      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "2. [https://business.columbia.edu/sites/default/files-efs/imce-uploads/CITI/Articles/Ghana.pdf](https://business.columbia.edu/sites/default/files-efs/imce-uploads/CITI/Articles/Ghana.pdf)"
        }
      ]
    },
