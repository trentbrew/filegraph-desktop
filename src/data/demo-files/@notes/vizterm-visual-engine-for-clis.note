        {
          "type": "text",
          "text": "╭─────────╮      ┌─────────┐      ┌─────────┐"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "│   API   │─────▶│ Service │─────▶│   DB    │"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "╰─────────╯      └─────────┘      └─────────┘"
        }
      ]
    },
    {
