      ]
    },
    {
      "id": "b-28",
      "type": "bulletList",
      "children": [
        {
          "id": "b-20",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "✅ **Locomotive Scroll** instead of custom scroll observers"
            }
          ]
        },
        {
          "id": "b-21",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "✅ **Block-based component system** (self-contained, typed modules)"
            }
          ]
        },
        {
          "id": "b-22",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "✅ **Unidirectional data flow** (Pinia store orchestration)"
            }
