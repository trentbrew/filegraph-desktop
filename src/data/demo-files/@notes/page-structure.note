          "content": [
            {
              "type": "text",
              "text": "Monitor ad revenue and impressions"
            }
          ]
        },
        {
          "id": "b-233",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Approve or reject sponsorship deals"
            }
          ]
        }
      ]
    },
    {
      "id": "b-235",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "**Closed Captions & Accessibility (`/settings/accessibility`)**"
        }
      ]
    },
    {
      "id": "b-240",
      "type": "bulletList",
      "children": [
        {
          "id": "b-236",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Enable auto-generated closed captions"
            }
          ]
        },
        {
          "id": "b-237",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Choose default caption format (SRT, VTT, TTML)"
            }
          ]
        },
        {
          "id": "b-238",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Set up translation preferences for multilingual subtitles"
            }
          ]
        },
        {
          "id": "b-239",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Configure audio description settings"
            }
          ]
        }
      ]
    },
    {
      "id": "b-241",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "**Developer & API Access (`/settings/developer`)**"
        }
      ]
    },
    {
      "id": "b-242",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*(Available for Admins & Broadcasters only)*"
        }
      ]
    },
    {
      "id": "b-246",
      "type": "bulletList",
      "children": [
        {
          "id": "b-243",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Generate API keys for third-party integrations"
            }
          ]
        },
        {
          "id": "b-244",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Set up webhooks for real-time data updates"
            }
          ]
        },
        {
          "id": "b-245",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Manage OAuth connections"
            }
          ]
        }
      ]
    },
    {
      "id": "b-247",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-253",
      "type": "bulletList",
      "children": [
        {
          "id": "b-248",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Guest users** can browse most public content but need to log in for personalized actions."
            }
          ]
        },
        {
          "id": "b-249",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Members** can follow creators, save shows, and participate in engagement features."
            }
          ]
        },
        {
          "id": "b-250",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Producers** gain access to content submission, media management, and analytics."
            }
          ]
        },
        {
          "id": "b-251",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Broadcasters** manage schedules, ads, and closed captions."
            }
          ]
        },
        {
          "id": "b-252",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Admins** oversee platform-wide operations."
            }
          ]
        }
      ]
    },
    {
      "id": "b-254",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "This structure ensures clear navigation while prioritizing accessibility, usability, and monetization."
        }
      ]
    }
  ]
}