{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "note:notion-374",
  "title": "Inquiry",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "Inquiry"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Hello Dr. Oyemade,"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "I’m Sample User. I’m seeking an initial consult for medication management. I’ve seen the same psychiatrist for a few years, but they no longer accept my insurance."
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Insurance: Medi-Cal"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Current medications: Clonidine HCl 0.1 mg, two times daily; Dextroamphetamine 20 mg tablet, two times daily."
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Are you accepting new Medi-Cal patients, and could we schedule a first appointment? I can authorize release of my prior records if needed."
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Availability: weekdays after 10am PT."
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Best contact: [hello@example.com](mailto:hello@example.com)"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "or 636-515-1293."
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Location: Rancho Cucamonga, CA."
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Thank you for your time,"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Sample User"
        }
      ]
    }
  ]
}