{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "string;                // slug, e.g. \"gumbo\"",
  "title": "Brand Profiles",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "Brand Profiles"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "bulletList",
      "children": [
        {
          "id": "b-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "First pass"
            }
          ]
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Absolutely. Here’s a compact, practical schema that cleanly maps a “brand profile” to DaisyUI v5 themes, plus voice/values metadata you can use across docs and generators."
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "# Type shape (TypeScript)"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Core -----------------------------------------------------------------------"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type Hex = `#${string}` | `oklch(${string})` | `rgb(${string})`;"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type Url = `https://${string}` | `http://${string}` | `data:${string}`;"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface BrandProfile {"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: string;                // slug, e.g. \"gumbo\""
        }
      ]
    },
    {
      "id": "b-12",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: string;              // Human name"
        }
      ]
    },
    {
      "id": "b-13",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "version: string;           // semver for the profile"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "updatedAt: string;         // ISO timestamp"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "links?: {"
        }
      ]
    },
    {
      "id": "b-16",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "site?: Url; repo?: Url; assets?: Url; figma?: Url;"
        }
      ]
    },
    {
      "id": "b-17",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "authors?: { name: string; email?: string }[];"
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Visual identity ----------------------------------------------------------"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "colors: BrandColors;       // semantic tokens → DaisyUI"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "fonts: BrandFonts;         // stacks + files"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "logos: BrandLogos;         // primary/alt/marks + usage"
        }
      ]
    },
    {
      "id": "b-23",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "styles?: BrandStyles;      // radii, shadows, motion, borders"
        }
      ]
    },
    {
      "id": "b-24",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Narrative identity -------------------------------------------------------"
        }
      ]
    },
    {
      "id": "b-25",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "voice: BrandVoice;         // tone, do/don’t, sample copy"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "values: string[];          // e.g. [\"Community\", \"Craft\", \"Candor\"]"
        }
      ]
    },
    {
      "id": "b-27",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "accessibility?: A11yPolicy;// contrast, motion prefs"
        }
      ]
    },
    {
      "id": "b-28",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Colors map directly to DaisyUI vars (primary/secondary/accent/neutral/base)"
        }
      ]
    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// and state colors (info/success/warning/error). Each color can define “content”"
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// foreground for guaranteed contrast. daisyUI v5 reads these CSS vars directly."
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface BrandColors {"
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "primary: ColorPair;"
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "secondary: ColorPair;"
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "accent: ColorPair;"
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "neutral: ColorPair;"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "base: {"
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "100: Hex; 200: Hex; 300: Hex; content: Hex; // base layers + foreground"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "info: ColorPair;"
        }
      ]
    },
    {
      "id": "b-41",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "success: ColorPair;"
        }
      ]
    },
    {
      "id": "b-42",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "warning: ColorPair;"
        }
      ]
    },
    {
      "id": "b-43",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "error: ColorPair;"
        }
      ]
    },
    {
      "id": "b-44",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Optional extensions (DaisyUI supports custom names too)"
        }
      ]
    },
    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "extended?: Record<string, ColorPair | Hex>;"
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface ColorPair { value: Hex; content?: Hex }"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Typography"
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface BrandFonts {"
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "display?: FontSpec; // big headlines/hero"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "heading: FontSpec;"
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "body: FontSpec;"
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "mono?: FontSpec;"
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-55",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface FontSpec {"
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "cssStack: string;                 // e.g. `\"Inter\", system-ui, sans-serif`"
        }
      ]
    },
    {
      "id": "b-57",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "files?: { woff2: Url; weight: number; style?: 'normal'|'italic' }[];"
        }
      ]
    },
    {
      "id": "b-58",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tracking?: number;                // em units (Tailwind letter-spacing scale)"
        }
      ]
    },
    {
      "id": "b-59",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "leading?: number;                 // unitless line-height"
        }
      ]
    },
    {
      "id": "b-60",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-61",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Logos & marks"
        }
      ]
    },
    {
      "id": "b-62",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface BrandLogos {"
        }
      ]
    },
    {
      "id": "b-63",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "primary: LogoAsset;               // default lockup"
        }
      ]
    },
    {
      "id": "b-64",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "alt?: LogoAsset[];                // horizontal, stacked, monochrome, etc."
        }
      ]
    },
    {
      "id": "b-65",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "marks?: LogoAsset[];              // icons / app marks"
        }
      ]
    },
    {
      "id": "b-66",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "rules?: {"
        }
      ]
    },
    {
      "id": "b-67",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "clearspace?: string;            // e.g. \"1x cap height\""
        }
      ]
    },
    {
      "id": "b-68",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "minSizePx?: number;             // minimum render size"
        }
      ]
    },
    {
      "id": "b-69",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "backgroundPrefs?: ('light'|'dark'|'image')[];"
        }
      ]
    },
    {
      "id": "b-70",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "misuse?: string[];              // short don'ts (“no drop shadows”)"
        }
      ]
    },
    {
      "id": "b-71",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-72",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-73",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface LogoAsset {"
        }
      ]
    },
    {
      "id": "b-74",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: string;"
        }
      ]
    },
    {
      "id": "b-75",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "light: Url;                       // works on light bg"
        }
      ]
    },
    {
      "id": "b-76",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "dark?: Url;                       // alt for dark bg"
        }
      ]
    },
    {
      "id": "b-77",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "mono?: Url;                       // single-color version"
        }
      ]
    },
    {
      "id": "b-78",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "inverted?: Url;                   // white-only / reversed"
        }
      ]
    },
    {
      "id": "b-79",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-80",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Style tokens that pair well with DaisyUI components"
        }
      ]
    },
    {
      "id": "b-81",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface BrandStyles {"
        }
      ]
    },
    {
      "id": "b-82",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "radius?: {"
        }
      ]
    },
    {
      "id": "b-83",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sm?: string; md?: string; lg?: string; xl?: string; full?: string;"
        }
      ]
    },
    {
      "id": "b-84",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-85",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "border?: { width?: string; style?: 'solid'|'dashed'; };"
        }
      ]
    },
    {
      "id": "b-86",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "shadow?: { sm?: string; md?: string; lg?: string; };"
        }
      ]
    },
    {
      "id": "b-87",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "motion?: {"
        }
      ]
    },
    {
      "id": "b-88",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "duration?: { fast?: number; base?: number; slow?: number }; // ms"
        }
      ]
    },
    {
      "id": "b-89",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "easing?: { in?: string; out?: string; inOut?: string };     // cubic-bezier()"
        }
      ]
    },
    {
      "id": "b-90",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-91",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Component-level knobs (optional DaisyUI overrides)"
        }
      ]
    },
    {
      "id": "b-92",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "components?: Record<string, Record<string, string|number>>;"
        }
      ]
    },
    {
      "id": "b-93",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-94",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Narrative: tone, voice, lexicon, examples"
        }
      ]
    },
    {
      "id": "b-95",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface BrandVoice {"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tone: ('warm'|'playful'|'serious'|'confident'|'neutral'|'bold')[];"
        }
      ]
    },
    {
      "id": "b-97",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "persona: string;                  // one-liner (“Curious editor with taste”)"
        }
      ]
    },
    {
      "id": "b-98",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "syntax: {"
        }
      ]
    },
    {
      "id": "b-99",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sentenceLength?: { typical: number; max: number };"
        }
      ]
    },
    {
      "id": "b-100",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "contractions?: boolean;"
        }
      ]
    },
    {
      "id": "b-101",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "oxfordComma?: boolean;"
        }
      ]
    },
    {
      "id": "b-102",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-103",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "lexicon?: {"
        }
      ]
    },
    {
      "id": "b-104",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "prefer?: string[]; avoid?: string[];"
        }
      ]
    },
    {
      "id": "b-105",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "taglines?: string[]; adjectives?: string[];"
        }
      ]
    },
    {
      "id": "b-106",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-107",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "do?: string[];                     // style DOs"
        }
      ]
    },
    {
      "id": "b-108",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "dont?: string[];                   // style DON’Ts"
        }
      ]
    },
    {
      "id": "b-109",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "samples?: {"
        }
      ]
    },
    {
      "id": "b-110",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "headline?: string[];"
        }
      ]
    },
    {
      "id": "b-111",
      "type": "paragraph",
