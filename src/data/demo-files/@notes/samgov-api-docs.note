      "content": [
        {
          "type": "text",
          "text": "| data.award.awardee.location.state.name | Awardee State Name | String | v2 |"
        }
      ]
    },
    {
      "id": "b-82",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| data.award.awardee.location.country | Awardee Country | JSON Object | v2 |"
        }
      ]
    },
