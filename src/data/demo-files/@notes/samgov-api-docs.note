      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| SDVOSBS | Service-Disabled Veteran-Owned Small Business (SDVOSB) Sole Source (FAR 19.14) |"
        }
      ]
    },
    {
      "id": "b-132",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| WOSB | Women-Owned Small Business (WOSB) Program Set-Aside (FAR 19.15) |"
        }
      ]
    },
    {
      "id": "b-133",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| WOSBSS | Women-Owned Small Business (WOSB) Program Sole Source (FAR 19.15) |"
        }
      ]
    },
    {
      "id": "b-134",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| EDWOSB | Economically Disadvantaged WOSB (EDWOSB) Program Set-Aside (FAR 19.15) |"
        }
      ]
    },
    {
      "id": "b-135",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| EDWOSBSS | Economically Disadvantaged WOSB (EDWOSB) Program Sole Source (FAR 19.15) |"
        }
      ]
    },
    {
      "id": "b-136",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| LAS | Local Area Set-Aside (FAR 26.2) |"
        }
      ]
