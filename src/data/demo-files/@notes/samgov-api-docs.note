      "content": [
        {
          "type": "text",
          "text": "| data.award.awardee.location.city | Awardee City | JSON Object | v2 |"
        }
      ]
    },
    {
      "id": "b-77",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| data.award.awardee.location.city.code | Awardee City Code | String | v2 |"
        }
      ]
    },
    {
