        }
      ]
    },
    {
      "id": "b-86",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| pointofContact | Point of Contact Information. It can have below fields if available:FaxTypeEmailPhoneTitleFull name | JSON Array |  |"
        }
      ]
    },
    {
      "id": "b-87",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| data.pointOfContact.type | Point of Contact Type | String | v2 |"
