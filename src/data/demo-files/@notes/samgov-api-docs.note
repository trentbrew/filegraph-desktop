    {
      "id": "b-93",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| description | A link to an opportunity description.Note: To download the description, user should append the public API Key. If no description is available then, user is shown an error message “ Description not found” | String | v2 |"
        }
      ]
    },
    {
      "id": "b-94",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| data.pointOfContact.additionalInfo | Additional Information*Note: This field will only show if additional information is given* | JSON Array | v2 |"
        }
      ]
    },
    {
      "id": "b-95",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| data.pointOfContact.additionalInfo.content | Content of Additional Information*Note: This field will only show if a text is provided for additional information* | String | v2 |"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| organizationType | Type of an organization – department/sub-tier/office | String | v2 |"
        }
      ]
    },
    {
      "id": "b-97",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| officeAddress | Office Address Information. It can have below fields if available:CityStateZip | String | v2 |"
        }
