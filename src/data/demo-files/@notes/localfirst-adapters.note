          "type": "text",
          "text": "$svelteStore.todos.push(newTodo);"
        }
      ]
    },
    {
      "id": "b-171",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
