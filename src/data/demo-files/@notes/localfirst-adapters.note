      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: crypto.randomUUID(),"
        }
      ]
    },
    {
      "id": "b-164",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title,"
        }
      ]
    },
    {
      "id": "b-165",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "completed: false,"
        }
      ]
    },
    {
      "id": "b-166",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "createdAt: new Date(),"
        }
      ]
    },
    {
      "id": "b-167",
      "type": "paragraph",
      "content": [
