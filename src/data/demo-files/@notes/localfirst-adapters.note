    },
    {
      "id": "b-125",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Adapter Architecture with SyncedStore"
        }
      ]
    },
    {
      "id": "b-126",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Now your adapters become much simpler—they just need to sync with the Y.js document:"
        }
      ]
    },
    {
      "id": "b-127",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-128",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type * as Y from 'yjs';"
        }
      ]
    },
    {
      "id": "b-129",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type PocketBase from 'pocketbase'; // Example"
        }
      ]
    },
    {
      "id": "b-130",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface SyncAdapter {"
        }
      ]
    },
    {
      "id": "b-131",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Connect to backend and establish sync"
        }
      ]
    },
    {
      "id": "b-132",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "connect(yjsDoc: Y.Doc): Promise<void>;"
        }
      ]
    },
    {
      "id": "b-133",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "disconnect(): void;"
        }
      ]
    },
    {
      "id": "b-134",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Optional: expose native API for unique features"
        }
      ]
    },
    {
      "id": "b-135",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "native?: any;"
        }
      ]
    },
    {
      "id": "b-136",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-137",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "class PocketBaseAdapter implements SyncAdapter {"
        }
      ]
    },
    {
      "id": "b-138",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "constructor(private pb: PocketBase) {}"
        }
      ]
    },
    {
      "id": "b-139",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async connect(yjsDoc: Y.Doc) {"
        }
      ]
    },
    {
      "id": "b-140",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Set up bidirectional sync between Y.js doc and PocketBase"
        }
      ]
    },
    {
      "id": "b-141",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.setupRealtimeSync(yjsDoc);"
        }
      ]
    },
    {
      "id": "b-142",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-143",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Expose PocketBase client for advanced features"
        }
      ]
    },
    {
      "id": "b-144",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "get native() {"
        }
      ]
    },
    {
      "id": "b-145",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this.pb;"
        }
      ]
    },
    {
      "id": "b-146",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-147",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "private setupRealtimeSync(yjsDoc: Y.Doc) {"
        }
      ]
    },
    {
      "id": "b-148",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Implementation for syncing Y.js with PocketBase..."
        }
      ]
    },
    {
      "id": "b-149",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-150",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-151",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
