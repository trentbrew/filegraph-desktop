{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "crypto.randomUUID(),",
  "title": "Localfirst Adapters",
  "author": "person:jane-brew:001",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "Localfirst Adapters"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The key is designing a solid abstraction layer that can seamlessly switch between local storage and various backend services. Here's how I'd approach it:"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Core Architecture"
        }
      ]
    },
    {
      "id": "b-4",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Data Layer Abstraction"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Create a unified interface that all adapters implement:"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface DataAdapter {"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// CRUD operations"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "create<T>(collection: string, data: T): Promise<T>;"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "read<T>(collection: string, id: string): Promise<T | null>;"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "update<T>(collection: string, id: string, data: Partial<T>): Promise<T>;"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "delete(collection: string, id: string): Promise<void>;"
        }
      ]
    },
    {
      "id": "b-13",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Querying"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "query<T>(collection: string, filters?: QueryFilter[]): Promise<T[]>;"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Real-time subscriptions"
        }
      ]
    },
    {
      "id": "b-16",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "subscribe<T>(collection: string, callback: (data: T[]) => void): () => void;"
        }
      ]
    },
    {
      "id": "b-17",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Sync capabilities"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sync?(): Promise<void>;"
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "isOnline(): boolean;"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Local-First Foundation"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "bulletList",
      "children": [
        {
          "id": "b-23",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use IndexedDB (via `Dexie.js`) as the primary local store."
            }
          ]
        },
        {
          "id": "b-24",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Implement conflict resolution strategies (last-write-wins, operational transforms, etc.)."
            }
          ]
        },
        {
          "id": "b-25",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Queue operations when offline and sync when reconnected."
            }
          ]
        }
      ]
    },
    {
      "id": "b-27",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "SvelteKit Integration"
        }
      ]
    },
    {
      "id": "b-28",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Store Architecture"
        }
      ]
    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// src/lib/stores/data.ts"
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { writable, derived } from 'svelte/store';"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { LocalAdapter } from '$lib/adapters/local'; // Example adapter"
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const dataStore = writable({"
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "adapter: new LocalAdapter(), // Default to local"
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "collections: new Map()"
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Reactive queries that work with any adapter"
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export function createQuery<T>(collection: string, filters?: QueryFilter[]) {"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// This derived store would need logic to interact with the adapter's"
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// query and subscribe methods to provide live-updating data."
        }
      ]
    },
    {
      "id": "b-41",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return derived(dataStore, ($store, set) => {"
        }
      ]
    },
    {
      "id": "b-42",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const unsubscribe = $store.adapter.subscribe<T>(collection, (data) => {"
        }
      ]
    },
    {
      "id": "b-43",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Apply filters locally if needed or pass to adapter"
        }
      ]
    },
    {
      "id": "b-44",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "set(data);"
        }
      ]
    },
    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return unsubscribe;"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-50",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Configuration System"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// src/lib/config.ts"
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const dataConfig = {"
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "adapter: 'local', // 'pocketbase' | 'convex' | 'firebase' | 'supabase'"
        }
      ]
    },
    {
      "id": "b-55",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "syncStrategy: 'optimistic', // 'pessimistic' | 'offline-first'"
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "conflictResolution: 'last-write-wins'"
        }
      ]
    },
    {
      "id": "b-57",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-58",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-59",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Adapter Implementations"
        }
      ]
    },
    {
      "id": "b-60",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Each adapter would handle:"
        }
      ]
    },
    {
      "id": "b-66",
      "type": "bulletList",
      "children": [
        {
          "id": "b-61",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Local Adapter:** Pure IndexedDB operations."
            }
          ]
        },
        {
          "id": "b-62",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**PocketBase Adapter:** HTTP requests + real-time subscriptions, with local caching."
            }
          ]
        },
        {
          "id": "b-63",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Convex Adapter:** Their reactive queries + optimistic updates."
            }
          ]
        },
        {
          "id": "b-64",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Firebase Adapter:** Firestore operations with offline persistence."
            }
          ]
        },
        {
          "id": "b-65",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Supabase Adapter:** PostgreSQL operations + real-time subscriptions."
            }
          ]
        }
      ]
    },
    {
      "id": "b-67",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The beauty is that your components would use the same API regardless:"
        }
      ]
    },
    {
      "id": "b-68",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-69",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<script>"
        }
      ]
    },
    {
      "id": "b-70",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { createQuery } from '$lib/stores/data'"
        }
      ]
    },
    {
      "id": "b-71",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const todos = createQuery('todos', [{ field: 'completed', op: '==', value: false }])"
        }
      ]
    },
    {
      "id": "b-72",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "</script>"
        }
      ]
    },
    {
      "id": "b-73",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{#each $todos as todo}"
        }
      ]
    },
    {
      "id": "b-74",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<div>{todo.title}</div>"
        }
      ]
    },
    {
      "id": "b-75",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{/each}"
        }
      ]
    },
    {
      "id": "b-76",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-77",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Key Benefits"
        }
      ]
    },
    {
      "id": "b-83",
      "type": "bulletList",
      "children": [
        {
          "id": "b-78",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Developer Experience:** Write once, deploy anywhere."
            }
          ]
        },
        {
          "id": "b-79",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Progressive Enhancement:** Start local, add cloud features later."
            }
          ]
        },
        {
          "id": "b-80",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Offline-First:** Always works, even without internet."
            }
          ]
        },
        {
          "id": "b-81",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Performance:** Local operations are instant."
            }
          ]
        },
        {
          "id": "b-82",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Flexibility:** Easy to migrate between backends."
            }
          ]
        }
      ]
    },
    {
      "id": "b-84",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Challenges to Consider"
        }
      ]
    },
    {
      "id": "b-89",
      "type": "bulletList",
      "children": [
        {
          "id": "b-85",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Schema Management:** Each backend has different capabilities."
            }
          ]
        },
        {
          "id": "b-86",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Real-time Sync:** Conflict resolution can get complex."
            }
          ]
        },
        {
          "id": "b-87",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Type Safety:** Maintaining types across different adapters."
            }
          ]
        },
        {
          "id": "b-88",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Feature Parity:** Some backends have unique features that don't translate."
            }
          ]
        }
      ]
    },
    {
      "id": "b-90",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "A More Robust Approach: SyncedStore + Zod"
        }
      ]
    },
    {
      "id": "b-91",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Using `SyncedStore` for real-time sync, and `Zod` + plain TypeScript for schema management and type safety creates a much more elegant and robust foundation."
        }
      ]
    },
    {
      "id": "b-92",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "SyncedStore Integration"
        }
      ]
    },
    {
      "id": "b-93",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "SyncedStore handles the hardest parts—CRDT-based conflict resolution and real-time sync. Your architecture becomes:"
        }
      ]
    },
    {
      "id": "b-94",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-95",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// src/lib/stores/sync.ts"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { syncedStore } from '@syncedstore/core';"
        }
      ]
    },
    {
      "id": "b-97",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { svelteSyncedStore } from '@syncedstore/svelte';"
        }
      ]
    },
    {
      "id": "b-98",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type { Todo, User } from '$lib/schemas'; // Assuming schemas are defined"
        }
      ]
    },
    {
      "id": "b-99",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Define your app's data structure"
        }
      ]
    },
    {
      "id": "b-100",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const store = syncedStore({"
        }
      ]
    },
    {
      "id": "b-101",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "todos: [] as Todo[],"
        }
      ]
    },
    {
      "id": "b-102",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "users: [] as User[],"
        }
      ]
    },
    {
      "id": "b-103",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// ... other collections"
        }
      ]
    },
    {
      "id": "b-104",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-105",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const svelteStore = svelteSyncedStore(store);"
        }
      ]
    },
    {
      "id": "b-106",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-107",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Zod Schema Management"
        }
      ]
    },
    {
      "id": "b-108",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "This is perfect for maintaining type safety across all adapters:"
        }
      ]
    },
    {
      "id": "b-109",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-110",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// src/lib/schemas/todo.ts"
        }
      ]
    },
    {
      "id": "b-111",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { z } from 'zod';"
        }
      ]
    },
    {
