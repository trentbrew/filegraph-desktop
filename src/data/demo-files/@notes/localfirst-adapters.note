      ]
    },
    {
      "id": "b-155",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<script lang=\"ts\">"
        }
      ]
    },
    {
      "id": "b-156",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { svelteStore } from '$lib/stores/sync';"
        }
      ]
    },
    {
      "id": "b-157",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { TodoSchema } from '$lib/schemas/todo';"
        }
      ]
    },
    {
      "id": "b-158",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import TodoItem from './TodoItem.svelte'; // Example component"
        }
      ]
    },
    {
      "id": "b-159",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Reactive and real-time automatically"
        }
      ]
    },
    {
      "id": "b-160",
      "type": "paragraph",
      "content": [
