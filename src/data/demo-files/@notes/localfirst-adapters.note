    },
    {
      "id": "b-177",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Hooks for Native API Access"
        }
      ]
    },
    {
      "id": "b-178",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Create composables that expose backend-specific features:"
        }
      ]
    },
    {
      "id": "b-179",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-180",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// src/lib/hooks/usePocketBase.ts"
        }
      ]
    },
    {
      "id": "b-181",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { getAdapter } from '$lib/adapter-service'; // Assume a service to get the current adapter"
        }
      ]
    },
    {
      "id": "b-182",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type { PocketBaseAdapter } from '$lib/adapters/pocketbase';"
        }
      ]
    },
    {
      "id": "b-183",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export function usePocketBase() {"
        }
      ]
    },
    {
      "id": "b-184",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const adapter = getAdapter() as PocketBaseAdapter;"
        }
      ]
    },
    {
      "id": "b-185",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return {"
        }
      ]
    },
    {
      "id": "b-186",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Standard operations work through SyncedStore"
        }
      ]
    },
    {
      "id": "b-187",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// But you can access native features:"
        }
      ]
    },
    {
      "id": "b-188",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "uploadFile: (file: File) => adapter.native.collection('files').create({ file }),"
        }
      ]
    },
    {
      "id": "b-189",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "authenticate: (email: string, password: string) =>"
        }
      ]
    },
    {
      "id": "b-190",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "adapter.native.collection('users').authWithPassword(email, password)"
        }
      ]
    },
    {
      "id": "b-191",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-192",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-193",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-194",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-195",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// src/lib/hooks/useConvex.ts"
        }
      ]
    },
    {
      "id": "b-196",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { getAdapter } from '$lib/adapter-service';"
        }
      ]
    },
    {
      "id": "b-197",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type { ConvexAdapter } from '$lib/adapters/convex';"
        }
      ]
    },
    {
      "id": "b-198",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export function useConvex() {"
        }
      ]
    },
    {
      "id": "b-199",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const adapter = getAdapter() as ConvexAdapter;"
        }
      ]
    },
    {
      "id": "b-200",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return {"
        }
      ]
    },
    {
      "id": "b-201",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Access Convex functions directly"
        }
      ]
    },
    {
      "id": "b-202",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "runAction: adapter.native.action,"
        }
      ]
    },
    {
      "id": "b-203",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "runQuery: adapter.native.query"
        }
      ]
    },
    {
      "id": "b-204",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-205",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-206",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-207",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Configuration & Setup"
        }
      ]
    },
    {
      "id": "b-208",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-209",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// src/lib/config.ts"
        }
      ]
    },
    {
      "id": "b-210",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { z } from 'zod';"
        }
      ]
    },
    {
      "id": "b-211",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { store } from '$lib/stores/sync';"
        }
      ]
    },
    {
      "id": "b-212",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { getYjsValue } from '@syncedstore/core';"
        }
      ]
    },
    {
      "id": "b-213",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { createAdapter } from '$lib/adapter-service';"
        }
      ]
    },
    {
      "id": "b-214",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const ConfigSchema = z.object({"
        }
      ]
    },
    {
      "id": "b-215",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "adapter: z.enum(['local', 'pocketbase', 'convex', 'firebase', 'supabase']),"
        }
      ]
    },
    {
      "id": "b-216",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "syncStrategy: z.enum(['realtime', 'periodic', 'manual']).default('realtime')"
        }
      ]
    },
    {
      "id": "b-217",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-218",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type Config = z.infer<typeof ConfigSchema>;"
        }
      ]
    },
    {
      "id": "b-219",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// In your app initialization"
        }
      ]
    },
    {
      "id": "b-220",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export async function initializeApp(config: Config) {"
        }
      ]
    },
    {
      "id": "b-221",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const validatedConfig = ConfigSchema.parse(config);"
        }
      ]
    },
    {
      "id": "b-222",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const adapter = createAdapter(validatedConfig.adapter);"
        }
      ]
    },
    {
      "id": "b-223",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await adapter.connect(getYjsValue(store));"
        }
      ]
    },
    {
      "id": "b-224",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return { store: svelteStore, adapter };"
        }
      ]
    },
    {
      "id": "b-225",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-226",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-227",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Major Advantages of the SyncedStore Approach"
        }
      ]
    },
    {
      "id": "b-234",
      "type": "bulletList",
      "children": [
        {
          "id": "b-228",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Conflict Resolution:** SyncedStore handles this automatically with CRDTs."
            }
          ]
        },
        {
          "id": "b-229",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Real-time:** Built-in, works offline-first."
            }
          ]
        },
        {
          "id": "b-230",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Type Safety:** Zod ensures runtime safety, TypeScript ensures compile-time safety."
            }
          ]
        },
        {
          "id": "b-231",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Flexibility:** Native API access for unique features via hooks."
            }
          ]
        },
        {
          "id": "b-232",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Simplicity:** Your app code barely knows about the backend."
            }
          ]
        },
        {
          "id": "b-233",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Performance:** Local operations are instant, sync happens in the background."
            }
          ]
        }
      ]
    },
    {
      "id": "b-235",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Example Usage in Components"
        }
      ]
    },
    {
      "id": "b-236",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-237",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<!-- TodoApp.svelte -->"
        }
      ]
    },
    {
      "id": "b-238",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<script lang=\"ts\">"
        }
      ]
    },
    {
      "id": "b-239",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { svelteStore } from '$lib/stores/sync';"
        }
      ]
    },
    {
      "id": "b-240",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { usePocketBase } from '$lib/hooks/usePocketBase';"
        }
      ]
    },
    {
      "id": "b-241",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const { uploadFile } = usePocketBase(); // Only if using PocketBase"
        }
      ]
    },
    {
      "id": "b-242",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// This works the same regardless of backend"
        }
      ]
    },
    {
      "id": "b-243",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "function toggleTodo(id: string) {"
        }
      ]
    },
    {
      "id": "b-244",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const todo = $svelteStore.todos.find(t => t.id === id);"
        }
      ]
    },
    {
      "id": "b-245",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (todo) todo.completed = !todo.completed;"
        }
      ]
    },
    {
      "id": "b-246",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-247",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Backend-specific feature"
        }
      ]
    },
    {
      "id": "b-248",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "async function attachFile(todoId: string, file: File) {"
        }
      ]
    },
    {
      "id": "b-249",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const fileRecord = await uploadFile(file);"
        }
      ]
    },
    {
      "id": "b-250",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Update todo with file reference"
        }
      ]
    },
    {
      "id": "b-251",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const todo = $svelteStore.todos.find(t => t.id === todoId);"
        }
      ]
    },
    {
      "id": "b-252",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (todo) {"
        }
      ]
    },
    {
      "id": "b-253",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Assume a fileId property on the todo"
        }
      ]
    },
    {
      "id": "b-254",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// todo.fileId = fileRecord.id"
        }
      ]
    },
    {
      "id": "b-255",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-256",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-257",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "</script>"
        }
      ]
    },
    {
      "id": "b-258",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    }
  ]
}