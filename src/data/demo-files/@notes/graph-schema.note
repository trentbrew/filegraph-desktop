{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "string;",
  "title": "Graph Schema",
  "author": "person:jane-brew:001",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "Graph Schema"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "bulletList",
      "children": [
        {
          "id": "b-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "types.d.ts"
            }
          ]
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```jsx"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "/**"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* FileGraph Type System"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Defines the core data structures for representing files and their relationships."
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* Edge Direction Convention:"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "* For all relationships, the `from` node is the source/origin, and the `to` node is the target/destination:"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*   - parent_of: Directory (from) contains file/dir (to)"
        }
      ]
    },
    {
      "id": "b-13",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*   - imports: File (from) imports code from (to)"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*   - references: File (from) references file (to)"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*   - symlinked_to: Symlink (from) points to target (to)"
        }
      ]
    },
    {
      "id": "b-16",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*   - is_version_of: Newer file (from) is a version of older file (to)"
        }
      ]
    },
    {
      "id": "b-17",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*   - is_related_to: File (from) is related to file (to) (bidirectional, usually paired)"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*   - has_dependency: File (from) depends on file (to)"
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "*/"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// --- Base Metadata & Node Types ---"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface BaseNodeMetadata {"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "size?: number; // Optional: May not apply to all node types (like entities)"
        }
      ]
    },
    {
      "id": "b-23",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "created: Date;"
        }
      ]
    },
    {
      "id": "b-24",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "modified: Date;"
        }
      ]
    },
    {
      "id": "b-25",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "extension?: string; // Optional: Primarily for files"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tags?: string[]; // System-generated tags (e.g., file extension, potentially entity type)"
        }
      ]
    },
    {
      "id": "b-27",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "symlinkTarget?: string; // Optional: Only for symlinks"
        }
      ]
    },
    {
      "id": "b-28",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "embedding?: number[]; // Base semantic vector"
        }
      ]
    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "[key: string]: any; // Allow flexibility"
        }
      ]
    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Extended metadata including semantic and contextual information"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface SemanticNodeMetadata extends BaseNodeMetadata {"
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "concepts?: string[]; // Extracted key concepts (from NLP/LLM)"
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "summary?: string; // AI-generated content summary"
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "userTags?: string[]; // Human-provided tags"
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// --- Embedding Cache Fields ---"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "embeddingContentHash?: string; // SHA-256 hash of the content used for the embedding"
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "embeddingModelName?: string; // Name of the model used (e.g., 'mxbai-embed-large')"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "embeddingConfigHash?: string; // Hash of the embedding configuration (optional)"
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// -----------------------------"
        }
      ]
    },
    {
      "id": "b-41",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// --- Entity Specific Fields (Optional) ---"
        }
      ]
    },
    {
      "id": "b-42",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "entityType?: string; // e.g., 'Person', 'Project', 'Color', 'Concept'"
        }
      ]
    },
    {
      "id": "b-43",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "label?: string; // Display name for the entity (if different from path)"
        }
      ]
    },
    {
      "id": "b-44",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "description?: string; // User-defined or AI-assisted description"
        }
      ]
    },
    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sources?: string[]; // Nodes (IDs) or external URLs this entity derives from or represents"
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// -----------------------------------------"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Dynamic property, calculated at runtime based on UserContext"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "contextualRelevance?: {"
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "score: number; // 0-1 relevance score"
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "reasoning?: string[]; // Explanation factors"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "temporalBoost?: number; // Modifier based on time/recency"
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "relationshipFactors?: {"
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Influence of graph neighbors"
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "supporting?: number; // How much it supports current focus"
        }
      ]
    },
    {
      "id": "b-55",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "contradicting?: number; // How much it challenges current focus"
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "extending?: number; // How much it builds upon current focus"
        }
      ]
    },
    {
      "id": "b-57",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-58",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-59",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-60",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Node type enum"
        }
      ]
    },
    {
      "id": "b-61",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "type NodeType = 'file' | 'dir' | 'symlink' | 'entity';"
        }
      ]
    },
    {
      "id": "b-62",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Node: Represents a file, directory, symlink, or abstract entity"
        }
      ]
    },
    {
      "id": "b-63",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "type Node = {"
        }
      ]
    },
    {
      "id": "b-64",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: string;"
        }
      ]
    },
    {
      "id": "b-65",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "path: string;"
        }
      ]
    },
    {
      "id": "b-66",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "type: NodeType;"
        }
      ]
    },
    {
      "id": "b-67",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata: SemanticNodeMetadata; // Use the richer metadata type"
        }
      ]
    },
    {
      "id": "b-68",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-69",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// --- Edge Types & Metadata ---"
        }
      ]
    },
    {
      "id": "b-70",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Base interface for edge metadata"
        }
      ]
    },
    {
      "id": "b-71",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface EdgeMetadata {"
        }
      ]
    },
    {
      "id": "b-72",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "confidence?: number; // Optional confidence score for inferred relationships"
        }
      ]
    },
    {
      "id": "b-73",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "[key: string]: any;"
        }
      ]
    },
    {
      "id": "b-74",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-75",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Specific edge metadata types"
        }
      ]
    },
    {
      "id": "b-76",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface VersionEdgeMetadata extends EdgeMetadata {"
        }
      ]
    },
    {
      "id": "b-77",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "version_number: string;"
        }
      ]
    },
    {
      "id": "b-78",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-79",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface DependencyEdgeMetadata extends EdgeMetadata {"
        }
      ]
    },
    {
      "id": "b-80",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "dependency_level: 'direct' | 'indirect';"
        }
      ]
    },
    {
      "id": "b-81",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-82",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Relationship types enum"
        }
      ]
    },
    {
      "id": "b-83",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "type RelationType ="
        }
      ]
    },
    {
      "id": "b-84",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'parent_of'"
        }
      ]
    },
    {
      "id": "b-85",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'imports'"
        }
      ]
    },
    {
      "id": "b-86",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'references'"
        }
      ]
    },
    {
      "id": "b-87",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'symlinked_to'"
        }
      ]
    },
    {
      "id": "b-88",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'is_version_of'"
        }
      ]
    },
    {
      "id": "b-89",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'is_related_to'"
        }
      ]
    },
    {
      "id": "b-90",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'has_dependency'"
        }
      ]
    },
    {
      "id": "b-91",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Semantic / Inferred types"
        }
      ]
    },
    {
      "id": "b-92",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'similar_to'"
        }
      ]
    },
    {
      "id": "b-93",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'supports'"
        }
      ]
    },
    {
      "id": "b-94",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'contradicts'"
        }
      ]
    },
    {
      "id": "b-95",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'elaborates_on'"
        }
      ]
    },
    {
      "id": "b-96",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| string; // Allow custom"
        }
      ]
    },
    {
      "id": "b-97",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Base Edge interface"
        }
      ]
    },
    {
      "id": "b-98",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface BaseEdge {"
        }
      ]
    },
    {
      "id": "b-99",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "from: string;"
        }
      ]
    },
    {
      "id": "b-100",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "to: string;"
        }
      ]
    },
    {
      "id": "b-101",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "relation: RelationType;"
        }
      ]
    },
    {
      "id": "b-102",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata?: EdgeMetadata;"
        }
      ]
    },
    {
      "id": "b-103",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-104",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Specific edge types (extending BaseEdge)"
        }
      ]
    },
    {
      "id": "b-105",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface ParentEdge extends BaseEdge {"
        }
      ]
    },
    {
      "id": "b-106",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "relation: 'parent_of';"
        }
      ]
    },
    {
      "id": "b-107",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-108",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface ImportEdge extends BaseEdge {"
        }
      ]
    },
    {
      "id": "b-109",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "relation: 'imports';"
        }
      ]
    },
    {
      "id": "b-110",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-111",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "interface SymlinkEdge extends BaseEdge {"
        }
      ]
    },
    {
      "id": "b-112",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "relation: 'symlinked_to';"
        }
      ]
    },
    {
      "id": "b-113",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
