          ]
        }
      ]
    },
    {
      "id": "b-218",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- Purpose: disconnecting and deactivating from WordPress"
        }
      ]
    },
    {
      "id": "b-219",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- No migration required"
        }
      ]
    },
    {
      "id": "b-220",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "> NOTE: Webflow has a built-in form builder that can be used to create and manage forms. This is a more modern and flexible solution than FormAssembly, and it is not required for the migration."
        }
      ]
    },
    {
      "id": "b-221",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ">"
        }
      ]
    },
