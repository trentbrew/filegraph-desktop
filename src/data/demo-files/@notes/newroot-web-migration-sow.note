            }
          ]
        },
        {
          "id": "b-301",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Bi-weekly stakeholder reviews every other Thursday at 2pm EST"
            }
          ]
        },
        {
          "id": "b-302",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
