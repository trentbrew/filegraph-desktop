        {
          "type": "text",
          "text": "- Integration configuration guides"
        }
      ]
    },
    {
      "id": "b-276",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- Troubleshooting procedures"
        }
      ]
    },
    {
      "id": "b-277",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- 30 days of priority email/phone support post-launch"
        }
      ]
    },
    {
      "id": "b-278",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- Monthly check-ins for first 3 months"
