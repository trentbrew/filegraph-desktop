      "id": "b-509",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "graph TD"
        }
      ]
    },
    {
      "id": "b-510",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A[PRD Complete?] -->|Yes| B[Engineering Estimates]"
        }
      ]
    },
    {
      "id": "b-511",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A -->|No| Z[Keep Writing]"
        }
      ]
    },
    {
      "id": "b-512",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "B --> C{< 6 months to MVP?}"
        }
      ]
    },
    {
      "id": "b-513",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "C -->|Yes| D[Prototype Key Risks]"
        }
      ]
    },
    {
      "id": "b-514",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "C -->|No| E[Descope or Rethink]"
        }
      ]
    },
    {
      "id": "b-515",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "D --> F{Risks Mitigated?}"
        }
      ]
    },
    {
      "id": "b-516",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "F -->|Yes| G[START BUILDING]"
        }
      ]
    },
    {
      "id": "b-517",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "F -->|No| H[Revise Architecture]"
        }
      ]
    },
    {
      "id": "b-518",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "H --> B"
        }
      ]
    },
