      "content": [
        {
          "type": "text",
          "text": "Magic"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "when the agent does something *you didn’t explicitly ask for* but obviously needed."
        }
      ]
    },
    {
      "id": "b-3",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "examples:"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "bulletList",
      "children": [
        {
          "id": "b-4",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "connects a meeting to a task you forgot you made"
            }
          ]
        },
        {
          "id": "b-5",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "drafts a reply with info from three places you didn’t check"
            }
          ]
        },
        {
          "id": "b-6",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "reorders your week around energy, not time"
            }
          ]
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "magic = foresight + context + speed. like it’s been reading your mind *and* your inbox."
        }
      ]
    }
  ]
}