    {
      "id": "b-5",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "1. Cablecast API Integration"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "bulletList",
      "children": [
        {
          "id": "b-6",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Title**: Integrate Cablecast API for schedule & metadata sync"
            }
          ]
        },
        {
          "id": "b-7",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Description**: Enable broadcasters to import schedules, show metadata, and VOD links via Cablecast API. Includes token-based auth, sync intervals, and fallback UI."
            }
          ]
        },
        {
          "id": "b-8",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Labels**: `integration`, `backend`, `MVP`"
            }
          ]
        },
        {
          "id": "b-9",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Effort**: L"
            }
          ]
        },
        {
          "id": "b-10",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Status**: Backlog"
            }
          ]
        }
      ]
    },
    {
      "id": "b-12",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "2. Configurable TV Guide"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "bulletList",
      "children": [
        {
          "id": "b-13",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Title**: Build embeddable, customizable TV Guide"
            }
          ]
        },
        {
          "id": "b-14",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Description**: Broadcasters can embed a TV Guide widget on their site and customize branding (colors, logo, layout)."
            }
          ]
        },
        {
          "id": "b-15",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Labels**: `frontend`, `widget`, `MVP`"
            }
          ]
        },
        {
          "id": "b-16",
          "type": "paragraph",
          "content": [
