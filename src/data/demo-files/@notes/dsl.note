        }
      ]
    },
    {
      "id": "b-251",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**File:** `blocks/why-here.copy.md`"
        }
      ]
    },
    {
      "id": "b-252",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Goal:** keep longform authoring pleasant; compiled into `ArticleDoc`."
        }
      ]
    },
    {
      "id": "b-253",
      "type": "paragraph",
