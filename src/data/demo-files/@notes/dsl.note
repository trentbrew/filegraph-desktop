      "content": [
        {
          "type": "text",
          "text": "- kind: copy"
        }
      ]
    },
    {
      "id": "b-319",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "data:"
        }
      ]
    },
    {
      "id": "b-320",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pre: \"Neighbors First\""
        }
      ]
    },
    {
      "id": "b-321",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title: \"Who are the people behind Invest York Road?\""
        }
      ]
    },
    {
      "id": "b-322",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "paragraphs:"
        }
      ]
    },
    {
      "id": "b-323",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- \"Neighbors, business owners, volunteers…\""
        }
      ]
    },
    {
      "id": "b-324",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-325",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-329",
      "type": "bulletList",
      "children": [
        {
          "id": "b-326",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Zod schemas + compiler scaffold (`compileStory`)"
            }
          ]
        },
        {
          "id": "b-327",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A default **kind registry** mapping for: `logo`, `image.hero`, `video.hero`, `map.gl`, `stats`, `quote`, `waffle`, `gapMeter`, plus a `custom:*` escape hatch."
            }
          ]
        },
        {
          "id": "b-328",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
