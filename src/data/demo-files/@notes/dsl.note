{
  "@context": {
    "schema": "https://schema.org/"
  },
  "@type": "Note",
  "@id": "invest-york-road",
  "title": "DSL",
  "author": "person:jane-brew:001",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "DSL"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Here’s a compact, high-level DSL that sits above the current `SceneSpec[]` and cleanly maps to our Nuxt/Vue blocks. It gives you three entry points (choose 1 or mix): a portable YAML/JSON spec, a TypeScript fluent builder for IDE help, and a tiny markdown-ish block for rich copy. All three compile to your existing runtime shape (`SceneSpec[]`) with zero runtime coupling to any specific visuals."
        }
      ]
    },
    {
      "id": "b-3",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**File:** `invest-york-road.story.yaml`"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Goal:** declarative, content-first; portable to any renderer."
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```yaml"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "story:"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
