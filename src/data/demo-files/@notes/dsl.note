          "type": "text",
          "text": "actions(...acts: SceneDoc['visual']['actions'] extends infer A ? A[] : any[]) {"
        }
      ]
    },
    {
      "id": "b-227",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sc.visual.actions = acts as any; return this;"
        }
