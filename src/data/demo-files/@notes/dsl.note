    },
    {
      "id": "b-222",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "visual(kind: string, props: Record<string, any>, ref?: string) {"
        }
      ]
    },
    {
      "id": "b-223",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sc.visual = { kind, props, ref };"
        }
      ]
    },
    {
      "id": "b-224",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this;"
        }
