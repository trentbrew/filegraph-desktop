        {
          "type": "text",
          "text": "title: \"Buy, redevelop, and hold—together\""
        }
      ]
    },
    {
      "id": "b-111",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "titleColor: \"text-[#2c324e]\""
        }
      ]
    },
    {
      "id": "b-112",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "paragraphs:"
        }
      ]
    },
    {
      "id": "b-113",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- \"Neighbors invest small amounts into a <strong>community-controlled fund</strong>…\""
        }
      ]
    },
    {
      "id": "b-114",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "offsets:"
        }
      ]
    },
    {
      "id": "b-115",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "topDvh: 120"
        }
      ]
    },
    {
      "id": "b-116",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "bottomDvh: 120"
        }
      ]
    },
    {
      "id": "b-117",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- key: portland-model"
        }
      ]
    },
    {
      "id": "b-118",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "visual:"
        }
      ]
    },
    {
      "id": "b-119",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "kind: image.hero"
        }
      ]
    },
    {
      "id": "b-120",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "props:"
        }
      ]
    },
    {
      "id": "b-121",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "src: \"${portland}\""
        }
      ]
    },
    {
      "id": "b-122",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "fit: cover"
        }
      ]
    },
    {
      "id": "b-123",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "effects:"
        }
      ]
    },
    {
      "id": "b-124",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "fadeIn: true"
        }
      ]
    },
    {
      "id": "b-125",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "panOut: { scale: 1.06, duration: 8 }"
        }
      ]
    },
    {
      "id": "b-126",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "articles:"
        }
      ]
    },
    {
      "id": "b-127",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- kind: copy"
        }
      ]
    },
    {
      "id": "b-128",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "data:"
        }
      ]
    },
    {
      "id": "b-129",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pre: \"Proven Model\""
        }
      ]
    },
    {
      "id": "b-130",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "preColor: \"text-[#007c7e]\""
        }
      ]
    },
    {
      "id": "b-131",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title: \"Inspired by a model pioneered in Portland\""
        }
      ]
    },
    {
      "id": "b-132",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "titleColor: \"text-[#2c324e]\""
        }
      ]
    },
    {
      "id": "b-133",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "paragraphs:"
        }
      ]
    },
    {
      "id": "b-134",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "- \"Invest York Road adapts a successful community investment trust…\""
        }
      ]
    },
    {
      "id": "b-135",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "offsets:"
        }
      ]
    },
    {
      "id": "b-136",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "mobileBottomDvh: 150"
        }
      ]
    },
    {
      "id": "b-137",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-138",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Why this DSL works"
        }
      ]
    },
    {
      "id": "b-144",
      "type": "bulletList",
      "children": [
        {
          "id": "b-139",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Kind-first** visuals (`logo`, `image.hero`, `video.hero`, `map.gl`, `chart.*`, `custom`) let you swap implementations per project without touching content."
            }
          ]
        },
        {
          "id": "b-140",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Actions** are declarative (`media.play`, `map.ensureVisible`, `viz.setRevealCount`, `theme.setToken`)—no inline JS."
            }
          ]
        },
        {
          "id": "b-141",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Assets** support variables/interpolation for reuse."
            }
          ]
        },
        {
          "id": "b-142",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Offsets** use DVH where helpful; sensible story-level defaults reduce boilerplate."
            }
          ]
        },
        {
          "id": "b-143",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**A11y baked in**: `a11y.alt`, `tracks` for captions, copy blocks are always semantic."
            }
          ]
        }
      ]
    },
    {
      "id": "b-145",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-146",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-147",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// dsl/types.ts"
        }
      ]
    },
    {
      "id": "b-148",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type Color = string;"
        }
      ]
    },
    {
      "id": "b-149",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type Dvh = number;"
        }
      ]
    },
    {
      "id": "b-150",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface StoryDoc {"
        }
      ]
    },
    {
      "id": "b-151",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "story: { id: string; title?: string; theme?: { tokens?: Record<string, string> } };"
        }
      ]
    },
    {
      "id": "b-152",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "assets?: Record<string, string>;"
        }
      ]
    },
    {
      "id": "b-153",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "layout?: {"
        }
      ]
    },
    {
      "id": "b-154",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "defaultOffsets?: { topDvh?: Dvh; bottomDvh?: Dvh };"
        }
      ]
    },
    {
      "id": "b-155",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "devices?: Array<'phone'|'tablet'|'laptop'|'desktop'>;"
        }
      ]
    },
    {
      "id": "b-156",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "persist?: Partial<Record<'form'|'tokens'|'order', 'local'|'session'|'none'>>;"
        }
      ]
    },
    {
      "id": "b-157",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-158",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "scenes: SceneDoc[];"
        }
      ]
    },
    {
      "id": "b-159",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-160",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface SceneDoc {"
        }
      ]
    },
    {
      "id": "b-161",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "key: string;"
        }
      ]
    },
    {
      "id": "b-162",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "visual: VisualDoc;"
        }
      ]
    },
    {
      "id": "b-163",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "articles?: ArticleDoc[];"
        }
      ]
    },
    {
      "id": "b-164",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-165",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface VisualDoc {"
        }
      ]
    },
    {
      "id": "b-166",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "kind: string;         // e.g., 'video.hero', 'map.gl', 'image.hero', 'custom:MyViz'"
        }
      ]
    },
    {
      "id": "b-167",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "ref?: string;         // for action targets"
        }
      ]
    },
    {
      "id": "b-168",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "props?: Record<string, any>;"
        }
      ]
    },
    {
      "id": "b-169",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "a11y?: { alt?: string; label?: string };"
        }
      ]
    },
    {
      "id": "b-170",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "actions?: ActionDoc[];"
        }
      ]
    },
    {
      "id": "b-171",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "slots?: Record<string, string>; // optional HTML slots for viz"
        }
      ]
    },
    {
      "id": "b-172",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-173",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface ActionDoc {"
        }
      ]
    },
    {
      "id": "b-174",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "on: 'enter'|'exit'|'step'|'mount'|'unmount';"
        }
      ]
    },
    {
      "id": "b-175",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "whenStepEq?: number;"
        }
      ]
    },
    {
      "id": "b-176",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "do:"
        }
      ]
    },
    {
      "id": "b-177",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'media.play' | 'media.pause' | 'media.reset' | 'media.maybePlay'"
        }
      ]
    },
    {
      "id": "b-178",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'map.ensureVisible' | 'map.setFocus' | 'viz.setRevealCount'"
        }
      ]
    },
    {
      "id": "b-179",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| 'theme.setToken';"
        }
      ]
    },
    {
      "id": "b-180",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "target?: string;  // e.g., \"@v1\" or implicit visual"
        }
      ]
    },
    {
      "id": "b-181",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "args?: any;"
        }
      ]
    },
    {
      "id": "b-182",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-183",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type ArticleDoc ="
        }
      ]
    },
    {
      "id": "b-184",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| { kind: 'copy'; align?: 'left'|'right'|'center'; html?: string; data?: any; triggerCenterFraction?: number; offsets?: Offsets }"
        }
      ]
    },
    {
      "id": "b-185",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| { kind: 'quote'; data: { quoteHtml: string; author?: string; animate?: boolean }; offsets?: Offsets }"
        }
      ]
    },
    {
      "id": "b-186",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| { kind: 'stats'; data: { items: Array<any>; layout?: 'row'|'grid' }; offsets?: Offsets }"
        }
      ]
    },
    {
      "id": "b-187",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "| { kind: 'component'; component: string; props?: Record<string, any>; offsets?: Offsets };"
        }
      ]
    },
    {
      "id": "b-188",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface Offsets {"
        }
      ]
    },
    {
      "id": "b-189",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "topDvh?: Dvh; bottomDvh?: Dvh;"
        }
      ]
    },
    {
      "id": "b-190",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "mobileTopDvh?: Dvh; mobileBottomDvh?: Dvh; mobileMinHeightDvh?: Dvh;"
        }
      ]
    },
    {
      "id": "b-191",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-192",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-193",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Validation:** Parse YAML → JSON → validate with Zod (1 error per path, helpful messages)."
        }
      ]
    },
    {
      "id": "b-194",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Compilation:** `compileStory(story: StoryDoc, registry: KindRegistry): SceneSpec[]`"
        }
      ]
    },
    {
      "id": "b-195",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "`KindRegistry` maps `kind` strings to concrete Vue components and prop transformers."
        }
      ]
    },
    {
      "id": "b-196",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-197",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface KindRegistry {"
        }
      ]
    },
    {
      "id": "b-198",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "visual: Record<string, (doc: VisualDoc) => { component: any; props: any }>;"
        }
      ]
    },
    {
      "id": "b-199",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "article: Record<string, (doc: ArticleDoc) => { component?: any; componentProps?: any; html?: string }>;"
        }
      ]
    },
    {
      "id": "b-200",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "actions: Record<ActionDoc['do'], (ctx: any, action: ActionDoc) => void>;"
        }
      ]
    },
    {
      "id": "b-201",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-202",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-203",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-204",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Great for teams who want autocomplete and refactoring."
        }
      ]
    },
    {
      "id": "b-205",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-206",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// dsl/builder.ts"
        }
      ]
    },
    {
      "id": "b-207",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type { StoryDoc, SceneDoc } from './types';"
        }
      ]
    },
    {
      "id": "b-208",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const story = (id: string) => {"
        }
      ]
    },
    {
      "id": "b-209",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const s: StoryDoc = { story: { id }, scenes: [] };"
        }
      ]
    },
    {
      "id": "b-210",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const api = {"
        }
      ]
    },
    {
      "id": "b-211",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title(t: string) { s.story.title = t; return api; },"
        }
      ]
    },
    {
      "id": "b-212",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tokens(t: Record<string,string>) { s.story.theme ??= {}; s.story.theme.tokens = t; return api; },"
        }
      ]
    },
    {
      "id": "b-213",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "assets(a: Record<string,string>) { s.assets = a; return api; },"
        }
      ]
    },
    {
      "id": "b-214",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "scene(sc: SceneDoc) { s.scenes.push(sc); return api; },"
        }
      ]
    },
    {
      "id": "b-215",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "build(): StoryDoc { return s; },"
        }
      ]
    },
    {
      "id": "b-216",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-217",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return api;"
        }
      ]
    },
    {
      "id": "b-218",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-219",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const scene = (key: string) => {"
        }
      ]
    },
    {
      "id": "b-220",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const sc: SceneDoc = { key, visual: { kind: 'custom', props: {} } };"
        }
      ]
    },
    {
      "id": "b-221",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return {"
        }
