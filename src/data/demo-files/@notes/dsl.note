          "type": "text",
          "text": "articles(...arts: SceneDoc['articles'] extends infer A ? A[] : any[]) {"
        }
      ]
    },
    {
      "id": "b-230",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sc.articles = arts as any; return this;"
        }
      ]
    },
