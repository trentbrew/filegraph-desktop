    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "<p class=\"text-2xl text-[#2c324e] pt-2\">Let's Make York Road <span class=\"text-[#f4b000] font-bold\">Yours</span>!</p>"
        }
