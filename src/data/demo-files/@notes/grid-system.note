  "title": "Grid System",
  "author": "person:design-team:001",
  "status": "draft",
  "blocks": [
    {
      "id": "b-1",
      "type": "heading",
      "level": 1,
      "content": [
        {
          "type": "text",
          "text": "Grid System"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "Overview"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid Layout Language (GLL) is a high-level, human-readable notation system for describing grid-based layouts. It provides a compact syntax for defining both the structure and composition of grid layouts across different contexts."
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "1. Core Syntax"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "1.1 Basic Grid Declaration"
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[cols×rows] {"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// regions defined here"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "bulletList",
      "children": [
        {
          "id": "b-12",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`cols`: Number of columns (integer or 'auto')"
            }
          ]
        },
        {
          "id": "b-13",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`rows`: Number of rows (integer or 'auto')"
            }
          ]
        },
        {
          "id": "b-14",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "`auto`: Dynamically sized based on content"
            }
          ]
        }
      ]
    },
    {
      "id": "b-16",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Examples:**"
        }
      ]
    },
    {
      "id": "b-17",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[12×8]      // 12 columns, 8 rows"
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[4×auto]    // 4 columns, auto rows"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[auto×auto] // Fully dynamic grid"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "1.2 Region Definition"
        }
      ]
    },
    {
      "id": "b-23",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Regions are named areas within the grid:"
        }
      ]
    },
    {
      "id": "b-24",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-25",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "region_name: [col_start-col_end, row_start-row_end]"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-30",
      "type": "bulletList",
      "children": [
        {
          "id": "b-27",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Indices are 1-based (following design convention)"
            }
          ]
        },
        {
          "id": "b-28",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Ranges are inclusive on both ends"
            }
          ]
        },
        {
          "id": "b-29",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Multiple regions can overlap (for layering effects)"
            }
          ]
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Example:**"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[12×6] {"
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "header: [1-12, 1-2]"
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sidebar: [1-3, 3-6]"
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "main: [4-12, 3-6]"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
      "id": "b-40",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "2. Advanced Region Syntax"
        }
      ]
    },
    {
      "id": "b-41",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "2.1 Span Notation"
        }
      ]
    },
    {
      "id": "b-42",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Alternative syntax using span instead of explicit ranges:"
        }
      ]
    },
    {
      "id": "b-43",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-44",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "region_name: span(cols, rows) at [col, row]"
        }
      ]
    },
    {
      "id": "b-45",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "region_name: span(cols, rows)  // auto-placed"
        }
      ]
    },
    {
      "id": "b-46",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Example:**"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[12×6] {"
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "header: span(12, 2) at [1, 1]"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sidebar: span(3, 4) at [1, 3]"
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "main: span(9, 4)  // auto-placed after sidebar"
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-55",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "2.2 Named Grid Lines"
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Define named lines for semantic reference:"
        }
      ]
    },
    {
      "id": "b-57",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-58",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[12×6] {"
        }
      ]
    },
    {
      "id": "b-59",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "lines: {"
        }
      ]
    },
    {
      "id": "b-60",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "col: [start, content-start, content-end, end]"
        }
      ]
    },
    {
      "id": "b-61",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "row: [top, header-end, footer-start, bottom]"
        }
      ]
    },
    {
      "id": "b-62",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-63",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "header: [start-content-end, top-header-end]"
        }
      ]
    },
    {
      "id": "b-64",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "main: [content-start-content-end, header-end-footer-start]"
        }
      ]
    },
    {
      "id": "b-65",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-66",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-67",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "2.3 Region Properties"
        }
      ]
    },
    {
      "id": "b-68",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Regions can have additional properties:"
        }
      ]
    },
    {
      "id": "b-69",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-70",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "region_name: [col_start-col_end, row_start-row_end] {"
        }
      ]
    },
    {
      "id": "b-71",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "align: start | center | end | stretch"
        }
      ]
    },
    {
      "id": "b-72",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "justify: start | center | end | stretch"
        }
      ]
    },
    {
      "id": "b-73",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "z-index: integer"
        }
      ]
    },
    {
      "id": "b-74",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "flow: row | column | dense"
        }
      ]
    },
    {
      "id": "b-75",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-76",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-77",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Example:**"
        }
      ]
    },
    {
      "id": "b-78",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-79",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[12×8] {"
        }
      ]
    },
    {
      "id": "b-80",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "hero: [1-12, 1-6] {"
