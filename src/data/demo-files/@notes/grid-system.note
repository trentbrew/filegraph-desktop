    {
      "id": "b-111",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "4. Responsive Layouts"
        }
      ]
    },
    {
      "id": "b-112",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "4.1 Breakpoint System"
        }
      ]
    },
    {
      "id": "b-113",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-114",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Layout {"
        }
      ]
    },
    {
      "id": "b-115",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "breakpoints: {"
