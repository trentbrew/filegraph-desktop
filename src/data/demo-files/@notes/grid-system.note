          "type": "text",
          "text": "3.1 Spacing & Sizing"
        }
      ]
    },
    {
      "id": "b-92",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-93",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Grid[12×6] {"
        }
      ]
    },
    {
      "id": "b-94",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "margin: 24px"
