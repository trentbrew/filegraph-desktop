          "type": "text",
          "text": "overlay: [4-9, 3-5] {"
        }
      ]
    },
    {
      "id": "b-85",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "z-index: 10"
        }
      ]
    },
    {
      "id": "b-86",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
