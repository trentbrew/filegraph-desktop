          "text": "\"\"\"Reconstruct matrix from compressed block representation\"\"\""
        }
      ]
    },
    {
      "id": "b-120",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "matrix = [[0 for _ in range(width)] for _ in range(height)]"
