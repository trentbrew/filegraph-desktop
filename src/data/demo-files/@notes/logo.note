      ]
    },
    {
      "id": "b-137",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "print(f\"\\nMatches original: {expanded == original}\")"
        }
      ]
    },
    {
      "id": "b-138",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "original_storage = 10 * 10  # 100 elements"
