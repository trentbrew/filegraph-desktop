    {
      "id": "b-3",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "This Agreement is between Sample User, Matthew Manning, and Rebecca Smith (collectively referred to as the \"Partners\"), for the project scope of [Docket.tv](http://docket.tv/), a web app aiming to revolutionize the way broadcasters connect with their audience through a user-friendly, customizable TV Guide CMS."
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "---"
        }
      ]
    },
    {
