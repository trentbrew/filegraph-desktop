          "type": "text",
          "text": "public getTool(name: string): Tool | undefined {"
        }
      ]
    },
    {
      "id": "b-651",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this.tools.get(name);"
        }
      ]
    },
    {
      "id": "b-652",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
