          "type": "text",
          "text": "vector_store: VectorStore"
        }
      ]
    },
    {
      "id": "b-108",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-109",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The real power comes from combining these with Neo4j for persistent storage:"
        }
      ]
    },
