          "text": "metadata: Record<string, unknown>;"
        }
      ]
    },
    {
      "id": "b-300",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-301",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-302",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Now let's create our base agent class that will be extended by specific agent types:"
        }
      ]
    },
    {
      "id": "b-303",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-304",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { RunnableSequence } from '@langchain/core/runnables';"
        }
      ]
    },
    {
      "id": "b-305",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { BaseMessage } from '@langchain/core/messages';"
        }
      ]
    },
    {
      "id": "b-306",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { Tool } from '@langchain/core/tools';"
        }
      ]
    },
    {
      "id": "b-307",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import {"
        }
      ]
    },
    {
      "id": "b-308",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AgentRole,"
        }
      ]
    },
    {
      "id": "b-309",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AgentState,"
        }
      ]
    },
    {
      "id": "b-310",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AgentContext,"
        }
      ]
    },
    {
      "id": "b-311",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AgentMessage,"
        }
      ]
    },
    {
      "id": "b-312",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "AgentAction,"
        }
      ]
    },
    {
      "id": "b-313",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Channel,"
        }
      ]
    },
    {
      "id": "b-314",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Thread"
        }
      ]
    },
    {
      "id": "b-315",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} from './types/base';"
        }
      ]
    },
    {
      "id": "b-316",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export class BaseAgent {"
        }
      ]
    },
    {
      "id": "b-317",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "protected state: AgentState;"
        }
      ]
    },
    {
      "id": "b-318",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "protected tools: Map<string, Tool>;"
        }
      ]
    },
    {
      "id": "b-319",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "protected chain: RunnableSequence;"
        }
      ]
    },
    {
      "id": "b-320",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "constructor(role: AgentRole) {"
        }
      ]
    },
    {
      "id": "b-321",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state = this.initializeState(role);"
        }
      ]
    },
    {
      "id": "b-322",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.tools = new Map();"
        }
      ]
    },
    {
      "id": "b-323",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.chain = this.createChain();"
        }
      ]
    },
    {
      "id": "b-324",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-325",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "protected initializeState(role: AgentRole): AgentState {"
        }
      ]
    },
    {
      "id": "b-326",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const context: AgentContext = {"
        }
      ]
    },
    {
      "id": "b-327",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "role,"
        }
      ]
    },
    {
      "id": "b-328",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tools: new Map(),"
        }
      ]
    },
    {
      "id": "b-329",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "memory: new Map(),"
        }
      ]
    },
    {
      "id": "b-330",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "channels: new Map(),"
        }
      ]
    },
    {
      "id": "b-331",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "threads: new Map()"
        }
      ]
    },
    {
      "id": "b-332",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-333",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return {"
        }
      ]
    },
    {
      "id": "b-334",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "context,"
        }
      ]
    },
    {
      "id": "b-335",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "messages: [],"
        }
      ]
    },
    {
      "id": "b-336",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "actions: [],"
        }
      ]
    },
    {
      "id": "b-337",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata: {}"
        }
      ]
    },
    {
      "id": "b-338",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-339",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-340",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "protected createChain(): RunnableSequence {"
        }
      ]
    },
    {
      "id": "b-341",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Implement in specific agent types"
        }
      ]
    },
    {
      "id": "b-342",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error('createChain must be implemented by specific agent types');"
        }
      ]
    },
    {
      "id": "b-343",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-344",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async processMessage(message: AgentMessage): Promise<AgentMessage> {"
        }
      ]
    },
    {
      "id": "b-345",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Add message to state"
        }
      ]
    },
    {
      "id": "b-346",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.messages.push(message);"
        }
      ]
    },
    {
      "id": "b-347",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Process through chain"
        }
      ]
    },
    {
      "id": "b-348",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const result = await this.chain.invoke({"
        }
      ]
    },
    {
      "id": "b-349",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "messages: this.state.messages,"
        }
      ]
    },
    {
      "id": "b-350",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tools: Array.from(this.tools.values()),"
        }
      ]
    },
    {
      "id": "b-351",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "context: this.state.context"
        }
      ]
    },
    {
      "id": "b-352",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-353",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Create response message"
        }
      ]
    },
    {
      "id": "b-354",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const response: AgentMessage = {"
        }
      ]
    },
    {
      "id": "b-355",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: crypto.randomUUID(),"
        }
      ]
    },
    {
      "id": "b-356",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "content: result.output,"
        }
      ]
    },
    {
      "id": "b-357",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "role: 'agent',"
        }
      ]
    },
    {
      "id": "b-358",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sender: this.state.context.role.name,"
        }
      ]
    },
    {
      "id": "b-359",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "timestamp: new Date().toISOString(),"
        }
      ]
    },
    {
      "id": "b-360",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "channelId: message.channelId,"
        }
      ]
    },
    {
      "id": "b-361",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "threadId: message.threadId,"
        }
      ]
    },
    {
      "id": "b-362",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata: result.metadata"
        }
      ]
    },
    {
      "id": "b-363",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-364",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Add response to state"
        }
      ]
    },
    {
      "id": "b-365",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.messages.push(response);"
        }
      ]
    },
    {
      "id": "b-366",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return response;"
        }
      ]
    },
    {
      "id": "b-367",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-368",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async executeAction(action: AgentAction): Promise<unknown> {"
        }
      ]
    },
    {
      "id": "b-369",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Add action to state"
        }
      ]
    },
    {
      "id": "b-370",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.actions.push(action);"
        }
      ]
    },
    {
      "id": "b-371",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Execute based on action type"
        }
      ]
    },
    {
      "id": "b-372",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "switch (action.type) {"
        }
      ]
    },
    {
      "id": "b-373",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "case 'message':"
        }
      ]
    },
    {
      "id": "b-374",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this.processMessage(action.payload as AgentMessage);"
        }
      ]
    },
    {
      "id": "b-375",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "case 'tool':"
        }
      ]
    },
    {
      "id": "b-376",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const tool = this.tools.get(action.payload as string);"
        }
      ]
    },
    {
      "id": "b-377",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!tool) throw new Error(`Tool not found: ${action.payload}`);"
        }
      ]
    },
    {
      "id": "b-378",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return tool.invoke(action.metadata || {});"
        }
      ]
    },
    {
      "id": "b-379",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "case 'state':"
        }
      ]
    },
    {
      "id": "b-380",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this.updateState(action.payload as Partial<AgentState>);"
        }
      ]
    },
    {
      "id": "b-381",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "default:"
        }
      ]
    },
    {
      "id": "b-382",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error(`Unknown action type: ${action.type}`);"
        }
      ]
    },
    {
      "id": "b-383",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-384",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-385",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "protected async updateState(update: Partial<AgentState>): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-386",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state = {"
        }
      ]
    },
    {
      "id": "b-387",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "...this.state,"
        }
      ]
    },
    {
      "id": "b-388",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "...update,"
        }
      ]
    },
    {
      "id": "b-389",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata: {"
        }
      ]
    },
    {
      "id": "b-390",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "...this.state.metadata,"
        }
      ]
    },
    {
      "id": "b-391",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "...update.metadata"
        }
      ]
    },
    {
      "id": "b-392",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-393",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "};"
        }
      ]
    },
    {
      "id": "b-394",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-395",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Channel management"
        }
      ]
    },
    {
      "id": "b-396",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async joinChannel(channel: Channel): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-397",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.context.channels.set(channel.id, channel);"
        }
      ]
    },
    {
      "id": "b-398",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-399",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async leaveChannel(channelId: string): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-400",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.context.channels.delete(channelId);"
        }
      ]
    },
    {
      "id": "b-401",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-402",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Thread management"
        }
      ]
    },
    {
      "id": "b-403",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async joinThread(thread: Thread): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-404",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.context.threads.set(thread.id, thread);"
        }
      ]
    },
    {
      "id": "b-405",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-406",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async leaveThread(threadId: string): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-407",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.context.threads.delete(threadId);"
        }
      ]
    },
    {
      "id": "b-408",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-409",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Tool management"
        }
      ]
    },
    {
      "id": "b-410",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public registerTool(tool: Tool): void {"
        }
      ]
    },
    {
      "id": "b-411",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.tools.set(tool.name, tool);"
        }
      ]
    },
    {
      "id": "b-412",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-413",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public removeTool(toolName: string): void {"
        }
      ]
    },
    {
      "id": "b-414",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.tools.delete(toolName);"
        }
      ]
    },
    {
      "id": "b-415",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-416",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Memory management"
        }
      ]
    },
    {
      "id": "b-417",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async remember(key: string, value: unknown): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-418",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.context.memory.set(key, value);"
        }
      ]
    },
    {
      "id": "b-419",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-420",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async recall(key: string): Promise<unknown> {"
        }
      ]
    },
    {
      "id": "b-421",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this.state.context.memory.get(key);"
        }
      ]
    },
    {
      "id": "b-422",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-423",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async forget(key: string): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-424",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.state.context.memory.delete(key);"
        }
      ]
    },
    {
      "id": "b-425",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-426",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-427",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-428",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Now let's create a specific agent type as an example - the Research Agent:"
        }
      ]
    },
    {
      "id": "b-429",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-430",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { RunnableSequence } from '@langchain/core/runnables';"
        }
      ]
    },
    {
      "id": "b-431",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { PromptTemplate } from '@langchain/core/prompts';"
        }
      ]
    },
    {
      "id": "b-432",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { StringOutputParser } from '@langchain/core/output_parsers';"
        }
      ]
    },
    {
      "id": "b-433",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { ChatOpenAI } from '@langchain/openai';"
        }
      ]
    },
    {
      "id": "b-434",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { Tool } from '@langchain/core/tools';"
        }
      ]
    },
    {
      "id": "b-435",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { BaseAgent } from './base-agent';"
        }
      ]
    },
    {
      "id": "b-436",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { AgentRole } from './types/base';"
        }
      ]
    },
    {
      "id": "b-437",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export class ResearchAgent extends BaseAgent {"
        }
      ]
    },
    {
      "id": "b-438",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "constructor() {"
        }
      ]
    },
    {
      "id": "b-439",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const role: AgentRole = {"
        }
      ]
    },
    {
      "id": "b-440",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: 'Research Agent',"
        }
      ]
    },
    {
      "id": "b-441",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "description: 'A specialized agent for conducting research and analysis',"
        }
      ]
    },
    {
      "id": "b-442",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "goals: ["
        }
      ]
    },
    {
      "id": "b-443",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'Conduct thorough research on given topics',"
        }
      ]
    },
    {
      "id": "b-444",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'Analyze and synthesize information',"
        }
      ]
    },
    {
      "id": "b-445",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'Identify patterns and insights',"
        }
      ]
    },
    {
      "id": "b-446",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'Generate comprehensive reports',"
        }
      ]
    },
    {
      "id": "b-447",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'Collaborate with other agents for deeper insights'"
        }
      ]
    },
    {
      "id": "b-448",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-449",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tools: ["
        }
      ]
    },
    {
      "id": "b-450",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'web_search',"
        }
      ]
    },
    {
      "id": "b-451",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'document_loader',"
        }
      ]
    },
    {
      "id": "b-452",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'pdf_reader',"
        }
      ]
    },
    {
      "id": "b-453",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'note_taker',"
        }
      ]
    },
    {
      "id": "b-454",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'citation_manager'"
        }
      ]
    },
    {
      "id": "b-455",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "],"
        }
      ]
    },
    {
      "id": "b-456",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "traits: ["
        }
      ]
    },
    {
      "id": "b-457",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'analytical',"
        }
      ]
    },
    {
      "id": "b-458",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "'thorough',"
        }
      ]
    },
    {
      "id": "b-459",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
