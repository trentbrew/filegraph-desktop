    },
    {
      "id": "b-568",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Let's fix the missing dependency first:"
        }
      ]
    },
    {
      "id": "b-569",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```bash"
        }
      ]
    },
    {
      "id": "b-570",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "pnpm add @langchain/openai"
        }
      ]
    },
    {
      "id": "b-571",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-572",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Now let's create a tool service to manage our agent tools:"
        }
      ]
    },
    {
      "id": "b-573",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-574",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { Tool } from '@langchain/core/tools';"
        }
      ]
