        {
          "type": "text",
          "text": "threadId?: string;"
        }
      ]
    },
    {
      "id": "b-288",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata?: Record<string, unknown>;"
        }
