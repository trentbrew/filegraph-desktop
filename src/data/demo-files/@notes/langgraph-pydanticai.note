          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-803",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Now let's create an agent factory to manage agent creation and initialization:"
        }
      ]
    },
    {
      "id": "b-804",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-805",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { BaseAgent } from './base-agent';"
        }
      ]
    },
    {
      "id": "b-806",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { ResearchAgent } from './research-agent';"
        }
      ]
    },
    {
      "id": "b-807",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { ToolService } from './tools/tool-service';"
        }
      ]
    },
    {
      "id": "b-808",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { ChannelService } from './channels/channel-service';"
        }
      ]
    },
    {
      "id": "b-809",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type { AgentRole } from './types/base';"
        }
      ]
    },
    {
      "id": "b-810",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export class AgentFactory {"
        }
      ]
    },
    {
      "id": "b-811",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "private toolService: ToolService;"
        }
      ]
    },
    {
      "id": "b-812",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "private channelService: ChannelService;"
        }
      ]
    },
    {
      "id": "b-813",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "private agents: Map<string, BaseAgent>;"
        }
      ]
    },
    {
      "id": "b-814",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "constructor() {"
        }
      ]
    },
    {
      "id": "b-815",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.toolService = new ToolService();"
        }
      ]
    },
    {
      "id": "b-816",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.channelService = new ChannelService();"
        }
      ]
    },
    {
      "id": "b-817",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.agents = new Map();"
        }
      ]
    },
    {
      "id": "b-818",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-819",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public createAgent(role: AgentRole): BaseAgent {"
        }
      ]
    },
    {
      "id": "b-820",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "let agent: BaseAgent;"
        }
      ]
    },
    {
      "id": "b-821",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "switch (role.name.toLowerCase()) {"
        }
      ]
    },
    {
      "id": "b-822",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "case 'research agent':"
        }
      ]
    },
    {
      "id": "b-823",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "agent = new ResearchAgent();"
        }
      ]
    },
    {
      "id": "b-824",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "break;"
        }
      ]
    },
    {
      "id": "b-825",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Add more agent types here"
        }
      ]
    },
    {
      "id": "b-826",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "default:"
        }
      ]
    },
    {
      "id": "b-827",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error(`Unknown agent type: ${role.name}`);"
        }
      ]
    },
    {
      "id": "b-828",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-829",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Register required tools"
        }
      ]
    },
    {
      "id": "b-830",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "role.tools.forEach(toolName => {"
        }
      ]
    },
    {
      "id": "b-831",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const tool = this.toolService.getTool(toolName);"
        }
      ]
    },
    {
      "id": "b-832",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (tool) {"
        }
      ]
    },
    {
      "id": "b-833",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "agent.registerTool(tool);"
        }
      ]
    },
    {
      "id": "b-834",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-835",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-836",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Add to default channels"
        }
      ]
    },
    {
      "id": "b-837",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.channelService.addMemberToChannel('general', role.name);"
        }
      ]
    },
    {
      "id": "b-838",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Add to role-specific channels"
        }
      ]
    },
    {
      "id": "b-839",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "switch (role.name.toLowerCase()) {"
        }
      ]
    },
    {
      "id": "b-840",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "case 'research agent':"
        }
      ]
    },
    {
      "id": "b-841",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.channelService.addMemberToChannel('research', role.name);"
        }
      ]
    },
    {
      "id": "b-842",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "break;"
        }
      ]
    },
    {
      "id": "b-843",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Add more channel assignments here"
        }
      ]
    },
    {
      "id": "b-844",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-845",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Store agent instance"
        }
      ]
    },
    {
      "id": "b-846",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.agents.set(role.name, agent);"
        }
      ]
    },
    {
      "id": "b-847",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return agent;"
        }
      ]
    },
    {
      "id": "b-848",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-849",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public getAgent(name: string): BaseAgent | undefined {"
        }
      ]
    },
    {
      "id": "b-850",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this.agents.get(name);"
        }
      ]
    },
    {
      "id": "b-851",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-852",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public listAgents(): BaseAgent[] {"
        }
      ]
    },
    {
      "id": "b-853",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return Array.from(this.agents.values());"
        }
      ]
    },
    {
      "id": "b-854",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-855",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public removeAgent(name: string): void {"
        }
      ]
    },
    {
      "id": "b-856",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const agent = this.agents.get(name);"
        }
      ]
    },
    {
      "id": "b-857",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!agent) return;"
        }
      ]
    },
    {
      "id": "b-858",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Remove from channels"
        }
      ]
    },
    {
      "id": "b-859",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.channelService.listChannels().forEach(channel => {"
        }
      ]
    },
    {
      "id": "b-860",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (channel.members.includes(name)) {"
        }
      ]
    },
    {
      "id": "b-861",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.channelService.removeMemberFromChannel(channel.id, name);"
        }
      ]
    },
    {
      "id": "b-862",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-863",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-864",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Remove from threads"
        }
      ]
    },
    {
      "id": "b-865",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// TODO: Implement thread cleanup"
        }
      ]
    },
    {
      "id": "b-866",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Remove agent instance"
        }
      ]
    },
    {
      "id": "b-867",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.agents.delete(name);"
        }
      ]
    },
    {
      "id": "b-868",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-869",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Utility methods for agent management"
        }
      ]
    },
    {
      "id": "b-870",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async broadcastToChannel(channelId: string, content: string): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-871",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const channel = this.channelService.getChannel(channelId);"
        }
      ]
    },
    {
      "id": "b-872",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!channel) {"
        }
      ]
    },
    {
      "id": "b-873",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error(`Channel not found: ${channelId}`);"
        }
      ]
    },
    {
      "id": "b-874",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-875",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Process message through each agent in the channel"
        }
      ]
    },
    {
      "id": "b-876",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const processPromises = channel.members.map(async memberName => {"
        }
      ]
    },
    {
      "id": "b-877",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const agent = this.agents.get(memberName);"
        }
      ]
    },
    {
      "id": "b-878",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (agent) {"
        }
      ]
    },
    {
      "id": "b-879",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await agent.processMessage({"
        }
      ]
    },
    {
      "id": "b-880",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: crypto.randomUUID(),"
        }
      ]
    },
    {
      "id": "b-881",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "content,"
        }
      ]
    },
    {
      "id": "b-882",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "role: 'system',"
        }
      ]
    },
    {
      "id": "b-883",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sender: 'system',"
        }
      ]
    },
    {
      "id": "b-884",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "timestamp: new Date().toISOString(),"
        }
      ]
    },
    {
      "id": "b-885",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "channelId"
        }
      ]
    },
    {
      "id": "b-886",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-887",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-888",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-889",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await Promise.all(processPromises);"
        }
      ]
    },
    {
      "id": "b-890",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-891",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async createCollaboration("
        }
      ]
    },
    {
      "id": "b-892",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "initiatorName: string,"
        }
      ]
    },
    {
      "id": "b-893",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "collaboratorNames: string[],"
        }
      ]
    },
    {
      "id": "b-894",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "topic: string"
        }
      ]
    },
    {
      "id": "b-895",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "): Promise<string> {"
        }
      ]
    },
    {
      "id": "b-896",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const initiator = this.agents.get(initiatorName);"
        }
      ]
    },
    {
      "id": "b-897",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!initiator) {"
        }
      ]
    },
    {
      "id": "b-898",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error(`Initiator agent not found: ${initiatorName}`);"
        }
      ]
    },
    {
      "id": "b-899",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-900",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Create a new thread in the general channel"
        }
      ]
    },
    {
      "id": "b-901",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const thread = this.channelService.createThread('general', {"
        }
      ]
    },
    {
      "id": "b-902",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: crypto.randomUUID(),"
        }
      ]
    },
    {
      "id": "b-903",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title: `Collaboration: ${topic}`,"
        }
      ]
    },
    {
      "id": "b-904",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "status: 'active',"
        }
      ]
    },
    {
      "id": "b-905",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participants: [initiatorName, ...collaboratorNames]"
        }
      ]
    },
    {
      "id": "b-906",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-907",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Send initial message"
        }
      ]
    },
    {
      "id": "b-908",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await initiator.processMessage({"
        }
      ]
    },
    {
      "id": "b-909",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: crypto.randomUUID(),"
        }
      ]
    },
    {
      "id": "b-910",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "content: `Starting collaboration on: ${topic}`,"
        }
      ]
    },
    {
      "id": "b-911",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "role: 'system',"
        }
      ]
    },
    {
      "id": "b-912",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sender: 'system',"
        }
      ]
    },
    {
      "id": "b-913",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "timestamp: new Date().toISOString(),"
        }
      ]
    },
    {
      "id": "b-914",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "channelId: 'general',"
        }
      ]
    },
    {
      "id": "b-915",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "threadId: thread.id"
        }
      ]
    },
    {
      "id": "b-916",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-917",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return thread.id;"
        }
      ]
    },
    {
      "id": "b-918",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-919",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Getters for services"
        }
      ]
    },
    {
      "id": "b-920",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public getToolService(): ToolService {"
        }
      ]
    },
    {
      "id": "b-921",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this.toolService;"
        }
      ]
    },
    {
      "id": "b-922",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-923",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public getChannelService(): ChannelService {"
        }
      ]
    },
    {
      "id": "b-924",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "return this.channelService;"
        }
      ]
    },
    {
      "id": "b-925",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-926",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-927",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-928",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Let me fix the type issues in our base types file first:"
        }
      ]
    },
    {
      "id": "b-929",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-930",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { z } from 'zod';"
        }
      ]
    },
    {
      "id": "b-931",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type { Tool } from '@langchain/core/tools';"
        }
      ]
    },
    {
      "id": "b-932",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import type { BaseMessage } from '@langchain/core/messages';"
        }
      ]
    },
    {
      "id": "b-933",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Base schemas for our agent system"
        }
      ]
    },
    {
      "id": "b-934",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const AgentRoleSchema = z.object({"
        }
      ]
    },
    {
      "id": "b-935",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: z.string(),"
        }
      ]
    },
    {
      "id": "b-936",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "description: z.string(),"
        }
      ]
    },
    {
      "id": "b-937",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "goals: z.array(z.string()),"
        }
      ]
    },
    {
      "id": "b-938",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tools: z.array(z.string()),"
        }
      ]
    },
    {
      "id": "b-939",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "traits: z.array(z.string()),"
        }
      ]
    },
    {
      "id": "b-940",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "memory: z.record(z.unknown()).optional(),"
        }
      ]
    },
    {
      "id": "b-941",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-942",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const MessageSchema = z.object({"
        }
      ]
    },
    {
      "id": "b-943",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: z.string(),"
        }
      ]
    },
    {
      "id": "b-944",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "content: z.string(),"
        }
      ]
    },
    {
      "id": "b-945",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "role: z.enum(['user', 'agent', 'system']),"
        }
      ]
    },
    {
      "id": "b-946",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sender: z.string(),"
        }
      ]
    },
    {
      "id": "b-947",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "timestamp: z.string(),"
        }
      ]
    },
    {
      "id": "b-948",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "channelId: z.string().optional(),"
        }
      ]
    },
    {
      "id": "b-949",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "threadId: z.string().optional(),"
        }
      ]
    },
    {
      "id": "b-950",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata: z.record(z.unknown()).optional(),"
        }
      ]
    },
    {
      "id": "b-951",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-952",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const ChannelSchema = z.object({"
        }
      ]
    },
    {
      "id": "b-953",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: z.string(),"
        }
      ]
    },
    {
      "id": "b-954",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "name: z.string(),"
        }
      ]
    },
    {
      "id": "b-955",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "description: z.string(),"
        }
      ]
    },
    {
      "id": "b-956",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "members: z.array(z.string()),"
        }
      ]
    },
    {
      "id": "b-957",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "isPrivate: z.boolean().default(false),"
        }
      ]
    },
    {
      "id": "b-958",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata: z.record(z.unknown()).optional(),"
        }
      ]
    },
    {
      "id": "b-959",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-960",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export const ThreadSchema = z.object({"
        }
      ]
    },
    {
      "id": "b-961",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: z.string(),"
        }
      ]
    },
    {
      "id": "b-962",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "channelId: z.string(),"
        }
      ]
    },
    {
      "id": "b-963",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "title: z.string(),"
        }
      ]
    },
    {
      "id": "b-964",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "status: z.enum(['active', 'archived', 'resolved']),"
        }
      ]
    },
    {
      "id": "b-965",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "participants: z.array(z.string()),"
        }
      ]
    },
    {
      "id": "b-966",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata: z.record(z.unknown()).optional(),"
        }
      ]
    },
    {
      "id": "b-967",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-968",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Type definitions"
        }
      ]
    },
    {
      "id": "b-969",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type AgentRole = z.infer<typeof AgentRoleSchema>;"
        }
      ]
    },
    {
      "id": "b-970",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type Message = z.infer<typeof MessageSchema>;"
        }
      ]
    },
    {
      "id": "b-971",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type Channel = z.infer<typeof ChannelSchema>;"
        }
      ]
    },
    {
      "id": "b-972",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export type Thread = z.infer<typeof ThreadSchema>;"
        }
      ]
    },
    {
      "id": "b-973",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "// Agent system interfaces"
        }
      ]
    },
    {
      "id": "b-974",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface AgentContext {"
        }
      ]
    },
    {
      "id": "b-975",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "role: AgentRole;"
        }
      ]
    },
    {
      "id": "b-976",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "tools: Map<string, Tool>;"
        }
      ]
    },
    {
      "id": "b-977",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "memory: Map<string, unknown>;"
        }
      ]
    },
    {
      "id": "b-978",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "channels: Map<string, Channel>;"
        }
      ]
    },
    {
      "id": "b-979",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "threads: Map<string, Thread>;"
        }
      ]
    },
    {
      "id": "b-980",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-981",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export interface AgentMessage extends BaseMessage {"
        }
      ]
    },
    {
      "id": "b-982",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "id: string;"
        }
      ]
    },
    {
      "id": "b-983",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "role: 'user' | 'agent' | 'system';"
        }
      ]
    },
    {
      "id": "b-984",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sender: string;"
        }
      ]
    },
    {
      "id": "b-985",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "timestamp: string;"
        }
      ]
    },
    {
      "id": "b-986",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "channelId?: string;"
        }
      ]
    },
    {
      "id": "b-987",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "threadId?: string;"
        }
      ]
    },
    {
      "id": "b-988",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "metadata?: Record<string, unknown>;"
        }
      ]
    },
    {
      "id": "b-989",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-990",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-991",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Now let's create a memory service to handle agent memory management:"
        }
      ]
    },
    {
      "id": "b-992",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```tsx"
        }
      ]
    },
    {
      "id": "b-993",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { BaseMessage } from '@langchain/core/messages';"
        }
      ]
    },
    {
      "id": "b-994",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { BufferMemory } from '@langchain/community/memory/buffer';"
        }
      ]
    },
    {
      "id": "b-995",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { RedisChatMessageHistory } from '@langchain/community/stores/message/redis';"
        }
      ]
    },
    {
      "id": "b-996",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "import { AgentMessage } from '../types/base';"
        }
      ]
    },
    {
      "id": "b-997",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "export class MemoryService {"
        }
      ]
    },
    {
      "id": "b-998",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "private memories: Map<string, BufferMemory>;"
        }
      ]
    },
    {
      "id": "b-999",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "private readonly redisUrl: string;"
        }
      ]
    },
    {
      "id": "b-1000",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "constructor(redisUrl: string = process.env.REDIS_URL || 'redis://localhost:6379') {"
        }
      ]
    },
    {
      "id": "b-1001",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.memories = new Map();"
        }
      ]
    },
    {
      "id": "b-1002",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.redisUrl = redisUrl;"
        }
      ]
    },
    {
      "id": "b-1003",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-1004",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async initializeMemory(agentId: string): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-1005",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const chatHistory = new RedisChatMessageHistory({"
        }
      ]
    },
    {
      "id": "b-1006",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sessionId: agentId,"
        }
      ]
    },
    {
      "id": "b-1007",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "url: this.redisUrl,"
        }
      ]
    },
    {
      "id": "b-1008",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "sessionTTL: 24 * 60 * 60, // 24 hours"
        }
      ]
    },
    {
      "id": "b-1009",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-1010",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const memory = new BufferMemory({"
        }
      ]
    },
    {
      "id": "b-1011",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "chatHistory,"
        }
      ]
    },
    {
      "id": "b-1012",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "returnMessages: true,"
        }
      ]
    },
    {
      "id": "b-1013",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "memoryKey: 'chat_history',"
        }
      ]
    },
    {
      "id": "b-1014",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "inputKey: 'input',"
        }
      ]
    },
    {
      "id": "b-1015",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "outputKey: 'output',"
        }
      ]
    },
    {
      "id": "b-1016",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "});"
        }
      ]
    },
    {
      "id": "b-1017",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "this.memories.set(agentId, memory);"
        }
      ]
    },
    {
      "id": "b-1018",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-1019",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async addMessage(agentId: string, message: AgentMessage): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-1020",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const memory = this.memories.get(agentId);"
        }
      ]
    },
    {
      "id": "b-1021",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!memory) {"
        }
      ]
    },
    {
      "id": "b-1022",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "throw new Error(`Memory not initialized for agent: ${agentId}`);"
        }
      ]
    },
    {
      "id": "b-1023",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-1024",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "await memory.saveContext("
        }
      ]
    },
    {
      "id": "b-1025",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ input: message.content },"
        }
      ]
    },
    {
      "id": "b-1026",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{ output: '' } // Empty output for user messages"
        }
      ]
    },
    {
      "id": "b-1027",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ");"
        }
      ]
    },
    {
      "id": "b-1028",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-1029",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "public async addResponse("
        }
      ]
    },
    {
      "id": "b-1030",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "agentId: string,"
        }
      ]
    },
    {
      "id": "b-1031",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "message: AgentMessage,"
        }
      ]
    },
    {
      "id": "b-1032",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "response: AgentMessage"
        }
      ]
    },
    {
      "id": "b-1033",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "): Promise<void> {"
        }
      ]
    },
    {
      "id": "b-1034",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "const memory = this.memories.get(agentId);"
        }
      ]
    },
    {
      "id": "b-1035",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "if (!memory) {"
        }
      ]
    },
    {
