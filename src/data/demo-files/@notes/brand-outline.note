    },
    {
      "id": "b-76",
      "type": "bulletList",
      "children": [
        {
          "id": "b-73",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Certified by the Master Cinematographers program, sponsored by Kodak and Panavision."
