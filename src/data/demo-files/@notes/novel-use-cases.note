      "content": [
        {
          "type": "text",
          "text": "Novel use-cases"
        }
      ]
    },
    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "LD-C's unique properties enable some truly novel applications that break from conventional computing paradigms. Here are some unconventional use cases:"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "**Living Academic Papers**"
        }
      ]
    },
    {
      "id": "b-4",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```json"
        }
      ]
    },
    {
      "id": "b-5",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@type\": \"ScientificPaper\","
        }
      ]
    },
    {
      "id": "b-7",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"title\": \"Quantum Gravity Effects in Primordial Black Holes\","
        }
      ]
    },
    {
      "id": "b-8",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"authors\": [\"...\"],"
        }
      ]
    },
    {
      "id": "b-9",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"data\": {"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"cosmicBackground\": {\"@expr\": \"loadDataset('<https://cosmo-data.org/cmb/v2>')\"},"
        }
      ]
    },
    {
      "id": "b-11",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"simulationResults\": {\"@expr\": \"runPBHSimulation(.cosmicBackground, .params)\"}"
        }
      ]
    },
    {
      "id": "b-12",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-13",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@rule\": {"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"confidenceInterval\": {"
        }
      ]
    },
    {
      "id": "b-15",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@expr\": \"computeCI(.simulationResults, 0.95)\","
        }
      ]
    },
    {
      "id": "b-16",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@stable\": \"1 month\"  // Re-run when underlying data updates"
        }
      ]
    },
    {
      "id": "b-17",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@view\": {"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"interactivePlot\": {"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@query\": \"\"\""
        }
      ]
    },
    {
      "id": "b-22",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "SELECT ?epoch ?density ?uncertainty"
        }
      ]
    },
    {
      "id": "b-23",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "WHERE {"
        }
      ]
    },
    {
      "id": "b-24",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "?result :epoch ?epoch ;"
        }
      ]
    },
    {
      "id": "b-25",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ":density ?density ;"
        }
      ]
    },
    {
      "id": "b-26",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": ":uncertainty ?uncertainty ."
        }
      ]
    },
    {
      "id": "b-27",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "} ORDER BY ?epoch"
        }
      ]
    },
    {
      "id": "b-28",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"\"\","
        }
      ]
    },
    {
      "id": "b-29",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@render\": \"<https://viz-standards.org/error-bars>\""
        }
      ]
    },
    {
      "id": "b-30",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-32",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@constraint\": {"
        }
      ]
    },
    {
      "id": "b-33",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"energyConservation\": {"
        }
      ]
    },
    {
      "id": "b-34",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@expr\": \"abs(1 - .simulationResults.energyRatio) < 0.001\","
        }
      ]
    },
    {
      "id": "b-35",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@message\": \"Energy not conserved in simulation\""
        }
      ]
    },
    {
      "id": "b-36",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-37",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-38",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-39",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```"
        }
      ]
    },
    {
      "id": "b-40",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Why novel**: Papers become executable, verifiable artifacts. Readers can:"
        }
      ]
    },
    {
      "id": "b-45",
      "type": "bulletList",
      "children": [
        {
          "id": "b-41",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Re-run analyses with different parameters"
            }
          ]
        },
        {
          "id": "b-42",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "See automatic updates when underlying data changes"
            }
          ]
        },
        {
          "id": "b-43",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Verify constraints weren't violated"
            }
          ]
        },
        {
          "id": "b-44",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Fork the paper with their own modifications"
            }
          ]
        }
      ]
    },
    {
      "id": "b-46",
      "type": "heading",
      "level": 2,
      "content": [
        {
          "type": "text",
          "text": "**Self-Healing Legal Contracts**"
        }
      ]
    },
    {
      "id": "b-47",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "```json"
        }
      ]
    },
    {
      "id": "b-48",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-49",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@type\": \"DerivativesContract\","
        }
      ]
    },
    {
      "id": "b-50",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"parties\": [\"Goldman Sachs\", \"Pension Fund Alpha\"],"
        }
      ]
    },
    {
      "id": "b-51",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"notional\": {\"@value\": \"100000000\", \"@type\": \"USD\"},"
        }
      ]
    },
    {
      "id": "b-52",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@rule\": {"
        }
      ]
    },
    {
      "id": "b-53",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"marketData\": {"
        }
      ]
    },
    {
      "id": "b-54",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@expr\": \"fetchSecuritiesData(.underliers, .asOf)\","
        }
      ]
    },
    {
      "id": "b-55",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@volatile\": true,"
        }
      ]
    },
    {
      "id": "b-56",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@caps\": [\"financial-data\"]"
        }
      ]
    },
    {
      "id": "b-57",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-58",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"marginCall\": {"
        }
      ]
    },
    {
      "id": "b-59",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@expr\": \".markToMarket < .collateral * 0.95\","
        }
      ]
    },
    {
      "id": "b-60",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@message\": \"Margin call triggered\""
        }
      ]
    },
    {
      "id": "b-61",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-62",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"autoCollateralization\": {"
        }
      ]
    },
    {
      "id": "b-63",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@expr\": \"if .marginCall then transferFunds(.counterparty, .shortfall) else null\","
        }
      ]
    },
    {
      "id": "b-64",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@caps\": [\"payment-api\"],"
        }
      ]
    },
    {
      "id": "b-65",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@sig\": {\"required\": [\"CFO\", \"RiskOfficer\"]}"
        }
      ]
    },
    {
      "id": "b-66",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "}"
        }
      ]
    },
    {
      "id": "b-67",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "},"
        }
      ]
    },
    {
      "id": "b-68",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@constraint\": {"
        }
      ]
    },
    {
      "id": "b-69",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"regulatoryLimit\": {"
        }
      ]
    },
    {
      "id": "b-70",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@expr\": \".notional < 200000000 USD\","
        }
      ]
    },
    {
      "id": "b-71",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@message\": \"Exceeds Dodd-Frank limits\""
        }
