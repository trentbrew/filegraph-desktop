    },
    {
      "id": "b-111",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"byCentury\": {"
        }
      ]
    },
    {
      "id": "b-112",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"@query\": \"\"\""
        }
      ]
    },
    {
      "id": "b-113",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "SELECT ?century ?gdp ?uncertainty"
        }
      ]
    },
    {
      "id": "b-114",
      "type": "paragraph",
