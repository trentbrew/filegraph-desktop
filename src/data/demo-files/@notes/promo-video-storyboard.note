    {
      "id": "b-2",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Docket.tv Promo Video Storyboard (90 seconds)**"
        }
      ]
    },
    {
      "id": "b-3",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Scene 1: Introduction (0-10 seconds)"
        }
      ]
    },
    {
      "id": "b-6",
      "type": "bulletList",
      "children": [
        {
          "id": "b-4",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Visual**: Broadcaster at control panel looking stressed, flipping through messy spreadsheets and multiple browser tabs."
            }
          ]
        },
        {
          "id": "b-5",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**On-screen text**: \"Broadcasting doesn't have to be complicated.\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-7",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Scene 2: The Problem (11-20 seconds)"
        }
      ]
    },
    {
      "id": "b-10",
      "type": "bulletList",
      "children": [
        {
          "id": "b-8",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Visual**: Cut to a viewer frustrated, unable to find the show schedule, switching devices in confusion."
            }
          ]
        },
        {
          "id": "b-9",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Text**: \"Traditional guides are outdated.\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-11",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Scene 3: Introducing Docket.tv (11-25 seconds)"
        }
      ]
    },
    {
      "id": "b-14",
      "type": "bulletList",
      "children": [
        {
          "id": "b-12",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Visual**: Transition to clean, modern Docket.tv interface."
            }
          ]
        },
        {
          "id": "b-13",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "**Minimal Text**: \"Meet Docket.tv – Broadcasting Simplified.\""
            }
          ]
        }
      ]
    },
    {
      "id": "b-15",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "Scene 4: Easy Content Management (26-40 seconds)"
