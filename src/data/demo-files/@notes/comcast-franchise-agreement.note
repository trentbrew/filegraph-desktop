          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "[9](https://www.calvertcountymd.gov/2110/Comcast-Franchise-Agreement)"
            }
          ]
        },
        {
          "id": "b-21",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "[10](https://www.nashuanh.gov/1484/Comcast-Franchise-Renewal)"
            }
          ]
        }
      ]
    }
  ]
}