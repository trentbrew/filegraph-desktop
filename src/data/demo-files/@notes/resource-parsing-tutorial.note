      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"url\": \"syllabus.pdf\","
        }
      ]
    },
    {
      "id": "b-129",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"category\": \"General Info\""
        }
      ]
    },
    {
