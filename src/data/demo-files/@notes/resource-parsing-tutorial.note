        }
      ]
    },
    {
      "id": "b-19",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A5[\"Slug Generation Utility"
        }
      ]
    },
    {
      "id": "b-20",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"]"
        }
      ]
    },
    {
      "id": "b-21",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A0 -- \"Provides parsed HTML\" --> A1"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "paragraph",
