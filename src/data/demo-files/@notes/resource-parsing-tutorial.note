    },
    {
      "id": "b-119",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Data to be saved in course-materials.json:"
        }
      ]
    },
    {
      "id": "b-120",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "["
        }
      ]
    },
    {
      "id": "b-121",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "{"
        }
      ]
    },
    {
      "id": "b-122",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "\"title\": \"Chapter 1 Notes\","
        }
      ]
    },
    {
      "id": "b-123",
      "type": "paragraph",
