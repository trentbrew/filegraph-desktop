        {
          "id": "b-158",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "❌ Two-way sync — read-only is fine initially"
            }
          ]
        },
        {
          "id": "b-159",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "❌ Mobile app — desktop only"
            }
          ]
        },
        {
          "id": "b-160",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "❌ Sophisticated agent planning — simple prompts + retrieval"
            }
          ]
        },
        {
          "id": "b-161",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "❌ Team features — single-user first"
            }
          ]
        }
      ]
    },
    {
      "id": "b-163",
      "type": "heading",
      "level": 3,
      "content": [
