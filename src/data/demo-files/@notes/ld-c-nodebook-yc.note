          ]
        },
        {
          "id": "b-166",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Tracking emails about your projects"
            }
          ]
        },
        {
          "id": "b-167",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Calendar for meetings/deadlines"
            }
          ]
        },
        {
          "id": "b-168",
          "type": "paragraph",
          "content": [
            {
