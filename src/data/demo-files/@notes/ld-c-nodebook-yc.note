              "text": "Notes about features/bugs"
            }
          ]
        }
      ]
    },
    {
      "id": "b-170",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "**Track these metrics:**"
        }
      ]
    },
    {
      "id": "b-175",
      "type": "bulletList",
      "children": [
        {
          "id": "b-171",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "How many times/day do you open it?"
            }
          ]
        },
        {
          "id": "b-172",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "What queries do you run most?"
            }
          ]
        },
        {
          "id": "b-173",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Where does it break down?"
            }
          ]
        },
        {
          "id": "b-174",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "What features would make you use it 10x more?"
            }
          ]
        }
      ]
    },
    {
      "id": "b-176",
      "type": "heading",
      "level": 3,
      "content": [
        {
          "type": "text",
          "text": "**Week 4: 10 Alpha Users**"
        }
      ]
    },
    {
      "id": "b-177",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Find 10 people (friends, ex-colleagues, Twitter followers) who:"
        }
      ]
    },
    {
      "id": "b-182",
      "type": "bulletList",
      "children": [
        {
          "id": "b-178",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Are \"power users\" (manage lots of info)"
            }
          ]
        },
        {
          "id": "b-179",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use multiple tools (Gmail + Calendar + Notion/Obsidian)"
            }
          ]
        },
        {
          "id": "b-180",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Will give honest feedback"
            }
          ]
        },
        {
          "id": "b-181",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Don't need polish"
            }
          ]
        }
