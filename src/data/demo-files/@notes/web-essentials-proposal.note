            }
          ]
        },
        {
          "id": "b-66",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Website Maintenance (Performance Monitoring, Content Updates, Minor site updates, Technical troubleshooting)"
            }
          ]
        },
        {
          "id": "b-67",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Graphic Design & Branding (Graphic design & illustration, Marketing collateral, Digital & physical marketing materials, Brand guidelines & documentation)"
            }
          ]
