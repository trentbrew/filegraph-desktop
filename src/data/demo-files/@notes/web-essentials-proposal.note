          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Illustration & Animation (Video editing & animation, 3D animation & motion graphics)"
            }
          ]
        },
        {
          "id": "b-69",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
