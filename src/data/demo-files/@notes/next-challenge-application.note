              "type": "text",
              "text": "Answer"
            }
          ]
        }
      ]
    },
    {
      "id": "b-18",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "***1.2 Is your organization legally incorporated in the United States?****"
        }
      ]
    },
    {
