    },
    {
      "id": "b-28",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "***1.5 When was your company or organization founded? Must be within five years of the application due date to be eligible (no earlier than March 18, 2020).****"
        }
      ]
    },
    {
      "id": "b-30",
      "type": "bulletList",
      "children": [
        {
          "id": "b-29",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Answer"
            }
          ]
        }
      ]
    },
    {
      "id": "b-31",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "***1.6 Have you earned more than $1 million in gross revenue in 12 months ending 12/31/2024? (not including investment dollars) ($USD)****"
        }
      ]
    },
    {
      "id": "b-33",
      "type": "bulletList",
      "children": [
        {
          "id": "b-32",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Answer"
