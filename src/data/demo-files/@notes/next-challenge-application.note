          "type": "text",
          "text": "***1.3 Type of legal entity****"
        }
      ]
    },
    {
      "id": "b-22",
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "***1.3.1 If other, please specify***"
